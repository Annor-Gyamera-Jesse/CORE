@inherits LayoutComponentBase
@inject MenuService menuService
@inject AuthService authService
@inject AuthStateService AuthStateService
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.MainLayout
@using CORE.SERVICE.MainLayout.Module
@using CORE.SERVICE.NOTIFICATION
@using System.Text.Json


<RadzenComponents />
<RadzenDialog />
<LoadingSpinner Visible="isLoading"/>
@if (!isLoading)
{
<RadzenLayout style="grid-template-areas: 'rz-sidebar rz-header' 'rz-sidebar rz-body';">
    <RadzenHeader>
        <RadzenRow JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Gap="0">
            <RadzenColumn Size="5">
                <RadzenSidebarToggle Click="@SidebarToggleClick"></RadzenSidebarToggle>
            </RadzenColumn>
            <RadzenColumn Size="7">
                <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"></RadzenStack>
                <RadzenText Text="Welcome, " TextStyle="Radzen.Blazor.TextStyle.Body1" />

                <RadzenText Text="@userName"
                            TextStyle="Radzen.Blazor.TextStyle.Body2"
                            Style="font-weight: bold; color: #007bff; margin-left: 8px;" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>
    <RadzenBody Expanded="@sidebarExpanded">
        <RadzenRow class="rz-mx-auto rz-px-4 rz-pt-2 rz-pt-md-4 rz-pt-lg-6 rz-pt-xl-12 rz-pb-2 rz-pb-lg-12" Style="max-width: 1440px;">
            <RadzenColumn Size="12">
                @Body
            </RadzenColumn>
        </RadzenRow>
    </RadzenBody>
    <RadzenSidebar Expanded="@sidebarExpanded" style="z-index: 2">
        <RadzenStack AlignItems="Radzen.AlignItems.Center" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding); border-bottom: var(--rz-panel-menu-item-border);">
            @*  <RadzenImage Path="images/logo.png" style="width: 48px; height: 48px;"></RadzenImage> future implementation *@
            <RadzenText Text="LAMIN" TextStyle="Radzen.Blazor.TextStyle.Subtitle1" class="rz-mb-0" style="color: var(--rz-sidebar-color);" />
        </RadzenStack>
        <RadzenPanelMenu>
            @if (mainMenuItems != null)
            {
                @foreach (var menuItem in mainMenuItems)
                {
                    if (subMenuItems.ContainsKey(menuItem.MenuID))
                    {
                        <RadzenPanelMenuItem Text="@menuItem.Text" Icon="@menuItem.Icon">
                            @foreach (var subMenuItem in subMenuItems[menuItem.MenuID])
                            {
                                <RadzenPanelMenuItem Text="@subMenuItem.Text" Path="@subMenuItem.Path" Icon="@subMenuItem.Icon" />
                            }
                        </RadzenPanelMenuItem>
                    }
                    else
                    {
                        <RadzenPanelMenuItem Text="@menuItem.Text" Path="@menuItem.Path" Icon="@menuItem.Icon" />
                    }
                }
            }
            <RadzenPanelMenuItem Text="Logout" Click="@logout" Icon="power_settings_new" />
        </RadzenPanelMenu>
        <RadzenStack AlignItems="Radzen.AlignItems.Center" Gap="0" class="rz-py-4 rz-py-lg-6" Style="padding: var(--rz-panel-menu-item-padding);">
            @*   <RadzenText Text="LAMIN v1.0.0" TextStyle="Radzen.Blazor.TextStyle.Caption" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" /> *@
            <RadzenText Text="@($"INTEL v{SoftwareVersion}, Copyright Ⓒ {CompanyRegisteredYear}")" TextStyle="Radzen.Blazor.TextStyle.Caption" class="rz-mb-0" style="color: var(--rz-text-disabled-color);" TagName="Radzen.Blazor.TagName.P" TextAlign="Radzen.TextAlign.Center" />
        </RadzenStack>
    </RadzenSidebar>
</RadzenLayout>
}
@code {
    string SoftwareVersion;
    int CompanyRegisteredYear;
    private bool _isFirstRender = true;
    private List<MenuItem> mainMenuItems;
    private Dictionary<int, List<SubMenuItem>> subMenuItems = new Dictionary<int, List<SubMenuItem>>();    

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            // Retrieve software version from the AuthService
            SoftwareVersion = await authService.GetSoftwareVersionAsync();

            // Retrieve company registered date from the AuthService
            CompanyRegisteredYear = authService.GetCompanyRegisteredYear();

            // Get user menu items from session storage
            var menuItemsJson = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userMenuItems");
            if (!string.IsNullOrWhiteSpace(menuItemsJson))
            {
                mainMenuItems = JsonSerializer.Deserialize<List<MenuItem>>(menuItemsJson);
            }

            // Fetch sub-menu items for each main menu item
            foreach (var menuItem in mainMenuItems)
            {
                var items = (await menuService.GetSubMenuItemsAsync(menuItem.MenuID)).ToList();
                if (items.Count > 0)
                {
                    subMenuItems[menuItem.MenuID] = items;
                }
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"Failed to load. {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

}
