@using CORE.MODEL
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NotificationMessageService Notify

<RadzenTemplateForm Data="@defaultPassword">
    <RadzenCard>
        <h4>Enter Default Password</h4>
        <RadzenPassword @bind-Value="defaultPassword" Style="width:100%" Placeholder="Default Password" />
        <RadzenButton Text="OK" Click="@SubmitAsync" Style="margin-top:10px" />
    </RadzenCard>
</RadzenTemplateForm>

@code {
    [Parameter] public int UserId { get; set; }
    private string defaultPassword;
    [Inject]
    public Radzen.DialogService DialogService { get; set; }

    async Task SubmitAsync()
    {
        if (!string.IsNullOrWhiteSpace(defaultPassword))
        {
            await authService.ResetPasswordAsync(UserId, defaultPassword);
            Notify.ShowNotification("Success", "Password reset to default successfully.", NotificationSeverity.Success);
            DialogService.Close(true);
        }
        else
        {
            Notify.ShowNotification("Error", "Please enter a default password.", NotificationSeverity.Error);
        }
    }
}
