@page "/core/pages/security/forget-password/forget-password"
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NavigationManager NavManager
@inject NotificationMessageService Notify

<RadzenNotification />
<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="flex items-center justify-center min-h-screen bg-gradient-to-tr from-blue-100 to-indigo-200">
        <div class="bg-white rounded-2xl shadow-xl p-8 w-full max-w-md animate-fade-in-down">
            <h2 class="text-3xl font-bold text-center text-indigo-700 mb-6">🔒 Reset Password</h2>

            @if (model == null)
            {
                <RadzenAlert Text="Unable to load form. Please try again later." Severity="AlertSeverity.Error" />
            }
            else
            {
                <RadzenTemplateForm Data="@model" TItem="ForgetPasswordModel">
                    <div class="mb-4">
                        <RadzenLabel Text="Default Password" Component="DefaultPassword" />
                        <RadzenPassword @bind-Value="model.DefaultPassword"
                                        Name="DefaultPassword"
                                        Style="width:100%"
                                        Placeholder="Enter Default Password"
                                        Required="true"
                                        RequiredValidatorText="Default Password is required." />
                    </div>

                    <div class="mb-4">
                        <RadzenLabel Text="New Password" Component="NewPassword" />
                        <RadzenPassword @bind-Value="model.NewPassword"
                                        Name="NewPassword"
                                        Style="width:100%"
                                        Placeholder="Enter New Password"
                                        Required="true"
                                        RequiredValidatorText="New Password is required." />
                    </div>

                    <div class="mb-4">
                        <RadzenLabel Text="Confirm New Password" Component="ConfirmPassword" />
                        <RadzenPassword @bind-Value="model.ConfirmPassword"
                                        Name="ConfirmPassword"
                                        Style="width:100%"
                                        Placeholder="Confirm New Password"
                                        Required="true"
                                        RequiredValidatorText="Confirm Password is required." />
                    </div>

                    <RadzenButton Text="Update Password"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Icon="lock"
                                  Style="width: 100%; margin-top: 1rem; border-radius: 12px; font-weight: bold;"
                                  Click="@OnSubmit" />
                </RadzenTemplateForm>
            }
        </div>
    </div>
}

@code {
    private ForgetPasswordModel model = new ForgetPasswordModel();
    public bool isLoading = false;

    private async Task OnSubmit()
    {
        try
        {
            isLoading = true;

            if (string.IsNullOrWhiteSpace(model.DefaultPassword) ||
                string.IsNullOrWhiteSpace(model.NewPassword) ||
                string.IsNullOrWhiteSpace(model.ConfirmPassword))
            {
                Notify.ShowNotification("Error", "All fields are required.", NotificationSeverity.Error);
                return;
            }

            if (model.NewPassword != model.ConfirmPassword)
            {
                Notify.ShowNotification("Error", "Passwords do not match.", NotificationSeverity.Error);
                return;
            }

            var success = await authService.ChangePasswordAsync(model.DefaultPassword, model.NewPassword);
            if (success)
            {
                Notify.ShowNotification("Success", "Password changed successfully.", NotificationSeverity.Success);
                NavManager.NavigateTo("/login");
            }
            else
            {
                Notify.ShowNotification("Error", "Invalid default password.", NotificationSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"An error occurred: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ForgetPasswordModel
    {
        public string DefaultPassword { get; set; }
        public string NewPassword { get; set; }
        public string ConfirmPassword { get; set; }
    }
}
