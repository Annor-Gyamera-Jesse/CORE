@page "/login"
@using CORE.SECURITY.LOADER
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using Microsoft.JSInterop;
@using Microsoft.AspNetCore.Components;
@inject AuthService authService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@layout LoginLayout
@inject NotificationMessageService Notify
@attribute [AllowAnonymous]

<div class="container">
    <div class="login-container">
        <RadzenText Text="Login" TextStyle="Radzen.Blazor.TextStyle.H3" class="mb-4" />

        @if (showInvalidLoginMessage)
        {
            <RadzenAlert Text="Invalid credentials. Please try again." Severity="Radzen.AlertSeverity.Error" />
        }

        <div class="form-group">
            <label for="username">Username:</label>
            <input type="text" id="username" @bind="@Username" class="form-control" />
        </div>

        <div class="form-group">
            <label for="password">Password:</label>
            <input type="password" id="password" @bind="@Password" class="form-control" />
        </div>
        <br />
        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" Class="mb-4">
            <RadzenButton Text="Login" ButtonStyle="Radzen.ButtonStyle.Primary" Click="@login" />
        </RadzenText>
    </div>
</div>

@code {
    private string Username { get; set; }
    private string Password { get; set; }
    private bool showInvalidLoginMessage = false;

    private async Task login()
    {
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            showInvalidLoginMessage = true;
            return;
        }

        var user = await authService.GetUserByUsernameAsync(Username);

        if (user != null && user.Password == Password)
        {
            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "userName", user.UserName);
            NavigationManager.NavigateTo("/landingpage");

            Notify.ShowNotification("PERFECT", "Happy Working.", NotificationSeverity.Success);
        }
        else
        {
            Notify.ShowNotification("ALERT", "Invalid credentials. Please try again.", NotificationSeverity.Error);
        }
    }
}
