@page "/landingpage"
@using CORE.MODEL
@using CORE.MODEL.DASHBOARD_AMOUNT_SUM
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject PaymentVerificationService PaymentService
@inject NotificationMessageService Notify
@inject NavigationManager Navigation
@inject AuthStateService authStateService
@inject IJSRuntime jsRuntime
<RadzenNotification />
<LoadingSpinner Visible="isLoading" />

<style>
    .dashboard-container {
        padding: 40px;
        display: flex;
        flex-direction: column;
        gap: 30px;
        align-items: center;
        animation: fadeIn 1.2s ease-in-out;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 25px;
    }

    .dashboard-card {
        width: 280px;
        background: linear-gradient(145deg, #1e1e2f, #23233e);
        color: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        text-align: center;
        transition: 0.3s ease;
    }

        .dashboard-card:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
        }

        .dashboard-card i {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .dashboard-card h1 {
            font-size: 1.4rem;
            margin: 0;
        }

        .dashboard-card h2 {
            font-size: 2.3rem;
            margin: 10px 0 0;
            font-weight: 700;
        }

    .chart-container {
        background: #ffffff;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.1);
        width: 85%;
    }

        .chart-container h2 {
            text-align: center;
            margin-bottom: 15px;
            font-size: 1.6rem;
            color: #333;
        }

    .term-summary-container, .class-summary-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 20px;
        margin-top: 15px;
    }

    .small-card {
        width: 320px;
        min-height: 240px;
    }

    .chart-container h2 {
        margin-top: 0;
        color: #2f3542;
        text-align: center;
        font-size: 1.6rem;
        font-weight: bold;
    }

    .dashboard-card p {
        font-size: 1.1rem;
        margin: 4px 0;
    }

</style>

@if (!isLoading)
{
    <div class="dashboard-container">
        <!-- Summary Cards -->
        <div class="card-container">
            <div class="dashboard-card" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                <i class="fas fa-users"></i>
                <h1>Total Students</h1>
                <h2>@totalStudentsCount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #00c6fb, #005bea);">
                <i class="fas fa-chalkboard-teacher"></i>
                <h1>Total Teachers</h1>
                <h2>@totalTeachersCount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #ff758c, #ff7eb3);">
                <i class="fas fa-user-tie"></i>
                <h1>Total Staff</h1>
                <h2>@totalStaffsCount</h2>
            </div>

          @*   <div class="dashboard-card" style="background: linear-gradient(135deg, #42e695, #3bb2b8);">
                <i class="fas fa-credit-card"></i>
                <h1>Total Online Transactions</h1>
                <h2>GHS @totalTransactionAmount</h2>
            </div> *@

            <div class="dashboard-card" style="background: linear-gradient(135deg, #00b09b, #96c93d);">
                <i class="fas fa-university"></i>
                <h1>Total Bank Transfers</h1>
                <h2>GHS @totalBankTransferAmount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, 	#fbc531, #e84118);">
                <i class="fas fa-money-bill-wave"></i>
                <h1>Students Owing</h1>
                <h2>@totalOwingStudentsCount</h2>
                <p style="margin-top: 10px; font-size: 1.2rem;">GHS @totalOwingAmount.ToString("F2")</p>
            </div>


        </div>

        <!-- Charts Section -->
        <!-- Term Summary Section -->
        <div class="chart-container">
            <h2>Term-Wise Financial Summary</h2>
            <div class="term-summary-container">
                @foreach (var termSummary in termSummaries)
                {
                    <div class="dashboard-card small-card" style="background: linear-gradient(135deg, #1f4037, #99f2c8);">
                        <i class="fas fa-coins"></i>
                        <h1>@terms.FirstOrDefault(t => t.TermID == termSummary.TermID)?.Term</h1>
                        <h2>Expected: GH¢ @termSummary.ExpectedTotal.ToString("F2")</h2>
                        <p>Received: GH¢ @termSummary.ActualTotal.ToString("F2")</p>
                        <p>Outstanding: GH¢ @termSummary.Outstanding.ToString("F2")</p>
                    </div>
                }
            </div>

            <RadzenChart Style="height: 300px;" Class="mt-4">
                <RadzenColumnSeries Data="@termSummaries" CategoryProperty="TermID" ValueProperty="ExpectedTotal" Title="Expected" />
                <RadzenColumnSeries Data="@termSummaries" CategoryProperty="TermID" ValueProperty="ActualTotal" Title="Received" />
            </RadzenChart>
        </div>

        <!-- Term Selector -->
        <div class="chart-container">
            <h2>Select Term to View Class Financials</h2>
            <RadzenDropDown Data="@terms"
                            TextProperty="Term"
                            ValueProperty="TermID"
                            @bind-Value="selectedTermId"
                            Placeholder="Select Term"
                            Change="@(async args => await LoadClassTermSummariesAsync())"
                            Style="width: 300px; margin: 0 auto 30px auto;" />
        </div>

        <!-- Class Summary Section -->
        @if (classTermSummaries.Any())
        {
            <div class="chart-container">
                <h2>Class-Wise Breakdown For Term @terms.FirstOrDefault(t => t.TermID == selectedTermId)?.Term</h2>
                <div class="class-summary-container">
                    @foreach (var item in classTermSummaries)
                    {
                        <div class="dashboard-card small-card" style="background: linear-gradient(135deg, #1e3c72, #2a5298);">
                            <i class="fas fa-school"></i>
                            <h1>Class @item.ClassID</h1>
                            <p>Students: @item.TotalStudents | Fee Types: @item.FeeTypesCount</p>
                            <p>Expected: GH¢ @item.ExpectedTotal.ToString("F2")</p>
                            <p>Received: GH¢ @item.ActualTotal.ToString("F2")</p>
                            <p>Outstanding: GH¢ @item.Outstanding.ToString("F2")</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <LoadingSpinner Visible="true" />
}


@code {
    private int totalStudentsCount;
    private int totalTeachersCount;
    private int totalStaffsCount;
    private decimal totalTransactionAmount;
    private bool isLoading = true;  
    private decimal totalBankTransferAmount;
    private int userId;
    private List<ChartData> chartData = new();
    private List<ChartData> lineChartData = new();
    private List<TermFeeSummary> termSummaries = new();
    private int totalOwingStudentsCount;
    private decimal totalOwingAmount;
    private List<ClassTermFeeSummary> classTermSummaries = new();
    private List<SchoolTerm> terms = new();
    private int selectedTermId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");

            if (string.IsNullOrWhiteSpace(username))
            {
                Notify.ShowNotification("User Error", "User not logged in or session expired.",NotificationSeverity.Error);
                return;
            }

            var user = await authService.GetUserByUsernameAsync(username);
            if (user == null)
            {
                Notify.ShowNotification("User Error", "User not found.",NotificationSeverity.Error);
                return;
            }

            userId = user.UserID;

            await authStateService.EnsureAuthenticated();
            totalStudentsCount = await authService.GetTotalStudentsCount();
            totalTeachersCount = await authService.GetTotalTeachersCount();
            totalStaffsCount = await authService.GetStaffsCount();            
            totalBankTransferAmount = await authService.GetTotalBankTransferredAsync();
            (var studentsOwingCount, var amountOwing) = await authService.GetStudentsOwingSummaryAsync();
            totalOwingStudentsCount = studentsOwingCount;
            totalOwingAmount = amountOwing;
            termSummaries = await authService.GetTermFeeSummariesAsync();
            terms = await authService.GetAllSchoolTermsAsync();

            if (terms.Any())
            {
                selectedTermId = terms.First().TermID; // auto-select first term
                await LoadClassTermSummariesAsync();   // load summary for first term
            }
            var transactions = await PaymentService.GetAllSuccessfulPaymentsAsync();
            totalTransactionAmount = transactions.Sum(x => x.Amount) / 100.0m;

            chartData = new()
            {
                new ChartData { Category = "Students", Value = totalStudentsCount },
                new ChartData { Category = "Teachers", Value = totalTeachersCount },
                new ChartData { Category = "Staff", Value = totalStaffsCount },
               // new ChartData { Category = "Transactions", Value = (int)totalTransactionAmount }
            };

            // Simulate monthly trend (example)
            lineChartData = transactions
              .GroupBy(tx => DateTime.Parse(tx.PaidAt).ToString("MMM")) // e.g., "Jan", "Feb"
             .Select(g => new ChartData
            {
             Category = g.Key,
             Value = g.Sum(x => x.Amount) / 100 // converting from pesewas to GHS
            })
           .OrderBy(data => DateTime.ParseExact(data.Category, "MMM", null).Month) // Optional: order by month
            .ToList();

        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Dashboard Error", $"Error loading dashboard: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadClassTermSummariesAsync()
    {
        if (selectedTermId > 0)
        {
            classTermSummaries = await authService.GetClassTermFeeSummariesAsync(selectedTermId);
        }
    }

    public class ChartData
    {
        public string Category { get; set; }
        public int Value { get; set; }
    }
}
