@page "/landingpage"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject PaymentVerificationService PaymentService
@inject NotificationMessageService Notify
@inject NavigationManager Navigation
@inject AuthStateService authStateService
@inject IJSRuntime jsRuntime
<RadzenNotification />
<LoadingSpinner Visible="isLoading" />

<style>
    .dashboard-container {
        padding: 40px;
        display: flex;
        flex-direction: column;
        gap: 30px;
        align-items: center;
        animation: fadeIn 1.2s ease-in-out;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 25px;
    }

    .dashboard-card {
        width: 280px;
        background: linear-gradient(145deg, #1e1e2f, #23233e);
        color: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        text-align: center;
        transition: 0.3s ease;
    }

        .dashboard-card:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
        }

        .dashboard-card i {
            font-size: 2.5rem;
            margin-bottom: 15px;
        }

        .dashboard-card h1 {
            font-size: 1.4rem;
            margin: 0;
        }

        .dashboard-card h2 {
            font-size: 2.3rem;
            margin: 10px 0 0;
            font-weight: 700;
        }

    .chart-container {
        background: #ffffff;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.1);
        width: 85%;
    }

        .chart-container h2 {
            text-align: center;
            margin-bottom: 15px;
            font-size: 1.6rem;
            color: #333;
        }

</style>

@if (!isLoading)
{
    <div class="dashboard-container">
        <!-- Summary Cards -->
        <div class="card-container">
            <div class="dashboard-card" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                <i class="fas fa-users"></i>
                <h1>Total Students</h1>
                <h2>@totalStudentsCount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #00c6fb, #005bea);">
                <i class="fas fa-chalkboard-teacher"></i>
                <h1>Total Teachers</h1>
                <h2>@totalTeachersCount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #ff758c, #ff7eb3);">
                <i class="fas fa-user-tie"></i>
                <h1>Total Staff</h1>
                <h2>@totalStaffsCount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #42e695, #3bb2b8);">
                <i class="fas fa-credit-card"></i>
                <h1>Total Online Transactions</h1>
                <h2>GHS @totalTransactionAmount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #00b09b, #96c93d);">
                <i class="fas fa-university"></i>
                <h1>Total Bank Transfers</h1>
                <h2>GHS @totalBankTransferAmount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, 	#fbc531, #e84118);">
                <i class="fas fa-money-bill-wave"></i>
                <h1>Students Owing</h1>
                <h2>@totalOwingStudentsCount</h2>
                <p style="margin-top: 10px; font-size: 1.2rem;">GHS @totalOwingAmount.ToString("F2")</p>
            </div>


        </div>

        <!-- Charts Section -->
        <div class="chart-container">
            <h2>Financial & Academic Summary</h2>

            <RadzenChart Style="height: 350px;">
                <RadzenPieSeries Data="@chartData" CategoryProperty="Category" ValueProperty="Value" />
            </RadzenChart>

            <RadzenChart Style="height: 300px;" Class="mt-4">
                <RadzenLineSeries Data="@lineChartData" CategoryProperty="Category" ValueProperty="Value" />
                <RadzenCategoryAxis />
                <RadzenValueAxis />
            </RadzenChart>
        </div>
    </div>
}
else
{
    <LoadingSpinner Visible="true" />
}


@code {
    private int totalStudentsCount;
    private int totalTeachersCount;
    private int totalStaffsCount;
    private decimal totalTransactionAmount;
    private bool isLoading = true;  
    private decimal totalBankTransferAmount;
    private int userId;
    private List<ChartData> chartData = new();
    private List<ChartData> lineChartData = new();

    private int totalOwingStudentsCount;
    private decimal totalOwingAmount;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");

            if (string.IsNullOrWhiteSpace(username))
            {
                Notify.ShowNotification("User Error", "User not logged in or session expired.",NotificationSeverity.Error);
                return;
            }

            var user = await authService.GetUserByUsernameAsync(username);
            if (user == null)
            {
                Notify.ShowNotification("User Error", "User not found.",NotificationSeverity.Error);
                return;
            }

            userId = user.UserID;

            await authStateService.EnsureAuthenticated();
            totalStudentsCount = await authService.GetTotalStudentsCount();
            totalTeachersCount = await authService.GetTotalTeachersCount();
            totalStaffsCount = await authService.GetStaffsCount();            
            totalBankTransferAmount = await authService.GetTotalBankTransferredAsync();
            (var studentsOwingCount, var amountOwing) = await authService.GetStudentsOwingSummaryAsync();
            totalOwingStudentsCount = studentsOwingCount;
            totalOwingAmount = amountOwing;


            var transactions = await PaymentService.GetAllSuccessfulPaymentsAsync();
            totalTransactionAmount = transactions.Sum(x => x.Amount) / 100.0m;

            chartData = new()
            {
                new ChartData { Category = "Students", Value = totalStudentsCount },
                new ChartData { Category = "Teachers", Value = totalTeachersCount },
                new ChartData { Category = "Staff", Value = totalStaffsCount },
                new ChartData { Category = "Transactions", Value = (int)totalTransactionAmount }
            };

            // Simulate monthly trend (example)
            lineChartData = transactions
              .GroupBy(tx => DateTime.Parse(tx.PaidAt).ToString("MMM")) // e.g., "Jan", "Feb"
             .Select(g => new ChartData
            {
             Category = g.Key,
             Value = g.Sum(x => x.Amount) / 100 // converting from pesewas to GHS
            })
           .OrderBy(data => DateTime.ParseExact(data.Category, "MMM", null).Month) // Optional: order by month
            .ToList();

        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Dashboard Error", $"Error loading dashboard: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    public class ChartData
    {
        public string Category { get; set; }
        public int Value { get; set; }
    }
}
