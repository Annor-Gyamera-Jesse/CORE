@page "/landingpage"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NotificationMessageService Notify

<RadzenNotification />
<LoadingSpinner Visible="isLoading" />

<style>
    .dashboard-container {
        padding: 20px;
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: flex-start; /* Aligns items from top-left */
        width: 100%;
    }

    .dashboard-card {
        text-align: center;
        padding: 30px;
        border-radius: 12px;
        background: linear-gradient(135deg, #2c3e50, #34495e);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s, box-shadow 0.3s;
        color: white;
        margin: 10px; /* Ensures consistent spacing */
        width: 250px; /* Fixed width */
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
        }

        .dashboard-card h3 {
            margin: 10px 0;
            font-size: 1.4rem;
        }

        .dashboard-card h2 {
            margin: 0;
            font-size: 2.5rem;
            font-weight: bold;
        }
</style>

@if (!isLoading)
{
    <div class="dashboard-container">
        <RadzenCard Class="dashboard-card">
            <RadzenIcon Icon="groups" Style="font-size: 3rem; color: #ff7675;" />
            <h3>Total Students</h3>
            <h2>@totalStudentsCount</h2>
            <RadzenProgressBar Value="@studentsProgress" ShowValue="true" />
        </RadzenCard>

        <RadzenCard Class="dashboard-card">
            <RadzenIcon Icon="school" Style="font-size: 3rem; color: #1abc9c;" />
            <h3>Total Teachers</h3>
            <h2>@totalTeachersCount</h2>
            <RadzenProgressBar Value="@teachersProgress" ShowValue="true" />
        </RadzenCard>

      @*   <RadzenCard Class="dashboard-card">
            <RadzenIcon Icon="emoji_events" Style="font-size: 3rem; color: #f39c12;" />
            <h3>Total Graduates</h3>
            <h2>@totalGraduatesCount</h2>
            <RadzenProgressBar Value="@graduatesProgress" ShowValue="true" />
        </RadzenCard> *@

        <RadzenCard Class="dashboard-card">
            <RadzenIcon Icon="people" Style="font-size: 3rem; color: coral;" />
            <h3>Total Staffs</h3>
            <h2>@totalStaffsCount</h2>
            <RadzenProgressBar Value="@StaffProgress" ShowValue="true" />
        </RadzenCard>
    </div>
}

@code {
    private int totalStudentsCount;
    private int totalTeachersCount;
    private int totalGraduatesCount;
    private int totalStaffsCount;
    private bool isLoading = true;

    private int studentsProgress = 75;
    private int teachersProgress = 60;
    private int graduatesProgress = 90;
    private int StaffProgress = 90;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            totalStudentsCount = await authService.GetTotalStudentsCount();
            totalTeachersCount = await authService.GetTotalTeachersCount();
            // totalGraduatesCount = await authService.GetTotalGraduatesCount();
            totalStaffsCount = await authService.GetStaffsCount();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
