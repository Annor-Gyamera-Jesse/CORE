@page "/landingpage"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NotificationMessageService Notify

<RadzenNotification />
<LoadingSpinner Visible="isLoading" />

<style>
    .dashboard-container {
        padding: 40px;
        display: flex;
        flex-direction: column;
        gap: 30px;
        align-items: center;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 25px;
    }

    .dashboard-card {
        width: 300px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(15px);
        border-radius: 20px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

        .dashboard-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
        }

        .dashboard-card i {
            font-size: 3rem;
            margin-bottom: 12px;
        }

        .dashboard-card h1 {
            font-size: 1.6rem;
            margin: 0;
        }

        .dashboard-card h2 {
            font-size: 2.2rem;
            margin: 10px 0 0;
            font-weight: bold;
        }

    .chart-container {
        background: #ffffff;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.1);
        width: 80%;
    }

        .chart-container h2 {
            text-align: center;
            margin-bottom: 15px;
            font-size: 1.5rem;
            color: #333;
        }
</style>

@if (!isLoading)
{
    <div class="dashboard-container">
        <div class="card-container">
            <div class="dashboard-card" style="background: linear-gradient(135deg, #667eea, #764ba2);">
                <i class="fas fa-users"></i>
                <h1>Total Students</h1>
                <h2>@totalStudentsCount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #ff758c, #ff7eb3);">
                <i class="fas fa-chalkboard-teacher"></i>
                <h1>Total Teachers</h1>
                <h2>@totalTeachersCount</h2>
            </div>

            <div class="dashboard-card" style="background: linear-gradient(135deg, #00c6fb, #005bea);">
                <i class="fas fa-user-graduate"></i>
                <h1>Total Staff</h1>
                <h2>@totalStaffsCount</h2>
            </div>
        </div>

        <div class="chart-container">
            <h2>Data Overview</h2>
            <RadzenChart Style="height: 400px;">
                <RadzenColumnSeries Data="@chartData" CategoryProperty="Category" ValueProperty="Value" />
                <RadzenCategoryAxis />
                <RadzenValueAxis />
            </RadzenChart>
        </div>
    </div>
}

@code {
    private int totalStudentsCount;
    private int totalTeachersCount;
    private int totalStaffsCount;
    private bool isLoading = true;
    private List<ChartData> chartData = new List<ChartData>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            totalStudentsCount = await authService.GetTotalStudentsCount();
            totalTeachersCount = await authService.GetTotalTeachersCount();
            totalStaffsCount = await authService.GetStaffsCount();

            chartData = new List<ChartData>
            {
                new ChartData { Category = "Students", Value = totalStudentsCount },
                new ChartData { Category = "Teachers", Value = totalTeachersCount },
                new ChartData { Category = "Staff", Value = totalStaffsCount }
            };
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public class ChartData
    {
        public string Category { get; set; }
        public int Value { get; set; }
    }
}
