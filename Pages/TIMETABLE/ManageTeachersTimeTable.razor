@page "/manage-teachers-time-table"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService AssignmentService
@inject DialogService DialogService
@inject NavigationManager NavigationManager

<h3>Manage Teacher Assignments</h3>

<RadzenGrid Data="@assignments" TItem="TeacherAssignment" RowSelect="EditAssignment">
    <Columns>
        <RadzenGridColumn TItem="TeacherAssignment" Property="ClassSchedulingID" Title="ID" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="ClassID" Title="Class ID" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="CourseName" Title="Course Name" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="TeacherName" Title="Teacher Name" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="Day" Title="Day" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="Period" Title="Period" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="StartTime" Title="Start Time" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="EndTime" Title="End Time" />
        <RadzenGridColumn TItem="TeacherAssignment" Property="Note" Title="Note" />
        <RadzenGridColumn TItem="TeacherAssignment" Context="assignment">
            <Template>
                <RadzenButton Text="Edit" Click="@(args => EditAssignment(assignment))" />
                <RadzenButton Text="Delete" Click="@(args => DeleteAssignment(assignment.ClassSchedulingID))" Style="margin-left: 10px;" />
            </Template>
        </RadzenGridColumn>
    </Columns>
</RadzenGrid>

@code {
    private IEnumerable<TeacherAssignment> assignments;
    private IEnumerable<Class> classes;
    private IEnumerable<Course> courses;
    private IEnumerable<TeachersRegistration> teachers;
    private IEnumerable<string> periods = new List<string> { "First Period", "Second Period" };
    private TeacherAssignment selectedAssignment;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        assignments = await AssignmentService.GetAllAssignmentsAsync();
        classes = await AssignmentService.GetsAllClassesAsync();
        courses = await AssignmentService.GetAllCoursesAsync();
        teachers = await AssignmentService.GetAllTeachersAsync();
    }

    private async Task EditAssignment(TeacherAssignment assignment)
    {
        selectedAssignment = new TeacherAssignment
        {
            ClassSchedulingID = assignment.ClassSchedulingID,
            ClassID = assignment.ClassID,
            CourseID = assignment.CourseID,
            CourseName = assignment.CourseName,
            TeacherID = assignment.TeacherID,
            TeacherName = assignment.TeacherName,
            Day = assignment.Day,
            Period = assignment.Period,
            StartTime = assignment.StartTime,
            EndTime = assignment.EndTime,
            Note = assignment.Note
        };
        
        var dialogOptions = new DialogOptions() { Draggable = true, ShowClose = true, Width = "700px", Height = "auto" };
        await DialogService.OpenAsync<EditTeachersTimeTableDialog>("Edit Assignment", new Dictionary<string, object>() { { "Assignment", selectedAssignment }, { "Classes", classes }, { "Courses", courses }, { "Teachers", teachers }, { "Periods", periods } }, dialogOptions);
    }

    private async Task DeleteAssignment(int id)
    {
        await AssignmentService.DeleteAssignmentAsync(id);
        await LoadDataAsync();
    }
}
