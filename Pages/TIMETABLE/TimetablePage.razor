@page "/timetable"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService TimetableService

<h3>School Timetable</h3>

<RadzenGrid Data="@timetables" TItem="AssignTeachersSchoolTimetable">
    <Columns>
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="ClassSchedulingID" Title="ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="ClassID" Title="Class ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="CourseID" Title="Course ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="PeriodID" Title="Period ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="Subjects" Title="Subjects" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="Day" Title="Day" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="TeacherID" Title="Teacher ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="StartTime" Title="Start Time" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="EndTime" Title="End Time" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="UserID" Title="User ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="Note" Title="Note" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="RecDateCreated" Title="Date Created" />
    </Columns>
</RadzenGrid>

@code {
    private IEnumerable<AssignTeachersSchoolTimetable> timetables;

    protected override async Task OnInitializedAsync()
    {
        timetables = await TimetableService.GetAllTimetablesAsync();
    }
}
