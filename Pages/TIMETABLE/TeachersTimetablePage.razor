@page "/teacherstimetable"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService TimetableService
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService

<RadzenGrid @ref="grid" Data="@timetables" TItem="AssignTeachersSchoolTimetable" AllowPaging="true" AllowSorting="true" PageSize="10">
    <Columns>
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="ClassID" Title="Class ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="SchoolCourseName" Title="Subject" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="Period" Title="Period" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="Day" Title="Day" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="TeacherID" Title="Teacher ID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="StartTime" Title="Start Time" FormatString="{0:MM/dd/yyyy HH:mm:ss}" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="EndTime" Title="End Time" FormatString="{0:MM/dd/yyyy HH:mm:ss}" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="UserID" Title="Submitted By UserID" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="UpdatedBy" Title="Updated By" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="Note" Title="Note" />
        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Property="RecDateCreated" Title="Date Created" FormatString="{0:MM/dd/yyyy HH:mm:ss}" />

        <RadzenGridColumn TItem="AssignTeachersSchoolTimetable" Width="100px">
            <Template Context="data">
                <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@((args) => OnDeleteRow(data))" />
            </Template>
        </RadzenGridColumn>
    </Columns>
</RadzenGrid>

@code {
    private RadzenGrid<AssignTeachersSchoolTimetable> grid;
    private IEnumerable<AssignTeachersSchoolTimetable> timetables;

    protected override async Task OnInitializedAsync()
    {
        timetables = await TimetableService.GetAllTimetablesAsync();
    }

    async Task OnDeleteRow(AssignTeachersSchoolTimetable timetable)
    {
        if (timetable == null)
            return;

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this record?");
        if (confirm)
        {
            await TimetableService.DeleteTimetableAsync(timetable.ClassSchedulingID);
            timetables = await TimetableService.GetAllTimetablesAsync();
            await grid.Reload();
        }
    }
}
