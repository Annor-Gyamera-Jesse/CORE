@page "/core/pages/fees/student-fees-viewing/student-fee-history"
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@inject AuthService authService

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <h3 class="text-xl font-bold mb-4">Student Fee Payment History</h3>

    <RadzenRow>
        <!-- Student List -->
        <RadzenFieldset Text="SELECT STUDENT" Style="width: 100%;">
            <RadzenColumn Width="25%">
                <RadzenListBox Data="@students"
                               @bind-Value="@selectedStudentId"
                               TextProperty="DisplayInfo"
                               ValueProperty="StudentID"
                               Change="OnStudentSelected"
                               Style="height: 400px;" />
                <div class="mt-2 font-bold text-sm">Class: @selectedStudentClass</div>

                @if (!string.IsNullOrEmpty(feeTypeName))
                {
                    <RadzenCard Style="background-color: #e5f4ff; padding: 10px; margin-top: 10px;">
                        <div class="text-md font-bold">Fee Type: @feeTypeName</div>
                        <div class="text-md">Amount Due: <b>@expectedFeeAmount.ToString("C")</b></div>
                    </RadzenCard>
                }
            </RadzenColumn>
        </RadzenFieldset>

        <!-- Term Selection -->
        <RadzenFieldset Text="SELECT TERM">
            <RadzenColumn Width="25%">
                @foreach (var term in terms)
                {
                    <RadzenButton Text="@term.Term"
                                  Click="() => LoadHistory(term.TermID)"
                                  Style="margin: 5px;"
                                  ButtonStyle="ButtonStyle.Info" />
                }
            </RadzenColumn>
        </RadzenFieldset>

        <!-- Fee History Table -->
        <RadzenColumn Width="50%">
            <RadzenDataGrid Data="@feeHistory" TItem="StudentFeeHistory" ColumnWidth="200px">
                <Columns>
                    <RadzenDataGridColumn TItem="StudentFeeHistory" Property="FeeTypeName" Title="Fee Type" />
                    <RadzenDataGridColumn TItem="StudentFeeHistory" Property="Amount" Title="Total Amount" />
                    <RadzenDataGridColumn TItem="StudentFeeHistory" Property="AmountPaid" Title="Amount Paid" />
                    <RadzenDataGridColumn TItem="StudentFeeHistory" Property="AmountLeft" Title="Amount Left" />
                </Columns>
            </RadzenDataGrid>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    private List<Student> students = new();
    private List<SchoolTerm> terms = new();
    private List<StudentFeeHistory> feeHistory = new();
    private int selectedStudentId;
    private string selectedStudentClass = string.Empty;

    private decimal expectedFeeAmount = 0;
    private string feeTypeName = string.Empty;

    public bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            students = (await authService.GetStudentsWithClassAsync()).ToList();
            terms = (await authService.GetAllSchoolTermsAsync()).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnStudentSelected(object value)
    {
        selectedStudentId = Convert.ToInt32(value);
        var student = students.FirstOrDefault(s => s.StudentID == selectedStudentId);

        if (student is not null)
        {
            selectedStudentClass = student.ClassID;

            // Fetch class fee info dynamically
            var feeInfo = await authService.GetClassFeeInfoAsync(student.ClassID);
            if (feeInfo != null)
            {
                expectedFeeAmount = feeInfo.Amount;
                feeTypeName = feeInfo.FeeTypeName;
            }
            else
            {
                expectedFeeAmount = 0;
                feeTypeName = "Not Found";
            }

            feeHistory.Clear(); // Clear previous data until term is selected
        }
    }

    private async Task LoadHistory(int termId)
    {
        var student = students.FirstOrDefault(s => s.StudentID == selectedStudentId);
        if (student is not null)
        {
            feeHistory = (await authService.GetStudentFeeHistoryAsync(student.StudentID, termId)).ToList();
        }
    }
}

