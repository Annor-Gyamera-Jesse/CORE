@inject AuthService authService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using System.Text
<RadzenNotification />

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="card" style="padding: 20px; max-width: 600px; margin: auto;">
        <RadzenTextBox Placeholder="🔍 Search student by name..." Value="@searchText"
        Style="width: 100%; margin-bottom: 20px;"
        Change="@(args => SearchStudents(args))" />

        <RadzenDropDown Data="@students" TextProperty="FullName" ValueProperty="StudentID"
        @bind-Value="selectedStudentId" Placeholder="Select a student"
        Style="width: 100%; margin-bottom: 20px;" />

        <RadzenButton Text="Generate Report" Icon="save_alt" Click="@GenerateStudentReport"
        Disabled="@isLoading" Style="width: 100%; margin-bottom: 10px;" />
    </div>
}
@code {
    private string searchText;
    private int selectedStudentId;
    private List<Student> students = new();
    private bool isLoading;

    private async Task SearchStudents(object args)
    {
        if (args is string searchText && !string.IsNullOrWhiteSpace(searchText))
        {
            this.searchText = searchText;
            try
            {
                isLoading = true;
                students = (await authService.SearchStudentsAsync(searchText)).ToList();
                Notify.ShowNotification("Search completed.", "", NotificationSeverity.Success);
            }
            catch (Exception ex)
            {
                Notify.ShowNotification($"Error searching students: {ex.Message}", "", NotificationSeverity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
    }

    private async Task GenerateStudentReport()
    {
        if (selectedStudentId == 0)
        {
            Notify.ShowNotification("Please select a student.", "", NotificationSeverity.Warning);
            return;
        }

        isLoading = true;
        try
        {
            var studentFeeData = await authService.GetStudentFeesByStudentIdAsync(selectedStudentId);
            if (studentFeeData == null || !studentFeeData.Any())
            {
                Notify.ShowNotification("No data found for the selected student.", "", NotificationSeverity.Warning);
                return;
            }

            var csvBuilder = new StringBuilder();
            csvBuilder.AppendLine("Student Fee Report");
            csvBuilder.AppendLine(""); // Blank line for separation
            csvBuilder.AppendLine("StudentName, FeeTypeName, ClassID, AmountPaid, AmountLeft");

            foreach (var fee in studentFeeData)
            {
                csvBuilder.AppendLine(
                    $"{fee.StudentName}, {fee.FeeTypeName}, {fee.ClassID}, {fee.AmountPaid}, {fee.AmountLeft}"
                );
            }

            var csvData = Encoding.UTF8.GetBytes(csvBuilder.ToString());
            var base64Csv = Convert.ToBase64String(csvData);

            var fileName = $"Student_Fees_{selectedStudentId}.pdf";
            await JSRuntime.InvokeVoidAsync("downloadPdf", fileName, base64Csv);

            Notify.ShowNotification("Report generated successfully.", "", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error generating report: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
