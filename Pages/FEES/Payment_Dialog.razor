@inject AuthService authService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using System.Text
<RadzenNotification />

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="card" style="padding: 20px; max-width: 600px; margin: auto;">
        <RadzenTextBox Placeholder="🔍 Search student by name..." Value="@searchText"
        Style="width: 100%; margin-bottom: 20px;"
        Change="@(args => SearchStudents(args))" />

        <RadzenDropDown Data="@students" TextProperty="FullName" ValueProperty="StudentID"
        @bind-Value="selectedStudentId" Placeholder="Select a student"
        Style="width: 100%; margin-bottom: 20px;" />

        <RadzenDropDown Data="@terms" TextProperty="Term" ValueProperty="TermID"
        @bind-Value="selectedTermId" Placeholder="Select term"
        Style="width: 100%; margin-bottom: 20px;" />

        <RadzenButton Text="Generate Report" Icon="save_alt" Click="@GenerateStudentReport"
        Disabled="@isLoading" Style="width: 100%; margin-bottom: 10px;" />
    </div>
}
@code {
    private string searchText;
    private int selectedStudentId;
    private List<Student> students = new();
    private bool isLoading;
    private List<SchoolTerm> terms = new();
    private int selectedTermId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            terms = await authService.GetAllSchoolTermsAsync();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error loading terms: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SearchStudents(object args)
    {
        try
        {
            isLoading = true;
            if (args is null || args is not string)
            {
                return;
            }
            if (args is string searchText && !string.IsNullOrWhiteSpace(searchText))
            {
                this.searchText = searchText;
                try
                {
                    isLoading = true;
                    students = (await authService.SearchStudentsAsync(searchText)).ToList();
                }
                catch (Exception ex)
                {
                    Notify.ShowNotification($"Error searching students: {ex.Message}", "", NotificationSeverity.Error);
                }
                finally
                {
                    isLoading = false;
                }
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error searching students: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateStudentReport()
    {
        if (string.IsNullOrWhiteSpace(searchText) && selectedStudentId == 0 && selectedTermId == 0)
        {
            Notify.ShowNotification("Please enter a student name to search or select a student and term.", "", NotificationSeverity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(searchText) && selectedStudentId == 0)
        {
            Notify.ShowNotification("Please enter a student name to search or select a student.", "", NotificationSeverity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(searchText))
        {
            Notify.ShowNotification("Please enter a student name to search.", "", NotificationSeverity.Warning);
            return;
        }
        if (selectedStudentId == 0)
        {
            Notify.ShowNotification("Please select a student.", "", NotificationSeverity.Warning);
            return;
        }
        if (selectedTermId == 0)
        {
            Notify.ShowNotification("Please select a term.", "", NotificationSeverity.Warning);
            return;
        }

        try
        {
            isLoading = true;

            var studentFeeData = await authService.GetStudentFeesByStudentIdandTermAsync(selectedStudentId, selectedTermId);
            if (studentFeeData == null || !studentFeeData.Any())
            {
                Notify.ShowNotification("No data found for the selected student.", "", NotificationSeverity.Warning);
                return;
            }

            var studentClassId = studentFeeData.First().ClassID;
            var feeAmounts = await authService.GetFeeAmountsByClassIDAsync(studentClassId);
            var expectedTotal = feeAmounts.Sum(x => x.Amount);

            var csvBuilder = new StringBuilder();

            // === CSV Header ===
            csvBuilder.AppendLine("Student Fee Report");
            csvBuilder.AppendLine(); // blank line

            // === Actual Fee Data ===
            foreach (var fee in studentFeeData)
            {
                csvBuilder.AppendLine($"{fee.StudentName}, {fee.FeeTypeName}, {fee.ClassID}, {fee.AmountPaid}, {fee.AmountLeft}, {fee.TermID}");
            }

            // === Special marker so JS knows to add this AFTER totals ===
            csvBuilder.AppendLine("Expected Fee Amounts:");
            foreach (var item in feeAmounts)
            {
                csvBuilder.AppendLine($"{item.FeeTypeName.ToUpper()}: GH {item.Amount:F2}");
            }
            csvBuilder.AppendLine($"TOTAL EXPECTED FEES: GH {expectedTotal:F2}");

            var csvData = Encoding.UTF8.GetBytes(csvBuilder.ToString());
            var base64Csv = Convert.ToBase64String(csvData);

            var (companyName, schoolName, logoBase64) = await authService.GetPdfLoginScreenDetailsAsync();
            var fileName = $"Student_Fees_{selectedStudentId}.pdf";

            await JSRuntime.InvokeVoidAsync("downloadPdf", fileName, base64Csv, companyName, schoolName, logoBase64);

            Notify.ShowNotification("Report generated successfully.", "", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error generating report: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

}
