@inject AuthService authService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using System.Text
<RadzenNotification />

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="card" style="padding: 20px; max-width: 600px; margin: auto;">
        <RadzenTextBox Placeholder="&#x1F50D; Search student by name..."
                       Value="@studentSearch"
                       Style="width: 100%; margin-bottom: 20px;"
                       Change="@(args => SearchStudents(args))" />

        <RadzenDropDown Data="@students"
                        TextProperty="FullName"
                        ValueProperty="StudentID"
                        @bind-Value="selectedStudentId"
                        Placeholder="Select a student"
                        Style="width: 100%; margin-bottom: 20px;" />

        <RadzenDropDown Data="@terms"
                        TextProperty="Term"
                        ValueProperty="TermID"
                        @bind-Value="selectedTermId"
                        Placeholder="Select term"
                        Style="width: 100%; margin-bottom: 20px;" />

        <RadzenButton Text="Generate Report"
                      Icon="save_alt"
                      Click="@GenerateStudentReport"
                      Disabled="@isLoading"
                      Style="width: 100%; margin-bottom: 10px;" />
    </div>
}

@code {
    private string studentSearch;
    private int selectedStudentId;
    private int selectedTermId;
    private bool isLoading;
    private List<Student> students = new();
    private List<SchoolTerm> terms = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            terms = await authService.GetAllSchoolTermsAsync();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Initialisation Error", $"Error loading terms: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchStudents(object args)
    {
        if (args is not string query || string.IsNullOrWhiteSpace(query))
            return;

        try
        {
            isLoading = true;
            studentSearch = query;
            students = (await authService.SearchStudentsAsync(query)).ToList();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Search Error", $"Error searching students: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateStudentReport()
    {
        if (selectedStudentId == 0)
        {
            Notify.ShowNotification("Validation", "Please select a student.", NotificationSeverity.Warning);
            return;
        }
        if (selectedTermId == 0)
        {
            Notify.ShowNotification("Validation", "Please select a term.", NotificationSeverity.Warning);
            return;
        }

        try
        {
            isLoading = true;

            var studentFeeData = (await authService.GetStudentFeesByStudentIdandTermAsync(selectedStudentId, selectedTermId)).ToList();
            if (!studentFeeData.Any())
            {
                Notify.ShowNotification("No Data", "No fee records found for the selected student and term.", NotificationSeverity.Warning);
                return;
            }

            var classId = studentFeeData.First().ClassID;
            var expectedFees = (await authService.GetFeeAmountsByClassIDAsync(classId)).ToList();
            var expectedTotal = expectedFees.Sum(x => x.Amount);

            // Build CSV payload
            var csvBuilder = new StringBuilder();
            foreach (var record in studentFeeData)
            {
                csvBuilder.AppendLine($"{record.StudentName}, {record.FeeTypeName}, {record.ClassID}, {record.AmountPaid:F2}, {record.AmountLeft:F2}, {record.TermID}");
            }

            // Summarise per fee type — order by PaymentDate descending for reliable most-recent status
            var feeTypeSummaries = studentFeeData
                .GroupBy(f => f.FeeTypeID)
                .Select(g =>
                {
                    var latest = g.OrderByDescending(f => f.PaymentDate).First();
                    return new
                    {
                        Paid = g.Sum(x => x.AmountPaid),
                        Left = latest.AmountLeft
                    };
                })
                .ToList();

            var totalPaid = feeTypeSummaries.Sum(x => x.Paid);
            var totalLeft = feeTypeSummaries.Sum(x => x.Left);

            csvBuilder.AppendLine("Expected Fee Amounts:");
            foreach (var item in expectedFees)
            {
                csvBuilder.AppendLine($"{item.FeeTypeName.ToUpper()}: GH {item.Amount:F2}");
            }
            csvBuilder.AppendLine($"TOTAL EXPECTED FEES: GH {expectedTotal:F2}");
            csvBuilder.AppendLine($"TOTAL PAID: GH {totalPaid:F2}");
            csvBuilder.AppendLine($"OUTSTANDING BALANCE: GH {totalLeft:F2}");

            var base64Csv = Convert.ToBase64String(Encoding.UTF8.GetBytes(csvBuilder.ToString()));
            var (companyName, schoolName, logoBase64) = await authService.GetPdfLoginScreenDetailsAsync();
            var fileName = $"Student_Fees_{selectedStudentId}_{DateTime.Now:yyyyMMddHHmmss}.pdf";

            var reports = new[]
            {
                new
                {
                    feeDataCsv  = base64Csv,
                    studentName = studentFeeData.First().StudentName,
                    termId      = studentFeeData.First().TermID.ToString()
                }
            };

            await JSRuntime.InvokeVoidAsync(
                "downloadPdfFeesForMultipleStudents",
                fileName,
                reports,
                companyName,
                schoolName,
                logoBase64,
                DateTime.Now.ToString("dd MMM yyyy")
            );

            Notify.ShowNotification("Success", "Report generated successfully.", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"Report generation failed: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
