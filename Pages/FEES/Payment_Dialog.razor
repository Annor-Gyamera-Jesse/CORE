@inject AuthService authService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using System.Text
<RadzenNotification />

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="card" style="padding: 20px; max-width: 600px; margin: auto;">
        <RadzenTextBox Placeholder="🔍 Search student by name..." Value="@searchText"
        Style="width: 100%; margin-bottom: 20px;"
        Change="@(args => SearchStudents(args))" />

        <RadzenDropDown Data="@students" TextProperty="FullName" ValueProperty="StudentID"
        @bind-Value="selectedStudentId" Placeholder="Select a student"
        Style="width: 100%; margin-bottom: 20px;" />

        <RadzenDropDown Data="@terms" TextProperty="Term" ValueProperty="TermID"
        @bind-Value="selectedTermId" Placeholder="Select term"
        Style="width: 100%; margin-bottom: 20px;" />

        <RadzenButton Text="Generate Report" Icon="save_alt" Click="@GenerateStudentReport"
        Disabled="@isLoading" Style="width: 100%; margin-bottom: 10px;" />
    </div>
}
@code {
    private string searchText;
    private int selectedStudentId;
    private List<Student> students = new();
    private bool isLoading;
    private List<SchoolTerm> terms = new();
    private int selectedTermId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            terms = await authService.GetAllSchoolTermsAsync();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error loading terms: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task SearchStudents(object args)
    {
        try
        {
            isLoading = true;
            if (args is null || args is not string)
            {
                return;
            }
            if (args is string searchText && !string.IsNullOrWhiteSpace(searchText))
            {
                this.searchText = searchText;
                try
                {
                    isLoading = true;
                    students = (await authService.SearchStudentsAsync(searchText)).ToList();
                }
                catch (Exception ex)
                {
                    Notify.ShowNotification($"Error searching students: {ex.Message}", "", NotificationSeverity.Error);
                }
                finally
                {
                    isLoading = false;
                }
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error searching students: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateStudentReport()
    {
        if (string.IsNullOrWhiteSpace(searchText) || selectedStudentId == 0 || selectedTermId == 0)
        {
            Notify.ShowNotification("Please select student and term.", "", NotificationSeverity.Warning);
            return;
        }

        try
        {
            isLoading = true;

            var studentFeeData = (await authService.GetStudentFeesByStudentIdandTermAsync(selectedStudentId, selectedTermId)).ToList();
            if (!studentFeeData.Any())
            {
                Notify.ShowNotification("No data found.", "", NotificationSeverity.Warning);
                return;
            }

            var classId = studentFeeData.First().ClassID;
            var expectedFees = (await authService.GetFeeAmountsByClassIDAsync(classId)).ToList();
            var expectedTotal = expectedFees.Sum(x => x.Amount);

            // === Build full CSV for display ===
            var csvBuilder = new StringBuilder();
            foreach (var record in studentFeeData)
            {
                csvBuilder.AppendLine($"{record.StudentName}, {record.FeeTypeName}, {record.ClassID}, {record.AmountPaid:F2}, {record.AmountLeft:F2}, {record.TermID}");
            }

            // === Calculate total paid and balance from latest fee status per fee type ===
            var feeTypeSummaries = studentFeeData
                .GroupBy(f => f.FeeTypeID)
                .Select(g =>
                {
                    var latest = g.OrderBy(f => f.AmountLeft).First(); // smallest balance is most recent
                    return new
                    {
                        Paid = g.Sum(x => x.AmountPaid),         // Total paid over time
                        Left = latest.AmountLeft                 // Final status
                    };
                })
                .ToList();

            var totalPaid = feeTypeSummaries.Sum(x => x.Paid);
            var totalLeft = feeTypeSummaries.Sum(x => x.Left);

            // === Append Expected Fees ===
            csvBuilder.AppendLine("Expected Fee Amounts:");
            foreach (var item in expectedFees)
            {
                csvBuilder.AppendLine($"{item.FeeTypeName.ToUpper()}: GH {item.Amount:F2}");
            }

            csvBuilder.AppendLine($"TOTAL EXPECTED FEES: GH {expectedTotal:F2}");
            csvBuilder.AppendLine($"TOTAL PAID: GH {totalPaid:F2}");
            csvBuilder.AppendLine($"OUTSTANDING BALANCE: GH {totalLeft:F2}");

            var csvData = Encoding.UTF8.GetBytes(csvBuilder.ToString());
            var base64Csv = Convert.ToBase64String(csvData);

            var (companyName, schoolName, logoBase64) = await authService.GetPdfLoginScreenDetailsAsync();
            var fileName = $"Student_Fees_{selectedStudentId}_{DateTime.Now:yyyyMMddHHmmss}.pdf";

            var report = new
            {
                feeDataCsv = base64Csv,
                studentName = studentFeeData.First().StudentName,
                termId = studentFeeData.First().TermID.ToString()
            };

            var reports = new[] { report };

            await JSRuntime.InvokeVoidAsync(
                "downloadPdfFeesForMultipleStudents",
                fileName,
                reports,
                companyName,
                schoolName,
                logoBase64,
                DateTime.Now.ToString("dd MMM yyyy")
            );

            Notify.ShowNotification("Report generated successfully.", "", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


}
