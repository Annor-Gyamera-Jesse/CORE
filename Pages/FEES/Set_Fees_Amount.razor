@page "/core/pages/fees/set-fee-amount"
@using CORE.MODEL
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject IJSRuntime jsRuntime
@inject AuthService StudentService
@inject NotificationService NotificationService
@inject NotificationMessageService NotificationService
<RadzenNotification />
@using CORE.Pages.LOADING_COMPONENT
<style>
    .text-blue {
    color: blue;
    }

    .text-red {
    color: red;
    }

    .student-list-container {
    max-width: 300px;
    float: left;
    margin-right: 20px;
    }

    .form-container {
    margin-left: 320px;
    }

    .input-group {
    margin-bottom: 15px;
    }

    /* PRINT STUDENT REPOR */
    .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .right-align {
    margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
    height: 60px; /* Adjust the height to your preference */
    padding: 5px 15px; /* Reduce padding */
    }

    /* Additional styling if needed */
    .compact-header .rz-header-title {
    font-size: 18px; /* Make the title smaller */
    }

    .custom-background {
    background-color: green !important;
    }
</style>

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <RadzenHeader title="Set School Fees Payment" class="header-container compact-header">
        <RadzenFieldset Text="TOOL COMPONENT" class="right-align">

            <RadzenDropDown @bind-Value="selectedClassId" Data="@classes" TextProperty="ClassID" ValueProperty="ClassID" Placeholder="Select Class" />
            <RadzenDropDown @bind-Value="selectedFeeTypeId" Data="@feeTypes" TextProperty="FeeTypeName" ValueProperty="FeeTypeID" Placeholder="Select Fee Type" />
            <RadzenNumeric @bind-Value="feeAmount" Min="0" Placeholder="Enter Amount" />

            <RadzenButton Text="Submit" Click="HandleCreate" ButtonStyle="ButtonStyle.Primary" />

            @if (selectedFeeTypeId > 0 && !string.IsNullOrEmpty(selectedClassId))
            {
                <RadzenButton Text="Edit" Click="() => HandleEdit(selectedFeeType)" ButtonStyle="ButtonStyle.Info" />
                <RadzenButton Text="Delete" Click="() => HandleDelete(selectedFeeType)" ButtonStyle="ButtonStyle.Danger" />
            }
            <RadzenTextBox @bind-Value="newFeeTypeName" Placeholder="Enter New Fee Type Name" Style="margin-top:10px;" />
            <RadzenButton Text="Add New Fee Type" Click="CreateNewFeeType" ButtonStyle="ButtonStyle.Success" Style="margin-top:10px;" />

        </RadzenFieldset>
    </RadzenHeader>


    <RadzenDataGrid @ref="feeGrid" Data="@feeTypes" TItem="FeeType" ShowPaging="true" PageSize="5">
        <Columns>
            <RadzenDataGridColumn TItem="FeeType" Property="ClassID" Title="Class ID" />
            <RadzenDataGridColumn TItem="FeeType" Property="FeeTypeName" Title="Fee Type" />
            <RadzenDataGridColumn TItem="FeeType" Property="Amount" Title="Amount" />
            <br />
            <RadzenDataGridColumn TItem="FeeType">
                <Template Context="fee">
                    <RadzenButton Text="Edit" ButtonStyle="ButtonStyle.Info" Click="() => HandleEdit(fee)" />
                    <RadzenButton Text="Delete" ButtonStyle="ButtonStyle.Danger" Click="() => HandleDelete(fee)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FeeType" Property="EditBy" Title="Edited By UserID">
                <Template Context="fee">
                    @if (fee.EditBy != null)
                    {
                        <span>@fee.EditBy</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FeeType" Property="EditedOnRecDateCreated" Title="Edited On">
                <Template Context="fee">
                    @if (fee.EditedOnRecDateCreated != null)
                    {
                        <span>@fee.EditedOnRecDateCreated</span>
                    }
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="FeeType" Property="DeletedBy" Title="Deleted By UserID">
                <Template Context="fee">
                    @if (fee.DeletedBy != null)
                    {
                        <span>@fee.DeletedBy</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FeeType" Property="DeletedOnRecDateCreated" Title="Deleted On">
                <Template Context="fee">
                    @if (fee.DeletedOnRecDateCreated != null)
                    {
                        <span>@fee.DeletedOnRecDateCreated</span>
                    }
                </Template>
            </RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>
}

@code {
    private List<Class> classes = new List<Class>();       // List to hold the classes
    private List<FeeType> feeTypes = new List<FeeType>();  // List to hold the fee types
    private string newFeeTypeName;
    private string selectedClassId;
    private int selectedFeeTypeId;
    private decimal feeAmount;
    private bool isLoading = false;
    private FeeType selectedFeeType; // To hold the current selected fee for editing
    private RadzenDataGrid<FeeType> feeGrid;

    protected override async Task OnInitializedAsync()
    {        
        try
        {
            isLoading = true;
            // Fetch classes and fee types
            classes = await StudentService.GetAllforsetfeesFeeTypesAsync();       // Fetching classes
            feeTypes = await StudentService.GetAllFeeTypesAsync();     // Fetching fee types
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Initialization Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleCreate()
    {

        try
        {
            isLoading = true;
            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            var user = await StudentService.GetUserByUsernameAsync(username);

            if (user != null)
            {
                var userId = user.UserID;
                string feeTypeName = feeTypes.FirstOrDefault(ft => ft.FeeTypeID == selectedFeeTypeId)?.FeeTypeName;

                if (string.IsNullOrEmpty(feeTypeName))
                {
                    NotificationService.ShowNotification("Error", "Fee Type Name is required.", NotificationSeverity.Error);
                    return;
                }

                // Check if the fee record already exists for the given class and fee type
                var existingFee = feeTypes.FirstOrDefault(ft => ft.ClassID == selectedClassId && ft.FeeTypeID == selectedFeeTypeId);

                if (existingFee != null)
                {
                    // If exists, call HandleEdit to update
                    selectedFeeType = existingFee;
                    await HandleEdit(); // Update the existing record
                }
                else
                {
                    // If not exists, insert a new record
                    await StudentService.InsertFeeAmountAsync(selectedClassId, selectedFeeTypeId, feeAmount, userId, feeTypeName);

                    // Refresh the list of fee types
                    feeTypes = await StudentService.GetAllFeeTypesAsync();
                    NotificationService.ShowNotification("", "Fee Amount Created Successfully", NotificationSeverity.Success);
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Initialization Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task CreateNewFeeType()
    {
        if (string.IsNullOrWhiteSpace(newFeeTypeName))
        {
            NotificationService.ShowNotification("Validation Error", "Fee Type Name cannot be empty", NotificationSeverity.Warning);
            return;
        }

        try
        {
            isLoading = true;
            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            var user = await StudentService.GetUserByUsernameAsync(username);

            if (user != null)
            {
                int userId = user.UserID;

                var newFee = new FeeType
                    {
                        FeeTypeName = newFeeTypeName.Trim(),
                        ClassID = "", // Optional, or set default class if needed
                        Amount = 0,   // Default, can be updated later
                        UserID = userId
                    };

                await StudentService.InsertNewFeeTypeAsync(newFee);

                // Refresh the list
                feeTypes = await StudentService.GetAllFeeTypesAsync();

                newFeeTypeName = ""; // Reset textbox
                NotificationService.ShowNotification("Success", "Fee Type added successfully", NotificationSeverity.Success);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Insert Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleEdit(FeeType fee = null)
    {
        try
        {
            isLoading = true;
            if (fee != null)
        {
            selectedFeeType = fee;
            selectedClassId = fee.ClassID;
            selectedFeeTypeId = fee.FeeTypeID;
            feeAmount = fee.Amount;
        }

        if (selectedFeeType != null)
        {
            
            try
            {
                isLoading = true;
                var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
                var user = await StudentService.GetUserByUsernameAsync(username);

                if (user != null)
                {
                    var userId = user.UserID;
                    await StudentService.UpdateFeeAmountAsync(selectedFeeType.FeeTypeID, selectedFeeType.ClassID, feeAmount, userId);

                    // Refresh the fee types list
                    feeTypes = await StudentService.GetAllFeeTypesAsync();
                    NotificationService.ShowNotification("", "Fee Amount Updated Successfully", NotificationSeverity.Success);
                }
            }
            catch (Exception ex)
            {
                NotificationService.ShowNotification("Error", $"Edit Error: {ex.Message}", NotificationSeverity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Initialization Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task HandleDelete(FeeType fee)
    {
        if (fee == null) return;

        bool confirmed = await jsRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the fee type: {fee.FeeTypeName}?");
        if (!confirmed) return;
        
        try
        {
            isLoading = true;
            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            var user = await StudentService.GetUserByUsernameAsync(username);

            if (user != null)
            {
                await StudentService.DeleteFeeAmountAsync(fee.FeeTypeID, user.UserID);

                // Refresh the grid data
                feeTypes = await StudentService.GetAllFeeTypesAsync();
                NotificationService.ShowNotification("", "Fee Type Deleted Successfully", NotificationSeverity.Success);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Delete Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

}
