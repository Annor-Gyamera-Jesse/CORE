@page "/editotherfees"
@using CORE.MODEL.FEEDING_FEE
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService otherFeesService
@inject NotificationService notificationService
@inject NotificationMessageService NotificationService
@inject IJSRuntime jsRuntime
<RadzenNotification />

<PageTitle>Other Fees</PageTitle>

<RadzenCard Style="padding:20px">
    <h3 class="text-xl font-bold mb-3">Manage Other Fees</h3>

    <RadzenDataGrid @ref="grid" Data="@otherFees" TItem="OtherFee"
                    AllowPaging="true" PageSize="10"
                    AllowFiltering="true" AllowSorting="true"
                    RowUpdate="@OnUpdateRow"
                    EditMode="DataGridEditMode.Single">
        <Columns>
            <RadzenDataGridColumn TItem="OtherFee" Property="FeeTypeID" Title="ID" Width="70px" />

            <RadzenDataGridColumn TItem="OtherFee" Property="FeeTypeName" Title="Fee Type">
                <EditTemplate Context="fee">
                    <RadzenTextBox @bind-Value="fee.FeeTypeName" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="OtherFee" Property="Description" Title="Description">
                <EditTemplate Context="fee">
                    <RadzenTextBox @bind-Value="fee.Description" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="OtherFee" Property="Amount" Title="Amount">
                <EditTemplate Context="fee">
                    <RadzenNumeric @bind-Value="fee.Amount" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="OtherFee" Property="ClassID" Title="Class">
                <EditTemplate Context="fee">
                    <RadzenTextBox @bind-Value="fee.ClassID" Style="width:100%" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="OtherFee" Context="data" Title="Actions" Width="200px">
                <Template Context="data">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                  Click="@(() => grid.EditRow(data))" />
                    <RadzenButton Icon="save" ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small"
                                  Click="@(() => grid.UpdateRow(data))"
                                  Style="margin-left:5px" />
                    <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                  Click="@(() => grid.CancelEditRow(data))"
                                  Style="margin-left:5px" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Click="@(() => DeleteRow(data))"
                                  Style="margin-left:5px" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</RadzenCard>

@code {
    private RadzenDataGrid<OtherFee> grid;
    private List<OtherFee> otherFees = new();
    public int userId;

    protected override async Task OnInitializedAsync()
    {
        var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");

        if (string.IsNullOrWhiteSpace(username))
        {
            NotificationService.ShowNotification("User Error", "User not logged in or session expired.", NotificationSeverity.Error);
            return;
        }

        var user = await otherFeesService.GetUserByUsernameAsync(username);
        if (user == null)
        {
            NotificationService.ShowNotification("User Error", "User not found.", NotificationSeverity.Error);
            return;
        }

        userId = user.UserID;

        otherFees = await otherFeesService.GetOtherFeesAsync();
    }

    async Task OnUpdateRow(OtherFee fee)
    {
        await otherFeesService.UpdateOtherFeeAsync(fee, userId);

        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Updated",
                Detail = $"Fee updated successfully by user {userId}!"
            });
    }

    async Task DeleteRow(OtherFee fee)
    {
        int userId = 1; // ⚡ replace with logged-in user id
        await otherFeesService.DeleteOtherFeeAsync(fee.FeeTypeID, userId);

        otherFees.Remove(fee);
        notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Deleted",
                Detail = "Fee deleted successfully!"
            });
    }
}
