@page "/core/pages/fees/account-reconciliation"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService AccountReconciliationService

<h3>Account Reconciliation</h3>

<!-- 🔹 Search Header -->
<RadzenFieldset Text="Search Student">
    <RadzenTextBox @bind-Value="searchTerm" Placeholder="Search student..." Style="width: 300px;" />
    <RadzenButton Text="Search" Click="@SearchStudents" Icon="search" Style="margin-left: 10px;" />
</RadzenFieldset>

<RadzenRow>
    <!-- 🔹 Left: Select Students -->
    <RadzenColumn Size="6">
        <RadzenFieldset Text="Select Students">
            <RadzenListBox TValue="Student" Data="@students" TextProperty="FullName"
                           @bind-Value="@selectedStudent"
                           Change="@(args => OnSelectStudent(selectedStudent))"
                           Style="width: 100%; height: 300px;" />
        </RadzenFieldset>
    </RadzenColumn>

    <!-- 🔹 Right: Selected Student (Name + Class) -->
    <RadzenColumn Size="6">
        <RadzenFieldset Text="Selected Student">
            <RadzenListBox TValue="string" Data="@selectedStudentsDisplay"
                           Style="width: 100%; height: 300px;" />
        </RadzenFieldset>
    </RadzenColumn>
</RadzenRow>

<!-- 🔹 Bottom Section: Student Fees Results -->
<RadzenFieldset Text="Student Fees Result">
    <RadzenDataGrid Data="@studentFees" TItem="StudentFee" Style="width: 100%;">
        <Columns>
            <RadzenDataGridColumn TItem="StudentFee" Property="StudentName" Title="Student" />
            <RadzenDataGridColumn TItem="StudentFee" Property="FeeTypeName" Title="Fee Type" />
            <RadzenDataGridColumn TItem="StudentFee" Property="AmountPaid" Title="Paid" />
            <RadzenDataGridColumn TItem="StudentFee" Property="AmountLeft" Title="Remaining" />
            <RadzenDataGridColumn TItem="StudentFee" Property="PaymentDate" Title="Payment Date" />
            @* <RadzenDataGridColumn TItem="StudentFee" Property="DueDate" Title="Due Date" /> *@
        </Columns>
    </RadzenDataGrid>
</RadzenFieldset>

@code {
    private string searchTerm;
    private List<Student> students = new();
    private Student selectedStudent;
    private List<string> selectedStudentsDisplay = new(); // Stores Name + Class
    private List<StudentFee> studentFees = new();

    private async Task SearchStudents()
    {
        students = (await AccountReconciliationService.SearchStudentAsync(searchTerm)).ToList();
    }

    private async Task OnSelectStudent(Student student)
    {
        if (student != null)
        {
            // 🔹 Ensure only the selected student is displayed with Class
            selectedStudentsDisplay.Clear();
            selectedStudentsDisplay.Add($"{student.FullName} - Class {student.ClassID}");

            // 🔹 Fetch the selected student's fees
            studentFees = (await AccountReconciliationService.GetStudentFeesAsync(student.StudentID)).ToList();

            // 🔹 Refresh UI
            StateHasChanged();
        }
    }
}
