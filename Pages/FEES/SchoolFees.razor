@page "/core/pages/fees/schoolfees"
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using CORE.Tool_Components
@using Radzen
@inject NotificationMessageService NotificationService
@inject AuthService StudentService
@inject IJSRuntime jsRuntime
@inherits SchoolFeesCodeBehind
<RadzenNotification />

<!-- Custom CSS -->
<style>
    .fees-page {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .fees-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        background: #fff;
        border-bottom: 1px solid #e0e0e0;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        margin-bottom: 0;
    }

    .fees-toolbar-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .fees-body {
        display: flex;
        gap: 16px;
        padding: 16px;
    }

    .student-panel {
        width: 280px;
        flex-shrink: 0;
    }

    .payment-panel {
        flex: 1;
        min-width: 0;
    }

    .balance-row {
        display: flex;
        gap: 12px;
        margin-bottom: 14px;
    }

    .balance-card {
        flex: 1;
        padding: 14px 16px;
        border-radius: 8px;
        border-left: 5px solid;
    }

        .balance-card.outstanding {
            background: #fff1f2;
            border-color: #e53935;
        }

        .balance-card.previous {
            flex: 1.4;
            background: #fffbeb;
            border-color: #f59e0b;
            max-height: 160px;
            overflow-y: auto;
        }

        .balance-card h4 {
            margin: 0 0 6px 0;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        .balance-card.outstanding h4 {
            color: #b71c1c;
        }

        .balance-card.previous h4 {
            color: #92400e;
        }

    .balance-amount {
        font-size: 1.5rem;
        font-weight: 700;
        color: #b71c1c;
    }

    .payment-summary-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 12px 16px;
        background: #f0fdf4;
        border: 1px solid #86efac;
        border-radius: 8px;
        margin-bottom: 14px;
    }

    .summary-chip {
        display: flex;
        flex-direction: column;
    }

        .summary-chip label {
            font-size: 0.68rem;
            text-transform: uppercase;
            color: #6b7280;
            font-weight: 700;
            letter-spacing: 0.04em;
        }

        .summary-chip span {
            font-size: 0.95rem;
            font-weight: 600;
            color: #166534;
        }

    .summary-divider {
        width: 1px;
        height: 32px;
        background: #bbf7d0;
    }

    .payment-method-group {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        margin-top: 8px;
    }

    .field-group {
        margin-bottom: 14px;
    }

        .field-group > label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 4px;
        }

    .save-btn-wrap {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e5e7eb;
    }

    .discount-badge {
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 600;
        background: #e0f2f1;
    }
</style>

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="fees-page">

        <!-- TOOLBAR -->
        <div class="fees-toolbar">
            <h5 class="fees-toolbar-title">
                &#x1F4B0; School Fees Payment
                &mdash; <span style="color:#6b7280; font-weight:400;">@currentTermName</span>
            </h5>
            <FeesToolPanelComponent OnFeesDialog="FeesDialog"
                                    OnFeesPerDateDialog="FeesPerDate"
                                    OnTransferOfFundsDialog="TransferOfFunds"
                                    OnCashInHandsDialog="CashInHandsDialog"
                                    OnFeesStatementDialog="FeesStatementDialog" />
        </div>

        <!-- BODY -->
        <div class="fees-body">

            <!-- LEFT: STUDENT LIST -->
            <div class="student-panel">
                <RadzenFieldset Text="Students" Icon="person">
                    <div class="field-group">
                        <label>Class</label>
                        <RadzenDropDown @bind-Value="SelectedClassID"
                                        Data="@Classes"
                                        TextProperty="ClassID"
                                        ValueProperty="ClassID"
                                        Style="width:100%;"
                                        Placeholder="All Classes"
                                        Change="OnClassSelected"
                                        AllowClear="true" />
                    </div>
                    <div class="field-group">
                        <label>Search</label>
                        <RadzenTextBox @bind-Value="SearchTerm"
                                       Style="width:100%;"
                                       Placeholder="Student name..."
                                       Change="FilterStudents" />
                    </div>
                    <RadzenListBox Data="@FilteredStudents"
                                   ValueProperty="StudentID"
                                   @bind-Value="SelectedStudentID"
                                   Change="OnStudentSelected"
                                   Style="width:100%; height:520px;">
                        <Template Context="student">
                            <div style="display:flex; align-items:center; justify-content:space-between; padding:2px 0;">
                                <span style="font-size:0.9rem;">@student.FullName</span>
                                @if (!string.IsNullOrEmpty(student.DiscountType))
                                {
                                    @if (student.DiscountType == "Free")
                                    {
                                        <span class="discount-badge" style="color:green;">Free</span>
                                    }
                                    else
                                    {
                                        <span class="discount-badge" style="color:#1d4ed8;">@student.DiscountValue% Off</span>
                                    }
                                }
                            </div>
                        </Template>
                    </RadzenListBox>
                </RadzenFieldset>
            </div>

            <!-- RIGHT: PAYMENT FORM -->
            <div class="payment-panel">

                <!-- SUMMARY BAR -->
                @if (SelectedStudentID > 0)
                {
                    var sel = Students.FirstOrDefault(s => s.StudentID == SelectedStudentID);
                    if (sel != null)
                    {
                        <div class="payment-summary-bar">
                            <div class="summary-chip">
                                <label>Student</label>
                                <span>@sel.FullName</span>
                            </div>
                            <div class="summary-divider"></div>
                            <div class="summary-chip">
                                <label>Class</label>
                                <span>@sel.ClassID</span>
                            </div>
                            @if (SelectedFeeTypeID > 0)
                            {
                                var ft = FeeTypes.FirstOrDefault(f => f.FeeTypeID == SelectedFeeTypeID);
                                if (ft != null)
                                {
                                    <div class="summary-divider"></div>
                                    <div class="summary-chip">
                                        <label>Fee Type</label>
                                        <span>@ft.FeeTypeName</span>
                                    </div>
                                    <div class="summary-divider"></div>
                                    <div class="summary-chip">
                                        <label>Paying</label>
                                        <span style="color:#15803d;">&#x20b5;@AmountPaid.ToString("F2")</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                }

                <!-- BALANCE CARDS -->
                <div class="balance-row">
                    <div class="balance-card outstanding">
                        <h4>This Term Outstanding</h4>
                        <div class="balance-amount">
                            @((OutstandingBalance > 0) ? $"₵{OutstandingBalance:F2}" : "—")
                        </div>
                        @if (OutstandingBalance == 0 && SelectedStudentID > 0 && SelectedFeeTypeID > 0)
                        {
                            <small style="color:#16a34a; font-weight:600;">&#x2713; Fully paid</small>
                        }
                    </div>

                    <div class="balance-card previous">
                        <h4>Previous Balances</h4>
                        @if (PreviousBalancesBreakdown != null && PreviousBalancesBreakdown.Any())
                        {
                            <ul style="margin:0; padding-left:16px; line-height:1.8;">
                                @foreach (var fee in PreviousBalancesBreakdown)
                                {
                                    <li style="font-size:0.83rem;">
                                        <strong>@fee.FeeTypeName (@fee.ClassID)</strong>: &#x20b5;@fee.AmountLeft
                                        @if (!string.IsNullOrEmpty(fee.Note))
                                        {
                                            <br />
                            
                                            <small style="color:#78716c;">@fee.Note</small>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <small style="color:#92400e;">No previous balances.</small>
                        }
                    </div>
                </div>

                <!-- PAYMENT FORM -->
                <RadzenFieldset Text="Payment Details" Icon="payment">
                    <div style="display:flex; gap:16px;">
                        <div style="flex:1;" class="field-group">
                            <label>Payment Date</label>
                            <RadzenDatePicker @bind-Value="PaymentDate" Style="width:100%;" />
                        </div>
                        <div style="flex:1;" class="field-group">
                            <label>Fee Type</label>
                            <RadzenDropDown @bind-Value="SelectedFeeTypeID"
                                            Data="@FeeTypes"
                                            TextProperty="FeeTypeName"
                                            ValueProperty="FeeTypeID"
                                            Style="width:100%;"
                                            Disabled="@string.IsNullOrEmpty(SelectedClassID)"
                                            Placeholder="Select Fee Type"
                                            Change="LoadClassFeeDetails" />
                        </div>
                    </div>

                    <div class="field-group">
                        <label>Amount Paid (&#x20b5;)</label>
                        <RadzenNumeric TValue="decimal"
                                       @bind-Value="AmountPaid"
                                       Style="width:100%;" />
                    </div>

                    <div class="payment-method-group">
                        <RadzenCheckBox @bind-Value="IsCashInHand" TValue="bool" />
                        <RadzenLabel Text="Cash In Hand" />
                        @if (!IsCashInHand)
                        {
                            @* <div style="flex:1; margin-left:4px;">
                                <RadzenDropDown @bind-Value="PaymentMethod"
                                                Data="@PaymentMethods"
                                                Placeholder="Select Bank / Method"
                                                Style="width:100%;" />
                            </div> *@
                        }
                        else
                        {
                            <span style="font-size:0.83rem; color:#6b7280;">Payment recorded as cash</span>
                        }
                    </div>

                    <div class="field-group" style="margin-top:14px;">
                        <label>Note <span style="font-weight:400; color:#9ca3af;">(optional)</span></label>
                        <RadzenTextBox @bind-Value="Note"
                                       Style="width:100%;"
                                       Multiline="true" />
                    </div>

                    <div class="save-btn-wrap">
                        <RadzenButton Text="Save Payment"
                                      Icon="save"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="SavePayment"
                                      Style="width:100%; font-size:1rem; padding:12px;" />
                    </div>
                </RadzenFieldset>
            </div>
        </div>
    </div>
}

@code {
    private DateTime PaymentDate = DateTime.Now;
    private string FeeID = string.Empty;
    private int SelectedStudentID;
    private int SelectedFeeTypeID;
    private decimal AmountPaid = 0;
    private string PaymentMethod;
    private string Note = string.Empty;
    private bool isLoading = false;
    private decimal TotalAmountLeft = 0;
    private int userId; // Added for tracking UserID
    private List<Student> Students = new List<Student>();
    private List<Student> FilteredStudents = new List<Student>();
    private List<FeeType> FeeTypes = new List<FeeType>();
    private List<string> PaymentMethods = new List<string>();
    private decimal TotalAmount { get; set; }
    private decimal OutstandingBalance { get; set; }
    private int SelectedTermID;
    private List<SchoolTerm> Terms = new List<SchoolTerm>();
    private string SearchTerm = string.Empty;
    private string SelectedClassID; // Holds the selected class
    private List<Class> Classes = new List<Class>(); // Stores the list of classes
                                                     // private bool IsCashInHand = false;
    private bool _isCashInHand;
    private List<StudentFee> PreviousBalancesBreakdown = new List<StudentFee>();
    private string currentTermName;


    private bool IsCashInHand
    {
        get => _isCashInHand;
        set
        {
            _isCashInHand = value;
            if (_isCashInHand)
            {
                PaymentMethod = "Cash In Hand";
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");

            if (string.IsNullOrWhiteSpace(username))
            {
                NotificationService.ShowNotification("User Error", "User not logged in or session expired.", NotificationSeverity.Error);
                return;
            }

            var user = await StudentService.GetUserByUsernameAsync(username);
            if (user == null)
            {
                NotificationService.ShowNotification("User Error", "User not found.", NotificationSeverity.Error);
                return;
            }

            userId = user.UserID;

            // Fetch the current term
            var currentTerm = await StudentService.GetCurrentSchoolTermAsync();
            if (currentTerm != null)
            {
                SelectedTermID = currentTerm.TermID;
                currentTermName = currentTerm.Term;
            }
            // Fetch classes
            Classes = await StudentService.GetsAllClassesAsync();

            PaymentMethods = await StudentService.GetPaymentMethodsAsync();

            // Existing initialization logic
            // var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            // var user = await StudentService.GetUserByUsernameAsync(username);
            // if (user != null)
            // {
            //     userId = user.UserID;
            // }

            Students = await StudentService.GetAllStudents();
            FilteredStudents = Students; // Initialize the filtered list with all students
            FeeTypes = await StudentService.GetFeeTypesAsync();
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Initialization Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnClassSelected(object value)
    {
        try
        {
            isLoading = true;

            SelectedClassID = value?.ToString();

            // Filter students based on the selected class
            if (!string.IsNullOrEmpty(SelectedClassID))
            {
                FilteredStudents = Students.Where(s => s.ClassID == SelectedClassID).ToList();
                FeeTypes = await StudentService.GetFeeTypesByClassAsync(SelectedClassID);
            }
            else
            {
                FilteredStudents = Students; // Reset the list if no class is selected
            }

            // Clear any previously selected fee type and reset outstanding balance
            SelectedFeeTypeID = 0;
            OutstandingBalance = 0;
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    private void FilterStudents(object value)
    {
        // Start from the class-filtered list if a class is selected, otherwise all students
        var baseList = !string.IsNullOrEmpty(SelectedClassID)
            ? Students.Where(s => s.ClassID == SelectedClassID)
            : Students.AsEnumerable();

        FilteredStudents = string.IsNullOrWhiteSpace(SearchTerm)
            ? baseList.ToList()
            : baseList.Where(s => s.FullName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task OnStudentSelected(object args)
    {
        isLoading = true;  // Start loading
        StateHasChanged();

        try
        {
            AmountPaid = 0;
            OutstandingBalance = 0;
            PaymentMethod = string.Empty;
            Note = string.Empty;
            SelectedFeeTypeID = 0;  // Reset Fee Type

            // Fetch the selected student's fees
            var studentFees = await StudentService.GetStudentFeesByStudentIdAsync(SelectedStudentID);

            // Always update previous balance breakdown
            PreviousBalancesBreakdown = await StudentService.GetPreviousBalancesBreakdownAsync(SelectedStudentID, SelectedTermID);

            // Calculate the outstanding balance for the selected student and fee type
            var feeType = FeeTypes.FirstOrDefault(f => f.FeeTypeID == SelectedFeeTypeID);
            if (feeType != null)
            {
                TotalAmount = feeType.Amount;
                var studentFee = studentFees.FirstOrDefault(f => f.FeeTypeID == SelectedFeeTypeID);

                OutstandingBalance = studentFee != null ? (feeType.Amount - studentFee.AmountPaid) : feeType.Amount;
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ResetPaymentForm()
    {
        PaymentDate = DateTime.Now;
        SelectedFeeTypeID = 0;
        AmountPaid = 0;
        Note = string.Empty;
        OutstandingBalance = 0;
        TotalAmountLeft = 0;
        _isCashInHand = false;   // Set backing field directly to avoid setter side-effect
        PaymentMethod = null;
        SelectedClassID = null;
        FilteredStudents = Students;
        SelectedStudentID = 0;
        PreviousBalancesBreakdown = new List<StudentFee>();
    }


    private async Task LoadClassFeeDetails(object value)
    {
        isLoading = true;  // Start loading
        StateHasChanged();
        try
        {
            SelectedFeeTypeID = Convert.ToInt32(value);
            if (SelectedStudentID > 0 && SelectedFeeTypeID > 0)
            {
                OutstandingBalance = await StudentService.GetOutstandingBalanceAsync(SelectedStudentID, SelectedFeeTypeID, SelectedTermID);
            }

            // Fetch fee details for the selected fee type
            var feeType = FeeTypes.FirstOrDefault(ft => ft.FeeTypeID == SelectedFeeTypeID);
            if (feeType != null)
            {
                // Use the fee amount from the FeeType for the total amount left
                TotalAmountLeft = feeType.Amount;

                // Update OutstandingBalance accordingly
                // if (SelectedStudentID > 0)
                // {
                //     var studentFee = await StudentService.GetStudentFeeAsync(SelectedStudentID, SelectedFeeTypeID);
                //     OutstandingBalance = studentFee?.AmountLeft ?? TotalAmountLeft;
                // }
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    private async Task SavePayment()
    {
        // Validate before setting isLoading so spinner never gets stuck on early exit
        if (SelectedStudentID <= 0)
        {
            NotificationService.ShowNotification("Validation Error", "Please select a student.", NotificationSeverity.Warning);
            return;
        }
        if (SelectedTermID <= 0)
        {
            NotificationService.ShowNotification("Validation Error", "No active term found. Please contact admin.", NotificationSeverity.Warning);
            return;
        }
        if (SelectedFeeTypeID <= 0)
        {
            NotificationService.ShowNotification("Validation Error", "Please select a fee type.", NotificationSeverity.Warning);
            return;
        }
        if (AmountPaid <= 0)
        {
            NotificationService.ShowNotification("Validation Error", "Amount paid must be greater than zero.", NotificationSeverity.Warning);
            return;
        }
        if (PaymentDate == default(DateTime))
        {
            NotificationService.ShowNotification("Validation Error", "Please select a valid payment date.", NotificationSeverity.Warning);
            return;
        }
        if (AmountPaid > OutstandingBalance)
        {
            NotificationService.ShowNotification("Validation Error", "Amount paid cannot exceed the outstanding balance.", NotificationSeverity.Warning);
            return;
        }
        if (OutstandingBalance < 0)
        {
            NotificationService.ShowNotification("Validation Error", "Outstanding balance cannot be negative.", NotificationSeverity.Warning);
            return;
        }
        if (string.IsNullOrEmpty(PaymentMethod) && !IsCashInHand)
        {
            NotificationService.ShowNotification("Validation Error", "Please select a payment method.", NotificationSeverity.Warning);
            return;
        }

        // Set the payment method to "Cash In Hand" if the checkbox is checked
        if (IsCashInHand)
        {
            PaymentMethod = "Cash In Hand";
        }

        // Resolve names once so confirmation dialog and payment object share same values
        var studentName = Students.FirstOrDefault(s => s.StudentID == SelectedStudentID)?.FullName ?? "Unknown";
        var feeTypeName = FeeTypes.FirstOrDefault(ft => ft.FeeTypeID == SelectedFeeTypeID)?.FeeTypeName ?? "Unknown";
        var studentClassID = Students.FirstOrDefault(s => s.StudentID == SelectedStudentID)?.ClassID;

        // Confirm before committing financial transaction
        bool confirmed = await DialogService.Confirm(
            $"Save payment of \u20b5{AmountPaid:F2} for {studentName} ({feeTypeName})?",
            "Confirm Payment",
            new ConfirmOptions { OkButtonText = "Yes, Save", CancelButtonText = "Cancel" }
        ) ?? false;

        if (!confirmed) return;

        isLoading = true;
        StateHasChanged();
        try
        {
            var payment = new StudentFee
            {
                StudentID = SelectedStudentID,
                FeeTypeID = SelectedFeeTypeID,
                StudentName = studentName,
                FeeTypeName = feeTypeName,
                ClassID = studentClassID,
                AmountPaid = AmountPaid,
                AmountLeft = TotalAmountLeft - AmountPaid,
                PaymentDate = PaymentDate,
                PaymentMethod = PaymentMethod,
                TermID = SelectedTermID,
                Note = Note,
                UserID = userId
            };

            // Save the student fee
            var success = await StudentService.SaveStudentFeeAsync(payment);
            if (success)
            {
                if (!IsCashInHand)
                {
                    int bankId = await StudentService.GetBankIDAsync(PaymentMethod);
                    if (bankId == 0)
                    {
                        NotificationService.ShowNotification("Error", "Invalid payment method selected.", NotificationSeverity.Error);
                        return;
                    }

                    await StudentService.LogsBankTransactionAsync(bankId, "Deposit", AmountPaid, "Success", null);
                }

                OutstandingBalance = await StudentService.GetOutstandingBalanceAsync(SelectedStudentID, SelectedFeeTypeID, SelectedTermID);

                NotificationService.ShowNotification("Success", "Payment saved successfully and logged.", NotificationSeverity.Success);
                ResetPaymentForm();
            }
            else
            {
                NotificationService.ShowNotification("Error", "Failed to save payment.", NotificationSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateAmountLeft(decimal value)
    {
        isLoading = true;  // Start loading
        StateHasChanged();
        try
        {
            OutstandingBalance = TotalAmount - value;
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    async void FeesDialog()
    {
        try { await OpenPaymentDialog(); }
        catch (Exception ex) { NotificationService.ShowNotification("Error", ex.Message, NotificationSeverity.Error); }
    }

    async void FeesPerDate()
    {
        try { await OpenFeesPerDateDialog(); }
        catch (Exception ex) { NotificationService.ShowNotification("Error", ex.Message, NotificationSeverity.Error); }
    }

    async void TransferOfFunds()
    {
        try { await OpenTransferOfFundsDialog(); }
        catch (Exception ex) { NotificationService.ShowNotification("Error", ex.Message, NotificationSeverity.Error); }
    }

    async void CashInHandsDialog()
    {
        try { await OpenCashInHandsDialog(); }
        catch (Exception ex) { NotificationService.ShowNotification("Error", ex.Message, NotificationSeverity.Error); }
    }

    async void Carryover()
    {
        try { await OpenCarryOverDialog(); }
        catch (Exception ex) { NotificationService.ShowNotification("Error", ex.Message, NotificationSeverity.Error); }
    }

    async void FeesStatementDialog()
    {
        try { await OpenFeesSummaryDialog(); }
        catch (Exception ex) { NotificationService.ShowNotification("Error", ex.Message, NotificationSeverity.Error); }
    }
}