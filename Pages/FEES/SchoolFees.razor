@page "/core/pages/fees/schoolfees"
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using CORE.Tool_Components
@using Radzen
@inject NotificationMessageService NotificationService
@inject AuthService StudentService
@inject IJSRuntime jsRuntime
@inherits SchoolFeesCodeBehind
<RadzenNotification />

<!-- Custom CSS -->
<style>
    .text-blue {
    color: blue;
    }

    .text-red {
    color: red;
    }

    .student-list-container {
    max-width: 300px;
    float: left;
    margin-right: 20px;
    }

    .form-container {
    margin-left: 320px;
    }

    .input-group {
    margin-bottom: 15px;
    }

    /* PRINT STUDENT REPOR */
    .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .right-align {
    margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
    height: 60px; /* Adjust the height to your preference */
    padding: 5px 15px; /* Reduce padding */
    }

    /* Additional styling if needed */
    .compact-header .rz-header-title {
    font-size: 18px; /* Make the title smaller */
    }

    .custom-background {
    background-color: green!important;
    }
</style>

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{

    <RadzenHeader title="School Fees Payment" class="header-container compact-header">
        <RadzenFieldset Text="EXPORT STUDENT REPORT" class="right-align">
            <FeesToolPanelComponent OnFeesDialog="FeesDialog" OnTransferOfFundsDialog="TransferOfFunds" OnCashInHandsDialog="CashInHandsDialog" />
        </RadzenFieldset>
    </RadzenHeader>
    <br />

    <div class="student-list-container">
        <RadzenFieldset Text="STUDENTS NAMES" Icon="search">
            <!-- Search Box for Students -->
            <div class="input-group">
                <RadzenLabel Text="Class" />
                <RadzenDropDown @bind-Value="SelectedClassID"
                Data="@Classes"
                TextProperty="ClassID"
                ValueProperty="ClassID"
                Style="width: 100%; margin-bottom: 10px;"
                Placeholder="Select Class"
                Change="OnClassSelected" AllowClear="true" />

                <RadzenLabel Text="Search Student" />
                <RadzenTextBox @bind-Value="SearchTerm"
                Style="width: 100%; margin-bottom: 10px;"
                Placeholder="Enter student name..."
                Change="FilterStudents" />
            </div>

            <!-- List of Students -->
            <RadzenListBox Data="@FilteredStudents"
            TextProperty="FullName"
            ValueProperty="StudentID"
            @bind-Value="SelectedStudentID"
            Change="OnStudentSelected"
            Style="width: 100%; height: 600px;"
            Placeholder="Select a Student" />
        </RadzenFieldset>
    </div>

    <div class="form-container" style="max-width: 800px; padding: 20px; border: 1px solid #ccc; border-radius: 8px; background-color: #f9f9f9;">
        <!-- Date and FeeID -->
        <RadzenFieldset Text="FEES PAYMENT" Icon="money">
            <div class="row input-group">
                <div class="col-md-5">
                    <RadzenLabel Text="School Term" />
                    <RadzenDropDown @bind-Value="SelectedTermID"
                                    Data="@Terms"
                                    TextProperty="Term"
                                    ValueProperty="TermID"
                                    Style="width: 100%;"
                                    Placeholder="Select Term" AllowClear="true" />
                </div>
                <div class="col-md-6">
                    <RadzenLabel Text="Payment Date" />
                    <RadzenDatePicker @bind-Value="PaymentDate" Style="width: 100%;" />
                </div>
                <div class="col-md-8">
                    <RadzenLabel Text="This Term Outstanding Balance" />
                    <RadzenTextBox Value="@OutstandingBalance.ToString("F2")"
                                   Style="width: 100%; background-color: #ffe2e6;"
                                   Disabled="true"
                                   Placeholder="Outstanding Balance" />
                    <RadzenCard Style="background-color: #ffe2e6; padding: 16px; margin-top: 20px; border-left: 6px solid red;">
                        <h3 style="color: #b00020;">This Term Outstanding Balance</h3>
                        <p style="font-size: 1.2em;">
                            @((OutstandingBalance > 0) ? $"- ₵{OutstandingBalance:F2}" : "No balance owed")
                        </p>
                    </RadzenCard>

                    <RadzenCard Style="background-color: #fef3c7; padding: 16px; margin-top: 20px; border-left: 6px solid orange;">
                        <h3 style="color: #b45309;">Unpaid Previous Balances</h3>
                        <ul>
                            @foreach (var fee in UnpaidPreviousClassFees)
                            {
                                <li>@fee.FeeTypeName (@fee.ClassID): ₵@fee.AmountLeft</li>
                            }
                        </ul>
                    </RadzenCard>

                </div>
            </div>


            <div class="row input-group">
                <!-- Class Dropdown -->
                @*                 <RadzenLabel Text="Class" />
                <RadzenDropDown @bind-Value="SelectedClassID"
                                Data="@Classes"
                                TextProperty="ClassID"
                                ValueProperty="ClassID"
                                Style="width: 100%;"
                                Placeholder="Select Class"
                                Change="OnClassSelected" /> *@


                <div class="row input-group">
                    <!-- Fee Type Dropdown -->
                    <RadzenLabel Text="Fee Type" />
                    <RadzenDropDown @bind-Value="SelectedFeeTypeID"
                                    Data="@FeeTypes"
                                    TextProperty="FeeTypeName"
                                    ValueProperty="FeeTypeID"
                                    Style="width: 100%;"
                                    Disabled="@string.IsNullOrEmpty(SelectedClassID)"
                                    Placeholder="Select Fee Type"
                                    Change="LoadClassFeeDetails" />

                </div>
            </div>

            <!-- Payment Details -->
            <RadzenFieldset Legend="Payment Details" Style="margin-top: 20px;">
                <RadzenLabel Text="Amount Paid" />
                <RadzenNumeric TValue="decimal"
                @bind-Value="AmountPaid"
                Style="width: 100%;" />


                @* @if (!IsCashInHand) *@
              @*   {
                    <RadzenLabel Text="Payment To Which Bank" Style="margin-top: 10px;" />
                    <RadzenDropDown @bind-Value="PaymentMethod"
                                    Data="@PaymentMethods"
                                    Placeholder="Select Payment Method"
                                    Style="width: 100%;" />
                } *@


                <RadzenCheckBox @bind-Value="IsCashInHand" Style="margin-top: 10px;" TValue="bool" />
                <RadzenLabel Text="Cash In Hand" Style="margin-left: 10px;" />
                <br/>
                <RadzenLabel Text="Note" Style="margin-top: 10px;" />
                <RadzenTextBox @bind-Value="Note"
                Style="width: 100%;"
                Multiline="true" />
            </RadzenFieldset>

            <!-- Total Amount Details -->
            <div class="row input-group">
                <div class="col-md-6">
                    <RadzenLabel Text="Total Amount Paid" />
                    <RadzenNumeric @bind-Value="AmountPaid"
                    Style="width: 100%;"
                    Min="0"
                    Disabled="true"
                    Max="@TotalAmountLeft" />
                </div>
                <div class="col-md-6">
                    <RadzenLabel Text="Total Amount Left" />
                    <RadzenNumeric TValue="decimal"
                    @bind-Value="AmountPaid"
                    Style="width: 100%;"
                    Disabled="true"
                    Max="@OutstandingBalance"
                    Change="@((decimal value) => UpdateAmountLeft(value))"
                    Class="custom-background" />

                </div>
            </div>

            <!-- Save Button -->
            <RadzenButton Text="Save Payment" Click="SavePayment" Style="width: 100%; margin-top: 20px;" />
        </RadzenFieldset>
    </div>

}
@code {
    private DateTime PaymentDate = DateTime.Now;
    private string FeeID = string.Empty;
    private int SelectedStudentID;
    private int SelectedFeeTypeID;
    private decimal AmountPaid = 0;
    private string PaymentMethod;
    private string Note = string.Empty;
    private bool isLoading = false;
    private decimal TotalAmountLeft = 0;
    private int userId; // Added for tracking UserID
    private List<Student> Students = new List<Student>();
    private List<Student> FilteredStudents = new List<Student>();
    private List<FeeType> FeeTypes = new List<FeeType>();
    private List<string> PaymentMethods = new List<string>();
    private decimal TotalAmount { get; set; }
    private decimal OutstandingBalance { get; set; }
    private int SelectedTermID;
    private List<SchoolTerm> Terms = new List<SchoolTerm>();
    private string SearchTerm = string.Empty;
    private string SelectedClassID; // Holds the selected class
    private List<Class> Classes = new List<Class>(); // Stores the list of classes
    // private bool IsCashInHand = false;
    private bool _isCashInHand;
   

    private bool IsCashInHand
    {
        get => _isCashInHand;
        set
        {
            _isCashInHand = value;
            if (_isCashInHand)
            {
                PaymentMethod = "Cash In Hand";
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {        
        try
        {
            isLoading = true;
            
            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");

            if (string.IsNullOrWhiteSpace(username))
            {
                NotificationService.ShowNotification("User Error", "User not logged in or session expired.", NotificationSeverity.Error);
                return;
            }

            var user = await StudentService.GetUserByUsernameAsync(username);
            if (user == null)
            {
                NotificationService.ShowNotification("User Error", "User not found.", NotificationSeverity.Error);
                return;
            }

            userId = user.UserID;

            Terms = await StudentService.GetAllSchoolTermsAsync();
            // Fetch classes
            Classes = await StudentService.GetsAllClassesAsync();

            PaymentMethods = await StudentService.GetPaymentMethodsAsync();

            // Existing initialization logic
            // var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            // var user = await StudentService.GetUserByUsernameAsync(username);
            // if (user != null)
            // {
            //     userId = user.UserID;
            // }

            Students = await StudentService.GetAllStudents();
            FilteredStudents = Students; // Initialize the filtered list with all students
            FeeTypes = await StudentService.GetFeeTypesAsync();
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Initialization Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnClassSelected(object value)
    {
        SelectedClassID = value?.ToString();

        // Filter students based on the selected class
        if (!string.IsNullOrEmpty(SelectedClassID))
        {
            FilteredStudents = Students.Where(s => s.ClassID == SelectedClassID).ToList();
            FeeTypes = await StudentService.GetFeeTypesByClassAsync(SelectedClassID);
        }
        else
        {
            FilteredStudents = Students; // Reset the list if no class is selected
        }

        // Clear any previously selected fee type and reset outstanding balance
        SelectedFeeTypeID = 0;
        OutstandingBalance = 0;
    }


    private void FilterStudents(object value)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            FilteredStudents = Students; // Reset filter if search is empty
        }
        else
        {
            FilteredStudents = Students
                .Where(s => s.FullName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private async Task OnStudentSelected(object args)
    {
        isLoading = true;  // Start loading
        StateHasChanged();

        try
        {
            AmountPaid = 0;
            OutstandingBalance = 0;
            PaymentMethod = string.Empty;
            Note = string.Empty;
            SelectedFeeTypeID = 0;  // Reset Fee Type

            // Fetch the selected student's fees
            var studentFees = await StudentService.GetStudentFeesByStudentIdAsync(SelectedStudentID);

            // Calculate the outstanding balance for the selected student and fee type
            var feeType = FeeTypes.FirstOrDefault(f => f.FeeTypeID == SelectedFeeTypeID);
            if (feeType != null)
            {
                TotalAmount = feeType.Amount;
                var studentFee = studentFees.FirstOrDefault(f => f.FeeTypeID == SelectedFeeTypeID);

                OutstandingBalance = studentFee != null ? (feeType.Amount - studentFee.AmountPaid) : feeType.Amount;
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ResetPaymentForm()
    {
        PaymentDate = DateTime.Now;
        SelectedTermID = 0;
        SelectedFeeTypeID = 0;
        AmountPaid = 0;
        Note = string.Empty;
        OutstandingBalance = 0;
        TotalAmountLeft = 0;
        IsCashInHand = false;
        PaymentMethod = null;
    }


    private async Task LoadClassFeeDetails(object value)
    {
        isLoading = true;  // Start loading
        StateHasChanged();
        try
        {
            SelectedFeeTypeID = Convert.ToInt32(value);
            if (SelectedStudentID > 0 && SelectedFeeTypeID > 0)
            {
                OutstandingBalance = await StudentService.GetOutstandingBalanceAsync(SelectedStudentID, SelectedFeeTypeID);
            }

            // Fetch fee details for the selected fee type
            var feeType = FeeTypes.FirstOrDefault(ft => ft.FeeTypeID == SelectedFeeTypeID);
            if (feeType != null)
            {
                // Use the fee amount from the FeeType for the total amount left
                TotalAmountLeft = feeType.Amount;

                // Update OutstandingBalance accordingly
                if (SelectedStudentID > 0)
                {
                    var studentFee = await StudentService.GetStudentFeeAsync(SelectedStudentID, SelectedFeeTypeID);
                    OutstandingBalance = studentFee?.AmountLeft ?? TotalAmountLeft;
                }
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    private async Task SavePayment()
    {
        isLoading = true;  // Start loading
        StateHasChanged();

        if (AmountPaid <= 0 || SelectedStudentID == 0 || SelectedFeeTypeID == 0)
        {
            NotificationService.ShowNotification("Validation Error", "All fields are required.", NotificationSeverity.Warning);
            return;
        }
        if (SelectedStudentID == 0 || SelectedTermID == 0 || SelectedFeeTypeID == 0 || AmountPaid <= 0)
        {
            NotificationService.ShowNotification("Validation Error", "Please complete all required fields.", NotificationSeverity.Warning);
            return;
        }

        if (IsCashInHand)
        {
            PaymentMethod = "Cash In Hand";
        }
        try
        {
            var payment = new StudentFee
                {
                    StudentID = SelectedStudentID,
                    FeeTypeID = SelectedFeeTypeID,
                    StudentName = Students.FirstOrDefault(s => s.StudentID == SelectedStudentID)?.FullName,
                    FeeTypeName = FeeTypes.FirstOrDefault(ft => ft.FeeTypeID == SelectedFeeTypeID)?.FeeTypeName,
                    ClassID = Students.FirstOrDefault(s => s.StudentID == SelectedStudentID)?.ClassID,
                    AmountPaid = AmountPaid,
                    AmountLeft = TotalAmountLeft - AmountPaid,
                    PaymentDate = PaymentDate,
                    PaymentMethod = PaymentMethod,
                    TermID = SelectedTermID,
                    Note = Note,
                    UserID = userId
                };

            // Save the student fee
            var success = await StudentService.SaveStudentFeeAsync(payment);
            if (success)
            {
                // Retrieve the BankID based on the selected payment method
                int bankId = await StudentService.GetBankIDAsync(PaymentMethod);
                if (bankId == 0) // Check if BankID is valid
                {
                    NotificationService.ShowNotification("Error", "Invalid payment method selected.", NotificationSeverity.Error);
                    return;
                }

                // Log the transaction
                await StudentService.LogsBankTransactionAsync(bankId, "Deposit", AmountPaid, "Success", null);
                NotificationService.ShowNotification("Success", "Payment saved successfully and logged.", NotificationSeverity.Success);
                // ✅ Reset form fields
                ResetPaymentForm();
            }
            else
            {
                NotificationService.ShowNotification("Error", "Failed to save payment.", NotificationSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void UpdateAmountLeft(decimal value)
    {
        isLoading = true;  // Start loading
        StateHasChanged();
        try
        {
        OutstandingBalance = TotalAmount - value;
        }
        catch (Exception ex)
        {
            NotificationService.ShowNotification("Error", $"Error: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    async void FeesDialog() => await OpenPaymentDialog();

    async void TransferOfFunds() => await OpenTransferOfFundsDialog();
    
    async void CashInHandsDialog() => await OpenCashInHandsDialog();
}