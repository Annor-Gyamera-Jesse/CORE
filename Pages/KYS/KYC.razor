@page "/kyc"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using CORE.Tool_Components.KYC
@inject AuthService AuthService
@inject NotificationMessageService Notify
@inherits KYCCodeBehind
<RadzenNotification />


<style>
    .radzen-fieldset {
        border-radius: 5px;
        padding: 10px;
    }

    .radzen-fieldset .rz-fieldset-legend {
        font-weight: bold;
    }

    .radzen-fieldset .row {
        padding: 0;
    }

    .radzen-fieldset .col-md-2.text-md-end {
        text-align: right;
    }

    .radzen-fieldset .col-md-3 .form-control {
        width: 100%;
    }

    .image-card {
        border: 1px solid #007bff;
        border-radius: 5px;
        padding: 10px;
        text-align: center;
        margin-bottom: 10px;
    }

    .image-card img {
        max-width: 100%;
        height: auto;
        border-radius: 5px;
    }
    /* PRINT STUDENT REPOR */
    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .right-align {
        margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
        height: 60px; /* Adjust the height to your preference */
        padding: 5px 15px; /* Reduce padding */
    }

        /* Additional styling if needed */
        .compact-header .rz-header-title {
            font-size: 18px; /* Make the title smaller */
        }
</style>


  <RadzenHeader title="REPORT GENERATING" class="header-container compact-header">
    <RadzenFieldset Text="EXPORT STUDENT EXAMS REPORT" class="right-align">
        <KYSTOOLCOMPONENT OnOpenStudentIdCardExportDialog="OnStudentIDCardExportDialog" />
</RadzenFieldset>
            </RadzenHeader>
            <br/>

<LoadingSpinner Visible="isLoading"/>
@if (!isLoading)
{
    <RadzenFieldset Icon="profile" Text="KYC" class="radzen-fieldset" style="@fieldsetStyle">
        <div class="row">
            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-2 text-md-end">
                        <RadzenLabel Text="Search Student" Component="txtsearchstudent" class="col-form-label float-right"/>                    
                    </div>
                    <div class="col-md-3">
                        <RadzenTextBox @bind-Value="searchName" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <RadzenButton Click="@SearchStudent" Text="Search" class="btn btn-primary" />
                    </div>
                </div>

                <!-- Student Details -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <RadzenLabel Text="First Name" />
                        <RadzenTextBox @bind-Value="student.StudentFirstName" class="form-control" ReadOnly="true" />

                        <RadzenLabel Text="Last Name" />
                        <RadzenTextBox @bind-Value="student.StudentLastName" class="form-control" ReadOnly="true" />

                        <RadzenLabel Text="Date of Birth" />
                        <RadzenDatePicker @bind-Value="student.StudentDateOfBirth" class="form-control" ReadOnly="true" />

                        <RadzenLabel Text="Gender" />
                        <RadzenDropDown @bind-Value="student.StudentGender" Data="genderOptions" class="form-control" ReadOnly="true" />

                        <RadzenLabel Text="Address" />
                        <RadzenTextBox @bind-Value="student.StudentAddress" class="form-control" ReadOnly="true" />

                        <RadzenLabel Text="Phone Number" />
                        <RadzenTextBox @bind-Value="student.StudentPhoneNumber" class="form-control" ReadOnly="true" />

                        <RadzenLabel Text="Email" />
                        <RadzenTextBox @bind-Value="student.StudentEmail" class="form-control" ReadOnly="true" />

                        <RadzenLabel Text="Class ID" />
                        <RadzenTextBox @bind-Value="student.ClassID" class="form-control" ReadOnly="true" />


                        <RadzenFieldset Text="STUDENT MEDICAL REPORT">
                            <RadzenLabel Text="Medical Report" />
                            <RadzenTextBox @bind-Value="student.StudentMedicalReport" class="form-control" ReadOnly="true" />
                        </RadzenFieldset>
                    </div>
                    
                    <div class="col-md-6">
                        <RadzenFieldset Text="IMAGE" Icon="image">
                        <!-- Image Card -->
                        <div class="image-card">
                        @if(isLoading)
                        {
                            <p>Data Fetching...</p>
                        }
                        else
                        {                                                
                            @if (student?.ImageData != null)
                            {
                                //<img src="@($"data:image/png;base64,{Convert.ToBase64String(student.ImageData)}")" alt="Student Image" />
                                        <RadzenImage src="@($"data:image/png;base64,{Convert.ToBase64String(student.ImageData)}")" alt="Student Image" />
                            }
                            else
                            {
                                <p>No Image Available</p>
                            }
                        }
                        </div>
                        </RadzenFieldset>

                    <RadzenFieldset Text="STUDENT EMERGENCY CONTACT">
                    <RadzenLabel Text="Guardian Full Name" />
                        <RadzenTextBox @bind-Value="student.GuardianFullName" class="form-control" ReadOnly="true" />

                    <RadzenLabel Text="Guardian Gender" />
                        <RadzenDropDown @bind-Value="student.GuardianGender" Data="genderOptions" class="form-control" ReadOnly="true" />

                    <RadzenLabel Text="Guardian House Address" />
                        <RadzenTextBox @bind-Value="student.GuardianHouseAddress" class="form-control" ReadOnly="true" />

                    <RadzenLabel Text="Guardian Work Address" />
                        <RadzenTextBox @bind-Value="student.GuardianWorkAddress" class="form-control" ReadOnly="true" />

                    <RadzenLabel Text="Guardian Email" />
                    <RadzenTextBox @bind-Value="student.GuardianEmail" class="form-control" ReadOnly="true"/>

                    <RadzenLabel Text="Guardian First Contact" />
                        <RadzenTextBox @bind-Value="student.GuardianFirstContact" class="form-control" ReadOnly="true" />

                    <RadzenLabel Text="Guardian Second Contact" />
                        <RadzenTextBox @bind-Value="student.GuardianSecondContact" class="form-control" ReadOnly="true" />
                   
                    </RadzenFieldset>

                </div>
            </div>
        </div>
    </div>
</RadzenFieldset>
}

@code {
    string searchName = "";
    string borderColor = "#007bff"; // Initial color
    Student student = new Student(); // Initialize the student object
    List<string> genderOptions = new List<string> { "M", "F", "O" }; // not in use specificaly like that it doesnt even help like that 
    public bool isLoading = false;
    string fieldsetStyle => $"border: 2px solid {borderColor};";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ChangeBorderColorBasedOnCondition();
    }

    void ChangeBorderColorBasedOnCondition()
    {
        // Example condition to change color
        if (!string.IsNullOrEmpty(searchName))
        {
            borderColor = "#ff5733"; // Change to a different color if searchName is not empty
        }
        else
        {
            borderColor = "#007bff"; // Default color
        }
    }

    async Task SearchStudent()
    {
        try
        {
            isLoading = true;
            if (!string.IsNullOrWhiteSpace(searchName))
            {
                student = await AuthService.GetStudentByNameAsync(searchName);
                if (student == null)
                {
                   
                }
                Notify.ShowNotification("", "FOUND", NotificationSeverity.Success);
            }            
        }
        catch(Exception ex)
        {
            Notify.ShowNotification("USER",$"NOT FOUND{ex.Message}",NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    async void OnStudentIDCardExportDialog() => await OpenStudentIDCardExportDialog();
    // async void OnOpenClassExamsExportDialog() => await OpenExamsPerClassExportDialog();
}
