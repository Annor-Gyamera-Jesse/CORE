@page "/studentprofile"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService authService
@using Radzen.Blazor

<RadzenFieldset Text="Student Profile">

<div class="container">
    <div class="row mb-3">
        <div class="col-md-6">
            <label for="studentName" class="form-label">Search by Name:</label>
            <div class="input-group">
                <RadzenTextBox @bind-Value="searchName" class="form-control" />
                <div class="input-group-append">
                    <RadzenButton Click="@SearchStudent" Text="Search" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>

    @if (selectedStudent != null)
    {
        <div class="row">
            <div class="col-md-4">
                    <RadzenFieldset Text="Image">
                <div class="card">
                   @* image card *@
                    <RadzenImage Path="@($"data:image/png;base64,{Convert.ToBase64String(selectedStudent.ImageData)}")" class="card-img-top" alt="Student Image" />
                    
                    </div>
                    </RadzenFieldset>
                    <br/>

                    <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@($"{selectedStudent.StudentFirstName} {selectedStudent.StudentLastName}")</h5>
                        <p class="card-text"><strong>Student ID:</strong> @selectedStudent.StudentID</p>
                        <p class="card-text"><strong>Date of Birth:</strong> @selectedStudent.StudentDateOfBirth.ToShortDateString()</p>
                        <p class="card-text"><strong>Gender:</strong> @selectedStudent.StudentGender</p>
                        <p class="card-text"><strong>Address:</strong> @selectedStudent.StudentAddress</p>
                        <p class="card-text"><strong>Phone Number:</strong> @selectedStudent.StudentPhoneNumber</p>
                        <p class="card-text"><strong>Email:</strong> @selectedStudent.StudentEmail</p>
                        <p class="card-text"><strong>Class ID:</strong> @selectedStudent.ClassID</p>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <RadzenFieldset Text="Emergency Contacts">
                <div class="card">
                    <div class="card-body">
                                <p class="card-text"><strong>Guardian FullName:</strong> @selectedStudent.GuardianFullName</p>
                                <p class="card-text"><strong>Guardian Gender:</strong> @selectedStudent.GuardianGender</p>
                                <p class="card-text"><strong>Guardian HouseAddress:</strong> @selectedStudent.GuardianHouseAddress</p>
                                <p class="card-text"><strong>Guardian WorkAddress:</strong> @selectedStudent.GuardianWorkAddress</p>
                                <p class="card-text"><strong>Guardian Email:</strong> @selectedStudent.GuardianEmail</p>
                                <p class="card-text"><strong>Guardian Contact 1:</strong> @selectedStudent.GuardianFirstContact</p>
                                <p class="card-text"><strong>Guardian Contact 2:</strong> @selectedStudent.GuardianSecondContact</p>
                    </div>
                </div>
                    </RadzenFieldset>
            </div>
        </div>
    }
    else
    {
        <p>No student found.</p>
    }
</div>
</RadzenFieldset>

@code {
    string searchName = "";
    Student selectedStudent;

    async Task SearchStudent()
    {
        // Call the service to search for the student by name
        var result = await authService.GetStudentByNameAsync(searchName);

        // Update the selectedStudent variable
        selectedStudent = result;
    }
}
