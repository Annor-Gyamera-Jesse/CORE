@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@inject AuthService authService
@inject DialogService DialogService

<RadzenNotification />

<LoadingSpinner Visible="isLoading" />
@if (!isLoading)
{
    <div class="flex gap-4 mb-3">
        <RadzenDropDown Data="@classIds" @bind-Value="selectedClass"
                        Placeholder="Filter by Class" Style="width:200px"
                        Change="@(args => ApplyFilters())" AllowClear="true" />

        <RadzenTextBox @bind-Value="searchTerm" Placeholder="Search by name..."
                       Style="width:250px" Change="@(args => ApplyFilters())" />
    </div>

    <RadzenGrid Data="@filteredStudents" TItem="Student" RowSelect="@SelectStudent"
                AllowPaging="true" PageSize="10">
        <Columns>
            <RadzenGridColumn TItem="Student" Property="StudentID" Title="ID" />
            <RadzenGridColumn TItem="Student" Property="StudentFirstName" Title="First Name" />
            <RadzenGridColumn TItem="Student" Property="StudentLastName" Title="Last Name" />
            <RadzenGridColumn TItem="Student" Property="StudentGender" Title="Gender" />
            <RadzenGridColumn TItem="Student" Property="ClassID" Title="Class" />
        </Columns>
    </RadzenGrid>

    <RadzenButton Text="Close" ButtonStyle="ButtonStyle.Danger"
                  Style="margin-top:10px" Click="() => DialogService.Close(null)" />
}

@code {
    List<Student> students = new();
    List<Student> filteredStudents = new();
    List<string> classIds = new();
    string selectedClass;
    string searchTerm = string.Empty;
    public bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            students = await authService.GetAllStudents();

            // collect unique classes
            classIds = students.Where(s => !string.IsNullOrEmpty(s.ClassID))
                               .Select(s => s.ClassID)
                               .Distinct()
                               .OrderBy(c => c)
                               .ToList();

            filteredStudents = new List<Student>(students);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching students: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    void ApplyFilters()
    {
        IEnumerable<Student> query = students;

        // filter by class
        if (!string.IsNullOrEmpty(selectedClass))
        {
            query = query.Where(s => s.ClassID == selectedClass);
        }

        // filter by name
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            string term = searchTerm.ToLower();
            query = query.Where(s => (s.StudentFirstName ?? "").ToLower().Contains(term) ||
                                     (s.StudentLastName ?? "").ToLower().Contains(term));
        }

        filteredStudents = query
            .OrderBy(s => s.StudentFirstName)
            .ThenBy(s => s.StudentLastName)
            .ToList();
    }

    void SelectStudent(Student student)
    {
        if (student != null)
        {
            DialogService.Close(student);
        }
    }
}