@page "/exams"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService authService
@using CORE.SERVICE.NOTIFICATION
@using CORE.Tool_Components
@using Radzen
@inject NotificationMessageService Notify
@using System.Globalization
@inject NotificationMessageService NotificationService
<RadzenNotification />
@inject IJSRuntime jsRuntime
@inherits ExamsCodeBehind

<style>
    /* PRINT STUDENT REPOR */
    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .right-align {
        margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
        height: 60px; /* Adjust the height to your preference */
        padding: 5px 15px; /* Reduce padding */
    }

        /* Additional styling if needed */
        .compact-header .rz-header-title {
            font-size: 18px; /* Make the title smaller */
        }
</style>


  <RadzenHeader title="REPORT GENERATING" class="header-container compact-header">
    <RadzenFieldset Text="EXPORT STUDENT EXAMS REPORT" class="right-align">
        <ExamsToolComponent OnOpenExamsExportDialog="OnOpenExamsExport" OnOpenClassExamsExportDialog="OnOpenClassExamsExportDialog" />
</RadzenFieldset>
            </RadzenHeader>
            <br/>
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <RadzenFieldset Text="EXAMS RESULT">
            <form @ref="examsForm" @onsubmit="@AddExam">
                <RadzenForm Data="@examModel">
                    <!-- General Information -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                          <RadzenField Property="SchoolCourse" Title="School Course">
                           <RadzenLabel Text="Course" />
                                <RadzenDropDown @bind-Value="@examModel.SchoolCourse" Data="@courseList"></RadzenDropDown>
                           </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="StudentName" Title="Student Name">
                                <RadzenLabel Text="Student Name" />
                                    <RadzenDropDown @bind-Value="@examModel.StudentID" Data="@studentList" TextProperty="FullName" ValueProperty="StudentID" />
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="ClassName" Title="Class Name">
                              <RadzenLabel Text="Class Name" />
                                    <RadzenDropDown @bind-Value="@examModel.ClassName" Data="@classList" Change="@OnClassChange"></RadzenDropDown>
                            </RadzenField>
                         </div>
                    </div>

                    <!-- Academic Details -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <RadzenField Property="AcademicYear" Title="Academic Year">
                                <RadzenLabel Text="Academic Year" />
                                <RadzenTextBox @bind-Value="@examModel.AcademicYear"></RadzenTextBox>
                            </RadzenField>
                        </div>
                        <div class="col-md-3">
                            <RadzenField Property="VacationDate" Title="Vacation Date">
                                <RadzenLabel Text="Vacation Date" />
                                <RadzenDatePicker @bind-Value="@examModel.VacationDate"></RadzenDatePicker>
                            </RadzenField>
                        </div>
                        <div class="col-md-3">
                          <RadzenField Property="PromotedTo" Title="Promoted To">
                           <RadzenLabel Text="Promoted To" />
                          <RadzenDropDown @bind-Value="@examModel.PromotedTo" Data="@classList" Placeholder="Select Class" Style="width: 100%" />
                          </RadzenField>
                        </div>
                    </div>

                    <!-- Examination Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <RadzenField Property="NumberOnRoll" Title="Number On Roll">
                                <RadzenLabel Text="Number On Roll" />
                                <RadzenNumeric @bind-Value="@examModel.NumberOnRoll"></RadzenNumeric>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="Term" Title="Term">
                                <RadzenLabel Text="Term" />
                                <RadzenTextBox @bind-Value="@examModel.Term"></RadzenTextBox>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="Position" Title="Position">
                                <RadzenLabel Text="Position" />
                                <RadzenTextBox @bind-Value="@examModel.Position"></RadzenTextBox>
                            </RadzenField>
                        </div>
                    </div>

                    <!-- Results Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <RadzenField Property="ClassScore" Title="Class Score">
                                <RadzenLabel Text="Class Score" />
                                <RadzenNumeric @bind-Value="@examModel.ClassScore"></RadzenNumeric>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="ExamsScore" Title="Exams Score">
                                <RadzenLabel Text="Exams Score" />
                                <RadzenNumeric @bind-Value="@examModel.ExamsScore"></RadzenNumeric>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="TotalScore" Title="Total Score">
                                <RadzenLabel Text="Total Score" />
                                <RadzenNumeric @bind-Value="@examModel.TotalScore"></RadzenNumeric>
                            </RadzenField>
                        </div>
                    </div>

                    <!-- Additional Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <RadzenField Property="SubjectsPositions" Title="Subjects Positions">
                                <RadzenLabel Text="Subjects Positions" />
                                <RadzenTextBox @bind-Value="@examModel.SubjectsPositions"></RadzenTextBox>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="Grade" Title="Grade">
                                <RadzenLabel Text="Grade" />
                                <RadzenTextBox @bind-Value="@examModel.Grade"></RadzenTextBox>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="TeachersRemarks" Title="Teachers Remarks">
                                <RadzenLabel Text="Teachers Remarks" />
                                <RadzenTextArea @bind-Value="@examModel.TeachersRemarks"></RadzenTextArea>
                            </RadzenField>
                        </div>
                    </div>

                    <!-- Conduct and Remarks -->
                    <div class="row mb-3">
                         <div class="col-md-3">
                            <RadzenField Property="NextTermsBegins" Title="NextTermsBegins">
                                    <RadzenLabel Text="Next Terms Begins" />
                                 <RadzenDatePicker @bind-Value="@examModel.NextTermsBegins"></RadzenDatePicker>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="Conduct" Title="Conduct">
                                <RadzenLabel Text="Conduct" />
                                <RadzenTextArea @bind-Value="@examModel.Conduct"></RadzenTextArea>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="HeadmasterRemark" Title="Headmaster Remark">
                                <RadzenLabel Text="Headmaster Remark" />
                                <RadzenTextArea @bind-Value="@examModel.HeadmasterRemark"></RadzenTextArea>
                            </RadzenField>
                        </div>
                    </div>

                    <!-- Signatures -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <RadzenField Property="TeachersSignature" Title="Teachers Signature">
                                <RadzenLabel Text="Teachers Signature" />
                                <RadzenTextBox @bind-Value="@examModel.TeachersSignature"></RadzenTextBox>
                            </RadzenField>
                        </div>
                        <div class="col-md-4">
                            <RadzenField Property="HeadMasterSignature" Title="Headmaster Signature">
                                <RadzenLabel Text="Headmaster Signature" />
                                <RadzenTextBox @bind-Value="@examModel.HeadMasterSignature"></RadzenTextBox>
                            </RadzenField>
                        </div>
                    </div>

                    <div class="text-right mt-3">
                        <RadzenButton Text="Add" Click="@AddExam"></RadzenButton>
                    </div>
                </RadzenForm>
            </form>
            </RadzenFieldset>
        </div>
        <!-- Right Section: Assessment Search List Box -->
        <div class="col-md-4">
            <RadzenFieldset Text="Assessment Search">
                <div class="mt-3">
                    <!-- RadzenDropDown for selecting class -->
                    <RadzenDropDown @bind-Value="selectedClass"
                                    Data="@classes"
                                    Placeholder="Select Class"
                                    Change="OnClassChanged"
                                    Style="width: 100%" />
                </div>

                <div class="mt-3">
                    <!-- RadzenDropDown for selecting student -->
                    <RadzenDropDown @bind-Value="selectedStudentName"
                                    Data="@students"
                                    TextProperty="FullName"
                                    ValueProperty="FullName"
                                    Placeholder="Select Student"
                                    Disabled="@(students == null || !students.Any())"
                                    Style="width: 100%" />

                </div>

                <div class="mt-3">
                    <!-- RadzenButton to trigger the search -->
                    <RadzenButton Text="Search"
                                  Click="SearchAssessment"
                                  Disabled="@(string.IsNullOrEmpty(selectedStudentName))" />

                </div>

                <div class="mt-3">
                    <!-- RadzenGrid to display assessment data -->
                    <div class="mt-3">
                        <!-- RadzenGrid to display assessment data -->
                        <RadzenGrid Data="@assessment" TItem="TeachersAssessment" AllowPaging="true" PageSize="10" ColumnWidth="200px" Style="overflow-x: auto;">
                            <Columns>
                                <RadzenGridColumn TItem="TeachersAssessment" Property="Course" Title="Course" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="StudentName" Title="Student Name" Width="250px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="ClassID" Title="Class ID" Width="150px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="TEST1" Title="Test 1" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="TEST2" Title="Test 2" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="GROUPWORK" Title="Group Work" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="HOMEWORK" Title="Homework" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="CLASSTEST" Title="Class Test" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="TOTAL_X" Title="Total" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="Y" Title="Y" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="X_Y" Title="X_Y" Width="120px" />
                                <RadzenGridColumn TItem="TeachersAssessment" Property="POSITION" Title="Subject Position" Width="120px" />                                
                            </Columns>
                        </RadzenGrid>
                    </div>

                </div>
            </RadzenFieldset>
        </div>



        <RadzenFieldset Text="VIEW">
        <div class="col-md-12 mt-4">
                <div style="max-height: 400px; overflow-y: auto;">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>StudentName</th>
                        <th>ClassName</th>
                        <th>AcademicYear</th>
                        <th>VacationDate</th> 
                        <th>NextTermsBegins</th>
                        <th>PromotedTo</th>
                        <th>NumberOnRoll</th>
                        <th>Term</th>
                        <th>Position</th>
                        <th>ClassScore 50%</th>
                        <th>ExamsScore 50%</th>
                        <th>TotalScore 100%</th>
                        <th>SubjectsPositions</th>
                        <th>Grade</th>
                        <th>TeachersRemarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in examResults)
                    {
                        <tr>
                            <td>@result.SchoolCourse</td>
                            <td>@result.StudentName</td>
                            <td>@result.ClassName</td>
                            <td>@result.AcademicYear</td>
                            <td>@result.VacationDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td>@result.NextTermsBegins?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td>@result.PromotedTo</td>
                            <td>@result.NumberOnRoll</td>
                            <td>@result.Term</td>
                            <td>@result.Position</td>
                            <td>@result.ClassScore</td>
                            <td>@result.ExamsScore</td>
                            <td>@result.TotalScore</td>
                            <td>@result.SubjectsPositions</td>
                            <td>@result.Grade</td>
                            <td>@result.TeachersRemarks</td>
                        </tr>
                    }
                </tbody>
            </table>            
            </div>
                <div class="text-right">
                    <RadzenButton Text="Upload" ButtonStyle="ButtonStyle.Success" Click="@UploadExams"></RadzenButton>
                </div>
            </div>
        </RadzenFieldset>
    </div>
</div>

@code {
    List<Exam> examResults = new List<Exam>();
    Exam examModel = new Exam();
    ElementReference examsForm;
    List<string> courseList = new List<string>();
    List<string> classList = new List<string>();
    List<Student> studentList = new List<Student>();
    [Inject]
    protected IJSRuntime JSRuntime { get; set; }
private string selectedClass;
private int? selectedStudent;
private IEnumerable<Student> students;
private IEnumerable<TeachersAssessment> assessment;    
private List<string> classes = new List<string>();
    private string selectedStudentName;
    private int userId;

    void AddExam()
    {
        var selectedStudent = studentList.FirstOrDefault(s => s.StudentID == examModel.StudentID);
        examModel.StudentName = selectedStudent?.FullName;
        examResults.Add(new Exam
            {
                SchoolCourse = examModel.SchoolCourse,
                StudentName = examModel.StudentName,
                ClassName = examModel.ClassName,
                AcademicYear = examModel.AcademicYear,
                VacationDate = examModel.VacationDate,
                NextTermsBegins = examModel.NextTermsBegins,
                PromotedTo = examModel.PromotedTo,
                NumberOnRoll = examModel.NumberOnRoll,
                Term = examModel.Term,
                Position = examModel.Position,
                ClassScore = examModel.ClassScore,
                ExamsScore = examModel.ExamsScore,
                TotalScore = examModel.TotalScore,
                SubjectsPositions = examModel.SubjectsPositions,
                Grade = examModel.Grade,
                TeachersRemarks = examModel.TeachersRemarks,
                Conduct = examModel.Conduct,
                HeadmasterRemark = examModel.HeadmasterRemark,
                SchoolInformation = examModel.SchoolInformation,
                TeachersSignature = examModel.TeachersSignature,
                HeadMasterSignature = examModel.HeadMasterSignature,
            });

        // Reset only specific properties, not the entire examModel so this fields are resertted after its added 
        examModel.ClassScore = 0;
        examModel.ExamsScore = 0;
        examModel.TotalScore = 0;
        examModel.Grade = "";
        examModel.SubjectsPositions = "";
        examModel.SchoolCourse = "";

        StateHasChanged();
    }


    async Task UploadExams()
    {
        // Get the UserID of the logged-in user
        var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
        var user = await authService.GetUserByUsernameAsync(username);
        int userId = 0;

        if (user != null)
        {
            userId = user.UserID;
        }

        // Upload each exam result and include the UserID
        foreach (var result in examResults)
        {
            result.UserID = userId;  // Assign UserID to the exam result

            var insertResult = await authService.InsertExamAsync(result, userId);

            if (insertResult > 0)
            {
                // Insertion successful
                Notify.ShowNotification("success", "Exam for user Upload successfully!", NotificationSeverity.Success);
            }
            else
            {
                // Insertion failed
                Notify.ShowNotification("Error", "Exam for user Upload failed!", NotificationSeverity.Warning);
            }
        }

        // Clear the examResults list after successful upload
        examResults.Clear();
        StateHasChanged();
    }


    // Method to handle class selection change
    async Task OnClassChange(object value)
    {
        var classId = value?.ToString();
        if (!string.IsNullOrEmpty(classId))
        {
            studentList = await authService.GetStudentsByClass(classId);
            StateHasChanged(); // Refresh the UI
        }
    }

    // Method to fetch students when a class is selected
    private async Task OnClassChanged(object value)
    {
        try
        {
            selectedClass = value?.ToString();

            if (!string.IsNullOrEmpty(selectedClass))
            {
                // Fetch students for the selected class
                students = (await authService.GetStudentsByClassInExams(selectedClass)).ToList();

                Console.WriteLine($"Class Selected: {selectedClass}");
                

                if (students.Any())
                {
                    foreach (var student in students)
                    {
                        // Console.WriteLine($"Student: {student.StudentID} - {student.FullName}");
                        // NotificationService.ShowNotification($"Student: {student.StudentID} - {student.FullName}", " ", NotificationSeverity.Warning);
                    }
                }
                else
                {
                    NotificationService.ShowNotification(" ", "No students found for the selected class.", NotificationSeverity.Info);
                    Console.WriteLine("No students found for the selected class.");
                }
            }
            else
            {
                students = new List<Student>(); // Ensure it's not null
                Console.WriteLine("No class selected.");
                NotificationService.ShowNotification("", "No class selected.", NotificationSeverity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching students: {ex.Message}");
            NotificationService.ShowNotification("Error", $" fetching students: {ex.Message}", NotificationSeverity.Error);
            students = new List<Student>(); // Ensure the UI does not break
        }

        StateHasChanged(); // Ensure UI updates
    }


    // Method to fetch assessment data when a student is selected
    private async Task SearchAssessment()
    {
        if (!string.IsNullOrEmpty(selectedStudentName))
        {
            Console.WriteLine($"Searching for assessments for student: {selectedStudentName}");
            var assessments = await authService.GetAssessmentByStudentAsync(selectedStudentName);
            assessment = assessments.ToList();
        }
        else
        {
            Console.WriteLine("No student selected.");
        }
    }

    async void OnOpenExamsExport() => await OpenExamsExportDialog();
    async void OnOpenClassExamsExportDialog() => await OpenExamsPerClassExportDialog();

    protected override async Task OnInitializedAsync()
    {
        var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
        var user = await authService.GetUserByUsernameAsync(username);
        if (user != null)
        {
            userId = user.UserID;
        }
        // Fetch data for dropdowns
        courseList = await authService.GetSchoolExamsCoursesAsync();
        classList = await authService.GetClassesAsync();
        classes = await authService.GetClassesAsync();
    }
}