<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Window" Title="School Report" Background="#FFFFFF">
    <Page.Resources>
        <Style TargetType="TextBox" x:Key="rTxt">
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10pt" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="Padding" Value="2,0,2,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsHitTestVisible" Value="false" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="auto" VerticalScrollBarVisibility="auto">
        <StackPanel Width="793.8" Height="1122.66">
            <Canvas>
                <!-- School Report Title -->
                <TextBox Margin="1,1" Width="719.2" Height="180.48" Padding="0" TextWrapping="NoWrap" Style="{StaticResource rTxt}" />
                <TextBox Margin="1,152.13" Width="719.2" Height="29.35" HorizontalAlignment="Center" VerticalAlignment="Center" Text="SCHOOL REPORT" FontSize="14pt" Foreground="#000000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Tahoma" FontWeight="Bold" Style="{StaticResource rTxt}" />

                <!-- Student Information -->
                <TextBox Margin="1,322.23" Width="256.15" Height="19.9" VerticalAlignment="Center" Text="Student Name: [Student Name]" FontSize="8pt" Foreground="#000000" VerticalContentAlignment="Center" FontFamily="Tahoma" Style="{StaticResource rTxt}" />
                <TextBox Margin="256.15,322.23" Width="190" Height="19.9" VerticalAlignment="Center" Text="Class: [Class]" FontSize="8pt" Foreground="#000000" VerticalContentAlignment="Center" FontFamily="Tahoma" Style="{StaticResource rTxt}" />
                <TextBox Margin="445.15,322.23" Width="123.85" Height="19.9" VerticalAlignment="Center" Text="Roll Number: [Roll Number]" FontSize="8pt" Foreground="#000000" VerticalContentAlignment="Center" FontFamily="Tahoma" Style="{StaticResource rTxt}" />
                <TextBox Margin="568,322.23" Width="152.2" Height="19.9" VerticalAlignment="Center" Text="Date: [Date]" FontSize="8pt" Foreground="#000000" VerticalContentAlignment="Center" FontFamily="Tahoma" Style="{StaticResource rTxt}" />

                <TextBox Margin="1,1" Width="719.2" Height="180.48" Padding="0" TextWrapping="NoWrap" Style="{StaticResource rTxt}">
                    <!-- Add academic performance information here -->
                </TextBox>

                <!-- Attendance -->
                <TextBox Margin="1,152.13" Width="719.2" Height="29.35" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Attendance" FontSize="14pt" Foreground="#000000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Tahoma" FontWeight="Bold" Style="{StaticResource rTxt}">
                    <!-- Add attendance information here -->
                </TextBox>

                <!-- Conduct/Character Remarks -->
                <TextBox Margin="1,322.23" Width="719.2" Height="29.35" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Conduct/Character Remarks" FontSize="14pt" Foreground="#000000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Tahoma" FontWeight="Bold" Style="{StaticResource rTxt}">

                    <!-- Teacher and Headmaster Signatures -->
                <TextBox Margin="1,1019.71" Width="719.2" Height="29.35" Background="#F5F5F5" Padding="0" TextWrapping="NoWrap" Style="{StaticResource rTxt}" />
                <TextBox Margin="596.35,1019.71" Width="114.4" Height="29.35" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Signatures" FontSize="8pt" Foreground="#000000" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontFamily="Tahoma" Style="{StaticResource rTxt}" />
                <TextBox Margin="10.45,1019.71" Width="256.15" Height="29.35" VerticalAlignment="Center" Text="Teacher Signature: ___________________" FontSize="8pt" Foreground="#000000" VerticalContentAlignment="Center" FontFamily="Tahoma" Style="{StaticResource rTxt}" />
                <TextBox Margin="293.95,1019.71" Width="218.35" Height="29.35" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Headmaster Signature: ___________________" FontSize="8pt" Foreground="#0000FF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="Tahoma" TextDecorations="Underline" Style="{StaticResource rTxt}" />

                <!-- Report Generation Information -->
                <TextBox Margin="1,-36.8" Width="719.2" Height="21" Padding="0" TextWrapping="NoWrap" Style="{StaticResource rTxt}" />
                <TextBox Margin="1,-36.8" Width="190" Height="21" Text="Generated by: [Reporting System]" Foreground="#000000" Style="{StaticResource rTxt}" />
                <TextBox Margin="10.45,-36.8" Width="519.75" Height="21" VerticalAlignment="Center" Text="Printed on: [Print Date]" FontSize="8pt" Foreground="#000000" VerticalContentAlignment="Center" FontFamily="Tahoma" Style="{StaticResource rTxt}" />
            </Canvas>
        </StackPanel>
    </ScrollViewer>
</Page>
