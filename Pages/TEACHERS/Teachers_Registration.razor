@page "/core/pages/teachers/teachersregistration"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using System.ComponentModel.DataAnnotations
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NotificationMessageService Notify
<RadzenNotification />

<style>
    form .row {
    margin-bottom: 16px;
    margin-top: 10px;
    }

    .rz-fieldset-content {
    padding: 0;
    }

    .form-label {
    padding-top: 8px;
    }

    .form-control {
    margin-bottom: 8px;
    }
</style>
<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <RadzenFieldset Text="Teachers Registration">
        <div class="row">
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Teacher FirstName" Component="textteachername" />
            </div>
            <div class="col-md-3">
                <RadzenTextBox class="form-control form-control-sm" @bind-Value="@teachersRegistration.TeacherFirstName" />
            </div>

            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Teacher LastName" Component="textteacherlastname" />
            </div>
            <div class="col-md-3">
                <RadzenTextBox class="form-control form-control-sm" @bind-Value="@teachersRegistration.TeacherLastName" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Date of Birth" Component="textteacherdob" />
            </div>
            <div class="col-md-3">
                <RadzenDatePicker @bind-Value="@teachersRegistration.TeacherDateOfBirth" Format="d" Placeholder="Select Date of Birth" />
            </div>

            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Teacher Gender" Component="textteachergender" />
            </div>
            <div class="col-md-3">
                <RadzenTextBox class="form-control form-control-sm" @bind-Value="@teachersRegistration.TeacherGender" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Teacher Address" Component="textteacheraddress" />
            </div>
            <div class="col-md-3">
                <RadzenTextBox class="form-control form-control-sm" @bind-Value="@teachersRegistration.TeacherAddress" />
            </div>

            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Teacher Phone Number" Component="textteacherphonenumber" />
            </div>
            <div class="col-md-3">
                <RadzenTextBox class="form-control form-control-sm" @bind-Value="@teachersRegistration.TeacherPhoneNumber" />
            </div>

            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Upload Image" Component="fileInput" />
            </div>
            <div class="col-md-3">
                <InputFile id="teacherImage" OnChange="HandleFileChange" key="@inputFileKey" />
            </div>

            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Teacher Email" Component="textteacheremail" />
            </div>
            <div class="col-md-3">
                <RadzenTextBox class="form-control form-control-sm" @bind-Value="@teachersRegistration.TeacherEmail" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Teacher ID" Component="textteacherid" />
            </div>
            <div class="col-md-3">
                <RadzenTextBox class="form-control form-control-sm" Value="@newTeacherId.ToString()" ReadOnly="true" />
            </div>
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Date Hired" Component="textteacherid" />
            </div>
            <div class="col-md-3">
                <RadzenDatePicker class="form-control form-control-sm" @bind-Value="@teachersRegistration.DateHired" />
            </div>
        </div>

        <RadzenFieldset Text="SSNIT">
            <div class="row">
                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="SSNIT" />
                </div>
                <div class="col-md-3">
                    <RadzenDropDown @bind-Value="@teachersRegistration.SSNIT"
                    Data="@(new List<string> { "Y", "N" })"
                    Placeholder="Do You Have SSNIT"
                    Class="form-control form-control-sm" />
                </div>

                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="Basic Salary" />
                </div>
                <div class="col-md-3">
                    <RadzenNumeric @bind-Value="@teachersRegistration.BasicSalary"
                    Class="form-control form-control-sm"
                    Change="@((decimal value) => CalculateSSNITTier2(value))" />

                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="PAYE" />
                    </div>
                    <div class="col-md-3">
                        <RadzenNumeric @bind-Value="@teachersRegistration.PAYE"
                        Class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="SSNIT Tier 2" />
                    </div>
                    <div class="col-md-3">
                        <RadzenNumeric @bind-Value="@teachersRegistration.SSNITTIER2"
                        Class="form-control form-control-sm"
                        ReadOnly="true" />
                    </div>
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="SSNIT Number" />
                    </div>
                    <div class="col-md-4">
                        <RadzenTextBox @bind-Value="@teachersRegistration.SSNITNumber" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2 text-md-end form-label">
                        <RadzenLabel Text="PMT CAT" />
                    </div>
                    <div class="col-md-3">
                        <RadzenDropDown @bind-Value="selectedCategoryId" Data="@paymentCategories"
                        TextProperty="CategoryName" ValueProperty="CategoryID"
                        Class="w-full border-gray-300 rounded-lg p-2" Placeholder="Select Payment Category" />
                    </div>
                </div>
            </div>
        </RadzenFieldset>

        <RadzenFieldset Text="Account Details">
            <div class="row">
                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="Voters ID" />
                </div>
                <div class="col-md-3">
                    <RadzenTextBox @bind-Value="@teachersRegistration.VotersID"                                
                    Placeholder="Voters ID"
                    Class="form-control form-control-sm" />
                </div>

                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="Health Insurance" />
                </div>
                <div class="col-md-3">
                    <RadzenTextBox @bind-Value="@teachersRegistration.HealthInsurance"                                
                    Placeholder="Health Insurance"
                    Class="form-control form-control-sm" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="Ghana Card" />
                </div>
                <div class="col-md-3">
                    <RadzenTextBox @bind-Value="@teachersRegistration.GhanaCard"                                
                    Placeholder="Ghana Card Number"
                    Class="form-control form-control-sm" />
                </div>

                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="Bank" />
                </div>
                <div class="col-md-3">
                    <RadzenDropDown @bind-Value="@teachersRegistration.Bank"
                    Data="@Banks"
                    Placeholder="Select Bank"
                    Class="form-control form-control-sm" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="Account Number" />
                </div>
                <div class="col-md-3">
                    <RadzenTextBox class="form-control form-control-sm"
                    @bind-Value="@teachersRegistration.AccountNumber" />
                </div>

                <div class="col-md-3 text-md-end form-label">
                    <RadzenLabel Text="Remarks" />
                </div>
                <div class="col-md-3">
                    <RadzenTextBox class="form-control form-control-sm"
                    @bind-Value="@teachersRegistration.Remarks" />
                </div>
            </div>
        </RadzenFieldset>
        <div class="row mt-2">
            <div class="col-md-3">
                <RadzenButton Text="Submit" Icon="check" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Click="@SubmitForm" Style="margin-bottom: 10px; width: 130px; padding-right:15px" />
            </div>
            <div class="col-md-3">
                <RadzenButton Text="New" Icon="add" ButtonStyle="ButtonStyle.Info" Click="@ResetForm" Style="margin-bottom: 10px; width: 130px; padding-right:15px" />
            </div>
        </div>
    </RadzenFieldset>
}

@code {
    TeachersRegistration teachersRegistration = new TeachersRegistration();
    List<string> Banks = new List<string>();
    byte[] imageData;
    int newTeacherId;
    private IBrowserFile selectedFile;
    private int inputFileKey = 0;
    private List<PaymentCategory> paymentCategories = new();
    private int selectedCategoryId;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            Banks = await authService.GetPaymentMethodsAsync();
            paymentCategories = await authService.GetPaymentCategoriesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private Task CalculateSSNITTier2(decimal newSalary)
    {
        teachersRegistration.BasicSalary = newSalary;
        teachersRegistration.SSNITTIER2 = newSalary * 0.05m;
        return Task.CompletedTask; // Ensures async compatibility
    }


    async Task SubmitForm()
    {
        try
        {
            isLoading = true;
            if (IsValid(teachersRegistration))
            {
                if (selectedFile != null)
                {
                    using (var stream = selectedFile.OpenReadStream())
                    {
                        using (var memoryStream = new MemoryStream())
                        {
                            await stream.CopyToAsync(memoryStream);
                            imageData = memoryStream.ToArray();
                        }
                    }

                    teachersRegistration.ImageData = imageData;
                }

                // Set the CategoryName based on the selectedCategoryId
                var selectedCategory = paymentCategories.FirstOrDefault(c => c.CategoryID == selectedCategoryId);
                teachersRegistration.CategoryName = selectedCategory?.CategoryName; // This will be null if not found

                // Call the service to add the teacher
                newTeacherId = await authService.AddTeachersAsync(teachersRegistration);

                if (newTeacherId > 0)
                {
                    // Notify success
                    Notify.ShowNotification("", "Teacher successfully registered.", NotificationSeverity.Success);
                }
                else
                {
                    // Notify failure
                    Notify.ShowNotification("Error", "Failed to register the teacher. Please try again.", NotificationSeverity.Warning);
                }
            }
        }
        catch (Exception ex)
        {
            // Notify error with exception message
            Notify.ShowNotification("Error", $"An error occurred: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    bool IsValid(object obj)
    {
        // Validate the object using DataAnnotations
        var validationContext = new ValidationContext(obj, null, null);
        var validationResults = new List<ValidationResult>();
        return Validator.TryValidateObject(obj, validationContext, validationResults, true);
    }

    private void HandleFileChange(InputFileChangeEventArgs e)
    {
        try
        {
            isLoading = true;
            // Check if the file is not null and has a valid size
            if (e.File != null && e.File.Size > 0)
            {
                // Read the file into a byte array
                using (var stream = e.File.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024)) // 2 MB limit
                {
                    using (var memoryStream = new MemoryStream())
                    {
                        stream.CopyTo(memoryStream);
                        imageData = memoryStream.ToArray();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"An error occurred while uploading the file: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }



        // Handle the file change event
       // selectedFile = e.File;
    }

    void ResetForm()
    {
        try
        {
            isLoading = true;
            // Create a new instance of the TeachersRegistration class to clear all fields
            teachersRegistration = new TeachersRegistration();

            // Reset other variables as needed
            selectedFile = null;
            imageData = null;
            newTeacherId = 0;
            Notify.ShowNotification("", "FORM RESET", NotificationSeverity.Info);

            // Create a new instance of InputFile to replace the existing one
            inputFileKey++;
        }
        catch
        {
            Notify.ShowNotification("", "Error reseting", NotificationSeverity.Error);   
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }

    }
}
