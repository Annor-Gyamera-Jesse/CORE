@page "/teacherslist"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <RadzenGrid @ref="@Grid" Data="@AllTeachers" TItem="TeachersRegistration"
                AllowFiltering="true" AllowPaging="true" PageSize="100"
                AllowSorting="true" AllowColumnResize="true"
                Editable="true" EditMode="DataGridEditMode.Single"
                RowUpdate="@OnUpdateRow">

        <Columns>
            <RadzenGridColumn TItem="TeachersRegistration" Property="TeacherFirstName" Title="Teacher`s FirstName" />
            <RadzenGridColumn TItem="TeachersRegistration" Property="TeacherLastName" Title="Teacher`s LastName" />
            <RadzenGridColumn TItem="TeachersRegistration" Property="TeacherGender" Title="Gender" />
            <RadzenGridColumn TItem="TeachersRegistration" Property="TeacherAddress" Title="Address" />
            <RadzenGridColumn TItem="TeachersRegistration" Property="TeacherPhoneNumber" Title="PhoneNumber" />
            <RadzenGridColumn TItem="TeachersRegistration" Property="TeacherEmail" Title="Email" />
            <RadzenGridColumn TItem="TeachersRegistration" Property="TeacherID" Title="Teacher`s SysID" />

            <RadzenGridColumn TItem="TeachersRegistration" Property="EmploymentStatus" Title="Employment Status">
                <EditTemplate Context="teacher">
                    <RadzenDropDown @bind-Value="teacher.EmploymentStatus" Data="@EmploymentStatuses" />
                </EditTemplate>
            </RadzenGridColumn>

            <RadzenGridColumn TItem="TeachersRegistration" Context="data" Width="80px">
                <Template Context="data">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.Small" Click="@(() => Grid.EditRow(data))" />
                </Template>
                <EditTemplate Context="data">
                    <RadzenButton Icon="save" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@(() => Grid.UpdateRow(data))" />
                    <RadzenButton Icon="cancel" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Click="@(() => Grid.CancelEditRow(data))" />
                </EditTemplate>
            </RadzenGridColumn>
        </Columns>
    </RadzenGrid>
}

@code {
    RadzenGrid<TeachersRegistration> Grid;
    List<TeachersRegistration> AllTeachers = new();
    List<string> EmploymentStatuses = new() { "Active", "Suspended", "Terminated", "Leave" };
    private bool isLoading = false;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            var user = await authService.GetUserByUsernameAsync(username);
            currentUserId = user?.UserID ?? 0;

            AllTeachers = await authService.GetAllSchoolTeachersAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnUpdateRow(TeachersRegistration teacher)
    {
        try
        {
            await authService.UpdateEmploymentStatusAsync(teacher.TeacherID, teacher.EmploymentStatus, currentUserId);
            Notify.ShowNotification("Updated.", "Employment status updated successfully", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating EmploymentStatus: {ex.Message}");
        }
    }
}