@page "/teacherattendance"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService AuthService
@inject NotificationMessageService Notify
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using Radzen.Blazor

<style>
    .warning-message {
        color: red;
        font-weight: bold;
        margin-top: 10px;
    }
</style>

<div class="row">
    <div class="col-md-4">
        <RadzenFieldset Text="Teachers Name">
        <RadzenListBox @bind-Value="selectedTeacher" AllowFiltering="true" AllowVirtualization="true"
                       Data="@teachers" TextProperty="FullName" ValueProperty="TeacherID"
                       Style="width: 100%; height: 300px;" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                       Change="@(args => OnTeacherSelectionChange((int)args))">
        </RadzenListBox>
        </RadzenFieldset>
    </div>

    <div class="col-md-8">
        <form @ref="attendanceForm" @onsubmit="@SubmitAttendance">
            <RadzenForm Data="@attendanceModel">
                <RadzenField Property="SelectedTeacher" Title="Selected Teacher">
                    <RadzenTextBox @bind-Value="@attendanceModel.SelectedTeacher" ReadOnly="true"></RadzenTextBox>
                </RadzenField>

                <RadzenField Property="SelectedDate" Title="Selected Date">
                    <RadzenDatePicker @bind-Value="@attendanceModel.SelectedDate" ReadOnly="true"/>
                </RadzenField>

                <RadzenLabel Text="Clock IN"/>
                <RadzenField Property="IsClockedIn" Title="Clocked In">
                    <RadzenSwitch @bind-Value="@attendanceModel.IsClockedIn"></RadzenSwitch>
                </RadzenField>

                <div class="text-right">
                    <RadzenButton Text="Submit Attendance" Click="@SubmitAttendance" Disabled="!attendanceModel.IsClockedIn"></RadzenButton>
                    @if (!attendanceModel.IsClockedIn)
                    {
                        <div class="warning-message">Please turn on the switch before submitting.</div>
                    }
                </div>
            </RadzenForm>
        </form>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Teacher Name</th>
          @*   <th>Teacher Last Name</th> *@
            <th>Enable Switch</th>
            <th>Clock In</th>
            @* <th>Clock Out</th> *@
        </tr>
    </thead>
    <tbody>
        @foreach (var record in attendanceRecords)
        {
            <tr>
                <td>@record.TeacherFirstName</td>
               @*  <td>@record.TeacherLastName</td> *@
                <td>@record.EnableSwitch</td>
                <td>@record.ClockIN</td>
                @* <td>@record.ClockOUT</td> *@
            </tr>
        }
    </tbody>
</table>

@code {
    List<TeachersRegistration> teachers;
    List<TeacherAttendance> attendanceRecords = new List<TeacherAttendance>();
    AttendanceModel attendanceModel = new AttendanceModel();
    int selectedTeacher;
    ElementReference attendanceForm;

    // [Inject]
    // protected IJSRuntime JSRuntime { get; set; }

    protected override async Task OnInitializedAsync()
    {
        teachers = await AuthService.GetTeachersAsync();
    }

    void OnTeacherSelectionChange(int selectedValue)
    {
        if (selectedValue > 0)
        {
            var selectedTeacher = teachers.FirstOrDefault(t => t.TeacherID == selectedValue);
            if (selectedTeacher != null)
            {
                attendanceModel.SelectedTeacher = $"{selectedTeacher.TeacherFirstName} {selectedTeacher.TeacherLastName}";
            }
        }
    }

    async Task SubmitAttendance()
    {
        var newRecord = new TeacherAttendance
            {
                TeacherFirstName = attendanceModel.SelectedTeacher,
                TeacherLastName = "",
                EnableSwitch = attendanceModel.IsClockedIn,
                ClockIN = attendanceModel.SelectedDate,
                // ClockOUT = DateTime.Now
            };

        bool saved = await AuthService.SaveTeachersAttendanceAsync(newRecord);

        if (saved)
        {
            attendanceRecords.Add(newRecord);
            // Console.WriteLine($"Teacher: {newRecord.TeacherFirstName}, Date: {newRecord.ClockIN}, Clocked In: {newRecord.EnableSwitch}");


            attendanceModel = new AttendanceModel();
           

            StateHasChanged();
            // Show success message using JavaScript Interop
            // await JSRuntime.InvokeVoidAsync("alert", "Attendance saved successfully!");
            Notify.ShowNotification($"Teacher", "{newRecord.TeacherFirstName}, Date: {newRecord.ClockIN}, Clocked In: {newRecord.EnableSwitch}", NotificationSeverity.Success);
        }
        else
        {
            // Show error message using JavaScript Interop
            // await JSRuntime.InvokeVoidAsync("alert", "Failed to save attendance.");
            Notify.ShowNotification("ALERT", "Failed to save attendance.", NotificationSeverity.Error);
        }
    }
    

    public class AttendanceModel
    {
        public string SelectedTeacher { get; set; }
        public DateTime SelectedDate { get; set; } = DateTime.Now;
        public bool IsClockedIn { get; set; }
    }
}
