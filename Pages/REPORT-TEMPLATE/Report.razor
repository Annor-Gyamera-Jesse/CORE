@using CORE.Pages.REPORT_TEMPLATE.Models
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment hostingEnvironment
@using CORE.SERVICE

<RadzenGrid TItem="ReportViewPage" Data="@reportPages">
