@page "/teacher-tasks"
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService TeachersTaskService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
@using CORE.MODEL
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using System.Timers
@using CORE.Tool_Components
@inherits TeachersTask_Page_Codebehind
<RadzenNotification />

<style>
    .container {
        margin-top: 3rem; /* Reduced top margin to bring up the container */
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .card-spacing {
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
        padding: 1.5rem;
        border: 1px solid #e0e0e0;
        width: 80%; /* Expand container width */
    }

    .card-header {
        background-color: #007bff;
        color: #ffffff;
        padding: 1rem;
        border-radius: 12px 12px 0 0;
        font-size: 1.25rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-control {
        width: 100%;
        border-radius: 8px;
        border: 1px solid #ced4da;
        padding: 0.5rem;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 0.2rem rgba(38, 143, 255, 0.25);
        }

    .table th, .table td {
        vertical-align: middle;
        padding: 1rem;
    }

    .status-active {
        color: #28a745;
        font-weight: bold;
    }

    .status-inactive {
        color: #dc3545;
        font-weight: bold;
    }

    .margin-bottom {
        margin-bottom: 2rem; /* Add space between cards */
    }

    .right-panel {
        position: absolute;
        top: 50px;
        right: 20px;
        width: 250px;
        height: auto;
        border-radius: 8px;
    }

</style>


<LoadingSpinner Visible="isLoading"/>
@if (!isLoading)
{
    <div class="container">
        <div class="row">
            <div class="col-md-12 margin-bottom">
                <div class="card-spacing">
                    <div class="card-header">
                        Teacher Task Management
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            @* will make this a dropdown *@
                            <RadzenLabel Text="Teacher's Name" />
                            <RadzenTextBox @bind-Value="task.TeachersName" class="form-control" />
                        </div>
                        <div class="form-group">
                            <RadzenLabel Text="Teacher Task" />
                            <RadzenTextBox @bind-Value="task.TeacherTask" class="form-control" />
                        </div>
                        <div class="form-group">
                            <RadzenLabel Text="Enable" />
                            <RadzenCheckBox @bind-Value="task.SwitchBar" />
                        </div>
                        <div class="form-group">
                            <RadzenLabel Text="Start Date" />
                            <RadzenDatePicker @bind-Value="task.StartDate" class="form-control" />
                        </div>
                        <div class="form-group">
                            <RadzenLabel Text="End Date" />
                            <RadzenDatePicker @bind-Value="task.EndDate" class="form-control" />
                        </div>
                        <div class="form-group">
                            <RadzenLabel Text="Status" />
                            <RadzenDropDown @bind-Value="task.Status" Data="@(Enum.GetValues(typeof(MODEL.TaskStatus)))" class="form-control" />
                        </div>
                        <div class="d-flex justify-content-end">
                            <RadzenButton Text="Save" Click="SaveTask" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" />
                            <RadzenButton Text="Reset" Click="ResetForm" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="card-spacing">
                    <div class="card-header">
                        Task List
                    </div>
                    <div class="card-body">
                        <RadzenGrid Data="@tasks" TItem="TeachersTask" RowSelect="@OnRowSelect" class="table">
                            <Columns>
                                <RadzenGridColumn TItem="TeachersTask" Property="TeachersName" Title="Teacher's Name" />
                                <RadzenGridColumn TItem="TeachersTask" Property="TeacherTask" Title="Task" />
                                <RadzenGridColumn TItem="TeachersTask" Property="StartDate" Title="Start Date" />
                                <RadzenGridColumn TItem="TeachersTask" Property="EndDate" Title="End Date" />
                                <RadzenGridColumn TItem="TeachersTask" Property="Status" Title="Status" />
                                <RadzenGridColumn TItem="TeachersTask" Title="Enable">
                                    <Template Context="task">
                                        <span class="@(task.SwitchBar ? "status-active" : "status-inactive")">
                                            @(task.SwitchBar ? "Active" : "Inactive")
                                        </span>
                                    </Template>
                                </RadzenGridColumn>
                                <RadzenGridColumn TItem="TeachersTask">
                                    <Template Context="task">
                                        <div class="action-buttons">
                                            <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Click="@(args => EditTask(task))" />
                                            <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Click="@(args => DeleteTask(task.TeacherTaskID))" />
                                        </div>
                                    </Template>
                                </RadzenGridColumn>
                            </Columns>
                        </RadzenGrid>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div class="right-panel">
    <TeacherTimeTableToolPanel OnNoticeBoard="NoticeBoard" OnManageTeachersTimeTable="TeachersTimeTable" OnTeacherTimeTable="TeacherTimeTable" />
</div>

@code {
    private List<TeachersTask> tasks = new List<TeachersTask>();
    private TeachersTask task = new TeachersTask();
    private List<UserRoleViewModel> users = new List<UserRoleViewModel>();
    private Timer timer;
    public bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            tasks = (await TeachersTaskService.GetAllTasksAsync()).ToList();
            users = (await TeachersTaskService.GetUsersAsync()).ToList();
            await UpdateTaskStatuses();
            SetTimer();
        }
        catch(Exception ex)
        {

        }
        finally
        {
            isLoading = false;
        }
    }

    async void TeachersTimeTable()
    {
        await OpenManageTeachersTimeTable();
    }

    async void NoticeBoard()
    {
        await OpenOnNoticeBoard();
    }

    async void TeacherTimeTable()
    {
        await OpenTeacherTimeTable();
    }

    private void SetTimer()
    {
        timer = new Timer(86400000); // 24 hours in milliseconds
        timer.Elapsed += async (sender, e) => await UpdateTaskStatuses();
        timer.Start();
    }

    private async Task UpdateTaskStatuses()
    {
        try
        {
            isLoading = true;
            foreach (var task in tasks)
            {
                if (task.EndDate < DateTime.Today)
                {
                    task.Status = MODEL.TaskStatus.Ended; //TaskStatus has an Ended status
                    task.SwitchBar = false;
                    await TeachersTaskService.UpdateTaskAsync(task);
                }
            }

            tasks = (await TeachersTaskService.GetAllTasksAsync()).ToList();
            InvokeAsync(StateHasChanged); // Update the UI
            Notify.ShowNotification("Updated", "Successfully", NotificationSeverity.Success);
        }
        catch(Exception ex)
        {
            Notify.ShowNotification("", $"{ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }

    }

    private async Task SaveTask()
    {
        var userIDString = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userID");

        if (int.TryParse(userIDString, out int userID))
        {
            task.UserID = userID;

            try
            {
                isLoading = true;
                if (task.TeacherTaskID == 0)
                {
                    await TeachersTaskService.AddTaskAsync(task);
                    Notify.ShowNotification("Success", "Task added successfully!", NotificationSeverity.Success);
                }
                else
                {
                    await TeachersTaskService.UpdateTaskAsync(task);
                    Notify.ShowNotification("Success", "Task updated successfully!", NotificationSeverity.Success);
                }
                tasks = (await TeachersTaskService.GetAllTasksAsync()).ToList();
                ResetForm();
            }
            catch (Exception ex)
            {
                Notify.ShowNotification("Error", $"Failed to save task. {ex.Message}", NotificationSeverity.Error);
            }
            finally
            {
                isLoading = false;
            }
        }
        else
        {
            Notify.ShowNotification("Error", "Failed to retrieve valid user ID from session.", NotificationSeverity.Error);
        }
    }

    private void ResetForm()
    {
        task = new TeachersTask();
    }

    private void EditTask(TeachersTask selectedTask)
    {
        task = selectedTask;
    }

    private async Task DeleteTask(int taskId)
    {
        try
        {
            await TeachersTaskService.DeleteTaskAsync(taskId);
            tasks = (await TeachersTaskService.GetAllTasksAsync()).ToList();
            Notify.ShowNotification("Success", "Task deleted successfully!", NotificationSeverity.Success);
        }
        catch(Exception ex)
        {
            Notify.ShowNotification("", "Deleted Successfully", NotificationSeverity.Success);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnRowSelect(TeachersTask selectedTask)
    {
        task = selectedTask;
    }
}
