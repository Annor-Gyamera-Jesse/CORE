@page "/manage-schedule"
@inject AuthService scheduleService
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using static CORE.MODEL.Teachers_Time_Table
@inject NotificationMessageService Notify

<h3>Manage Schedule</h3>

<LoadingSpinner Visible="isLoading"/>
@if (!isLoading)
{
    @if (isEditing)
    {
        <RadzenTemplateForm Data="@EditingSchedule" TItem="Schedule" Submit="@OnSubmit">
            <ChildContent>
            <RadzenFieldset>
                <RadzenLabel Text="Course" />
                <RadzenDropDown @bind-Value="EditingSchedule.SCID" 
                                Data="@schoolCourses"
                                TextProperty="SchoolCourseName"
                                ValueProperty="SCID" 
                                Style="width: 100%" />

                <RadzenLabel Text="Class ID" />
                <RadzenDropDown @bind-Value="EditingSchedule.ClassID" 
                                Data="@classIDs" 
                                Style="width: 100%" />

                <RadzenLabel Text="Start Time" />
                <RadzenTimePicker Value="@EditingSchedule.StartTime" 
                                  ValueChange="@((TimeSpan? value) => EditingSchedule.StartTime = value)" 
                                  Style="width: 100%" />

                <RadzenLabel Text="End Time" />
                <RadzenTimePicker Value="@EditingSchedule.EndTime" 
                                  ValueChange="@((TimeSpan? value) => EditingSchedule.EndTime = value)" 
                                  Style="width: 100%" />

                <RadzenLabel Text="Subject Start Time" />
                <RadzenDatePicker TValue="DateTime?"
                                  Value="@EditingSchedule.SubjectStartTime"
                                  ValueChange="@((DateTime? value) => EditingSchedule.SubjectStartTime = value.GetValueOrDefault())"
                                  Style="width: 100%" />

                <RadzenLabel Text="Subject End Time" />
                <RadzenDatePicker TValue="DateTime?"
                                  Value="@EditingSchedule.SubjectEndTime"
                                  ValueChange="@((DateTime? value) => EditingSchedule.SubjectEndTime = value.GetValueOrDefault())"
                                  Style="width: 100%" />

                <RadzenLabel Text="Day Name" />
                <RadzenDropDown @bind-Value="EditingSchedule.DayID" 
                                Data="@days"
                                TextProperty="DayName"
                                ValueProperty="DayID"
                                Style="width: 100%" />
            </RadzenFieldset>
            <div>
                <RadzenButton Text="Save" ButtonType="ButtonType.Submit" Style="margin-top: 20px;" />
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Secondary" Click="@CancelEdit" />
            </div>
        </ChildContent>
    </RadzenTemplateForm>
 }

 <RadzenDataGrid TItem="Schedule" Data="@schedules" ColumnWidth="200px" RowSelect="@EditSchedule" RowDelete="@DeleteSchedule">
    <Columns>
        <RadzenDataGridColumn TItem="Schedule" Property="SchoolCourse" Title="Course" />
        <RadzenDataGridColumn TItem="Schedule" Property="ClassID" Title="Class ID" />
        <RadzenDataGridColumn TItem="Schedule" Property="StartTime" Title="Start Time" />
        <RadzenDataGridColumn TItem="Schedule" Property="EndTime" Title="End Time" />
        <RadzenDataGridColumn TItem="Schedule" Property="DayName" Title="Day Name" />
        <RadzenDataGridColumn TItem="Schedule" Context="schedule" Width="70px">
            <Template Context="schedule">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" Click="@(() => EditSchedule(schedule))" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" Click="@(() => DeleteSchedule(schedule.ScheduleID))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
 </RadzenDataGrid>

 <RadzenButton Icon="add_circle" Text="Add Schedule" Click="@ShowAddScheduleForm" />
}

@code {
    private IEnumerable<Schedule> schedules;
    private Schedule EditingSchedule = new Schedule();
    private bool isEditing = false;
    private bool isLoading = false;
    private IEnumerable<string> classIDs;
    private IEnumerable<SchoolCourse> schoolCourses;
    private IEnumerable<Day> days;

    protected override async Task OnInitializedAsync()
    {
        try{
            isLoading = true;
            schedules = await scheduleService.GetAllSchedulesAsync();
            classIDs = await scheduleService.GetClassIDsAsync();
            schoolCourses = await scheduleService.GetSchoolCoursesAsync();
            days = await scheduleService.GetDaysAsync();
        }
        catch(Exception ex)
        {

        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddScheduleForm()
    {
        EditingSchedule = new Schedule(); // Reset for new entry
        isEditing = true;
    }

    private async Task EditSchedule(Schedule schedule)
    {
        EditingSchedule = schedule; // Set the schedule to be edited
        isEditing = true;
    }

    private async Task OnSubmit()
    {
        try
        {
            isLoading = true;
            if (EditingSchedule.SubjectStartTime == DateTime.MinValue ||
            EditingSchedule.SubjectEndTime == DateTime.MinValue)
            {
                // Show an error message to the user about missing values
                return; // Prevent submission
            }

            if (EditingSchedule.ScheduleID == 0) // Assuming ScheduleID is 0 for new entries
            {
                await scheduleService.AddScheduleAsync(EditingSchedule);
            }
            else
            {
                await scheduleService.UpdateScheduleAsync(EditingSchedule);
            }

            isEditing = false;
            schedules = await scheduleService.GetAllSchedulesAsync(); // Refresh the schedule list
            Notify.ShowNotification("Submitted", "Successfully", NotificationSeverity.Success);
        }
        catch(Exception ex)
        {
            Notify.ShowNotification("Failed","Submit",NotificationSeverity.Warning);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private async Task DeleteSchedule(int scheduleId)
    {
        try{
            isLoading = true;
            await scheduleService.DeleteScheduleAsync(scheduleId);
            schedules = await scheduleService.GetAllSchedulesAsync();
            Notify.ShowNotification("Deleted","Successfully",NotificationSeverity.Info);
        }
        catch
        {
            Notify.ShowNotification("Failed","To Delete",NotificationSeverity.Warning);
        }
    }
}
