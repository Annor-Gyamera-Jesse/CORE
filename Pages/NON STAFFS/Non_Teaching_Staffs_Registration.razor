@page "/nonteachingstaffsregistration"
@using CORE.MODEL
@using CORE.SERVICE
@using System.ComponentModel.DataAnnotations
@inject AuthService authService

<style>
    form .row {
        margin-bottom: 16px;
        margin-top: 10px;
    }

    .rz-fieldset-content {
        padding: 0;
    }

    .form-label {
        padding-top: 8px;
    }

    .form-control {
        margin-bottom: 8px;
    }
</style>

<RadzenFieldset Text="Non Teaching Staffs Registration">
    <div class="row">
        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="NTS FirstName" Component="textntsname" />
        </div>
        <div class="col-md-3">
            <RadzenTextBox class="form-control form-control-sm" @bind-Value="@nonteachingRegistration.NonTeachingStaffsFirstName" />
        </div>

        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="NTS LastName" Component="textntslastname" />
        </div>
        <div class="col-md-3">
            <RadzenTextBox class="form-control form-control-sm" @bind-Value="@nonteachingRegistration.NonTeachingStaffsLastName" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="Date of Birth" Component="textntsdob" />
        </div>
        <div class="col-md-3">
            <RadzenDatePicker @bind-Value="@nonteachingRegistration.NonTeachingStaffsDateOfBirth" Format="d" Placeholder="Select Date of Birth" />
        </div>

        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="NTS Gender" Component="textntsgender" />
        </div>
        <div class="col-md-3">
            <RadzenTextBox class="form-control form-control-sm" @bind-Value="@nonteachingRegistration.NonTeachingStaffsGender" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="NTS Address" Component="textntsaddress" />
        </div>
        <div class="col-md-3">
            <RadzenTextBox class="form-control form-control-sm" @bind-Value="@nonteachingRegistration.NonTeachingStaffsAddress" />
        </div>

        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="NTS Phone Number" Component="textntsphonenumber" />
        </div>
        <div class="col-md-3">
            <RadzenTextBox class="form-control form-control-sm" @bind-Value="@nonteachingRegistration.NonTeachingStaffsPhoneNumber" />
        </div>

        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="Upload Image" Component="fileInput" />
        </div>
        <div class="col-md-3">
            <InputFile id="ntsImage" OnChange="HandleFileChange" key="@inputFileKey" />
        </div>

        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="NTS Email" Component="textntsemail" />
        </div>
        <div class="col-md-3">
            <RadzenTextBox class="form-control form-control-sm" @bind-Value="@nonteachingRegistration.NonTeachingStaffsEmail" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-3 text-md-end form-label">
            <RadzenLabel Text="NTS ID" Component="textntsid" />
        </div>
        <div class="col-md-3">
            <RadzenTextBox class="form-control form-control-sm" Value="@newnonteachingRegistrationId.ToString()" ReadOnly="true" />
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-3">
            <RadzenButton Text="Submit" Icon="check" ButtonType="ButtonType.Submit" Click="@SubmitForm" Style="margin-bottom: 10px; width: 130px; padding-right:15px" />
        </div>
        <div class="col-md-3">
            <RadzenButton Text="New" Icon="add" ButtonStyle="ButtonStyle.Primary" Click="@ResetForm" Style="margin-bottom: 10px; width: 130px; padding-right:15px" />
        </div>
    </div>
</RadzenFieldset>

<!-- Bootstrap alert for success message -->
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">
        <strong>Success!</strong> @successMessage
    </div>
}
<!-- Bootstrap alert for error message -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        <strong>Error!</strong> @errorMessage
    </div>
}

@code {
    NonTeachingStaffsRegistration nonteachingRegistration = new NonTeachingStaffsRegistration();
    byte[] imageData;
    int newnonteachingRegistrationId;
    string successMessage;
    string errorMessage;
    private IBrowserFile selectedFile;
    private int inputFileKey = 0;

    async Task SubmitForm()
    {
        if (IsValid(nonteachingRegistration))
        {
            if (selectedFile != null)
            {
                using (var stream = selectedFile.OpenReadStream())
                {
                    using (var memoryStream = new MemoryStream())
                    {
                        await stream.CopyToAsync(memoryStream);
                        imageData = memoryStream.ToArray();
                    }
                }

                nonteachingRegistration.ImageData = imageData;
            }

            // Call the service to add the teacher
            newnonteachingRegistrationId = await authService.AddNonTeachingStaffsAsync(nonteachingRegistration);

            if (newnonteachingRegistrationId > 0)
            {
                Console.WriteLine($"Teacher successfully registered. TeacherID: {newnonteachingRegistrationId}");
                successMessage = "Teacher successfully registered.";
                // Reset error message
                errorMessage = string.Empty;
            }
            else
            {
                Console.WriteLine("Failed to register the teacher.");
                errorMessage = "Failed to register the teacher. Please try again.";
                // Reset success message
                successMessage = string.Empty;
                // Handle failure, show error messages, etc.
            }
        }
    }

    bool IsValid(object obj)
    {
        // Validate the object using DataAnnotations
        var validationContext = new ValidationContext(obj, null, null);
        var validationResults = new List<ValidationResult>();
        return Validator.TryValidateObject(obj, validationContext, validationResults, true);
    }

    private void HandleFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    void ResetForm()
    {
        // Create a new instance of the TeachersRegistration class to clear all fields
        nonteachingRegistration = new NonTeachingStaffsRegistration();

        // Reset other variables as needed
        selectedFile = null;
        imageData = null;
        newnonteachingRegistrationId = 0;
        successMessage = string.Empty;
        errorMessage = string.Empty;

        // Create a new instance of InputFile to replace the existing one
        inputFileKey++;
        StateHasChanged();
    }
}


