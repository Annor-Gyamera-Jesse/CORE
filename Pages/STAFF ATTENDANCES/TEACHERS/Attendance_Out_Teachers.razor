@page "/clockout"
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService authService
@inject NotificationMessageService Notify
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using Radzen.Blazor
@using System.Timers
<RadzenNotification />

<style>
    .warning-message {
        color: red;
        font-weight: bold;
        margin-top: 10px;
    }
</style>

<div class="row">
    <div class="col-md-4">
        <RadzenFieldset Text="TEACHERS">
            <RadzenListBox @bind-Value="selectedTeacherId" AllowFiltering="true" AllowVirtualization="true"
                           Data="@teachersAttendance" TextProperty="TeacherFirstName" ValueProperty="TeacherID"
                           Style="width: 100%; height: 300px;" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                           Change="@(args => OnTeacherSelectionChange((int)args))">
            </RadzenListBox>
        </RadzenFieldset>
    </div>
    <div class="col-md-8">
        <form @ref="clockOutForm" @onsubmit="@ClockOut">
            <RadzenForm Data="@attendanceOutModel">
                <RadzenField Property="SelectedTeacher" Title="Selected Teacher">
                    <RadzenTextBox @bind-Value="@attendanceOutModel.SelectedTeacher" ReadOnly="true"></RadzenTextBox>
                </RadzenField>
                <RadzenLabel Text="Clocked In At"/>
                <RadzenField Property="ClockInTime" Title="Clock In Time">
                    <RadzenTextBox @bind-Value="@attendanceOutModel.ClockInTime" ReadOnly="true"></RadzenTextBox>
                </RadzenField>
                <RadzenLabel Text="Clock Out"/>
                <RadzenField Property="IsClockedOut" Title="Clocked Out">
                    <RadzenSwitch @bind-Value="@attendanceOutModel.IsClockedOut"></RadzenSwitch>
                </RadzenField>
                <div class="text-right">
                    <RadzenButton Text="Clock Out" Click="@ClockOut" Disabled="!attendanceOutModel.IsClockedOut"></RadzenButton>
                    @if (!attendanceOutModel.IsClockedOut)
                    {
                        <div class="warning-message">Please turn on the switch before submitting.</div>
                    }
                </div>
            </RadzenForm>
        </form>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Teachers Name</th>
            <th>Enable Switch</th>
            <th>Clock Out</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var record in attendanceOutRecords)
        {
            <tr>
                <td>@record.TeacherFirstName</td>
                <td>@record.EnableSwitch</td>                
                <td>@record.ClockOUT</td>
            </tr>
        }
    </tbody>
</table>

@code {
    List<TeacherAttendance> teachersAttendance;
    List<TeachersAttendanceOut> attendanceOutRecords = new List<TeachersAttendanceOut>();
    ClockOutModel attendanceOutModel = new ClockOutModel();
    int selectedTeacherId;
    ElementReference clockOutForm;
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
        var user = await authService.GetUserByUsernameAsync(username);
        if (user != null)
        {
            userId = user.UserID;
        }

        // Fetch today's attendance
        teachersAttendance = await authService.GetTodaysAttendanceAsync();
    }

    void OnTeacherSelectionChange(int selectedValue)
    {
        if (selectedValue > 0)
        {
            var selectedTeacher = teachersAttendance.FirstOrDefault(t => t.TeacherID == selectedValue);
            if (selectedTeacher != null)
            {
                attendanceOutModel.SelectedTeacher = $"{selectedTeacher.TeacherFirstName} {selectedTeacher.TeacherLastName}";
                attendanceOutModel.ClockInTime = selectedTeacher.ClockIN.ToString("yyyy-MM-dd HH:mm:ss"); // Display clock-in time
            }
        }
    }

    async Task ClockOut()
    {
        try
        {
            // Log the selectedTeacherId to ensure it's valid
            Console.WriteLine($"Selected Teacher ID: {selectedTeacherId}");

            var selectedTeacher = teachersAttendance.FirstOrDefault(t => t.TeacherID == selectedTeacherId);

            // Check if selectedTeacher is found
            if (selectedTeacher == null)
            {
                Console.WriteLine("Teacher not found.");
                Notify.ShowNotification("Error", "Teacher not found.", NotificationSeverity.Error);
                return;
            }

            // Log attendance out model status
            Console.WriteLine($"Attendance Out Model IsClockedOut: {attendanceOutModel.IsClockedOut}");

            var newRecord = new TeachersAttendanceOut
                {
                    TeacherFirstName = selectedTeacher.TeacherFirstName,
                    TeacherLastName = selectedTeacher.TeacherLastName,
                    EnableSwitch = attendanceOutModel.IsClockedOut,
                    ClockOUT = DateTime.Now,
                    UserID = userId
                };

            // Log the record to be saved
            Console.WriteLine($"New Attendance Out Record: {newRecord.TeacherFirstName} {newRecord.TeacherLastName}, {newRecord.ClockOUT}");

            bool saved = await authService.SaveTeachersAttendanceOutAsync(newRecord);

            // Log save result
            Console.WriteLine($"Attendance Save Result: {saved}");

            if (saved)
            {
                attendanceOutRecords.Add(newRecord);
                Notify.ShowNotification($"Success", "Clock out recorded successfully!", NotificationSeverity.Success);
            }
            else
            {
                Notify.ShowNotification("Error", "Failed to clock out.", NotificationSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            // Log any exceptions that occur
            Console.WriteLine($"Error: {ex.Message}");
            Notify.ShowNotification("Error", $"An error occurred: {ex.Message}", NotificationSeverity.Error);
        }
    }


    public class ClockOutModel
    {
        public string SelectedTeacher { get; set; }
        public string ClockInTime { get; set; } // Displaying ClockInTime as string
        public bool IsClockedOut { get; set; }
    }
}
