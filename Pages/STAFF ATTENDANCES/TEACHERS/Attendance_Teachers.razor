@page "/teacherattendance"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService AuthService
@inject NotificationMessageService Notify
@using CORE.SERVICE.NOTIFICATION
@using CORE.Tool_Components
@using Radzen
@using Radzen.Blazor
@inject IJSRuntime JSRuntime
@inherits Attendance_Teachers_codebehind

<RadzenNotification />

<style>
    .header {
        margin-bottom: 20px;
        text-align: center;
        background-color: #4A90E2;
        color: white;
        padding: 20px 0;
        border-radius: 8px;
    }

    .warning-message {
        color: red;
        font-weight: bold;
        margin-top: 10px;
        text-align: center;
    }

    .form-container {
        margin: 20px 0;
    }

    .attendance-table {
        margin-top: 30px;
    }

    .table-header {
        background-color: #007BFF;
        color: white;
        text-align: center;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: rgba(0, 0, 0, 0.05);
    }

    .btn-submit {
        background-color: #28a745;
        border-color: #28a745;
        color: white;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .btn-submit:hover {
        background-color: #218838;
    }

    .card {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        padding: 20px;
    }

    .right-align {
        margin-left: auto;
    }
</style>

<div class="container">
    <div class="row header">
        <div class="col-md-12">
            <h1>Teacher Attendance</h1>
        </div>
    </div>

    <div class="row form-container">
        <div class="col-md-4">
            <div class="card">
                <RadzenFieldset Text="Teachers List">
                    <RadzenListBox @bind-Value="selectedTeacher" AllowFiltering="true" AllowVirtualization="true"
                                   Data="@teachers" TextProperty="FullName" ValueProperty="TeacherID"
                                   Style="width: 100%; height: 300px;" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                   Change="@(args => OnTeacherSelectionChange((int)args))">
                    </RadzenListBox>
                </RadzenFieldset>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <form @ref="attendanceForm" @onsubmit="@SubmitAttendance">
                    <RadzenForm Data="@attendanceModel">
                        <RadzenField Property="SelectedTeacher" Title="Selected Teacher">
                            <RadzenTextBox @bind-Value="@attendanceModel.SelectedTeacher" ReadOnly="true" Style="width: 100%;"></RadzenTextBox>
                        </RadzenField>

                        <RadzenField Property="SelectedDate" Title="Selected Date">
                            <RadzenDatePicker @bind-Value="@attendanceModel.SelectedDate" Style="width: 100%;"/>
                        </RadzenField>

                        <RadzenLabel Text="Clock IN"/>
                        <RadzenField Property="IsClockedIn" Title="Clocked In">
                            <RadzenSwitch @bind-Value="@attendanceModel.IsClockedIn"></RadzenSwitch>
                        </RadzenField>

                        <div class="text-right">
                            <RadzenButton Text="Submit Attendance" Click="@SubmitAttendance" Disabled="!attendanceModel.IsClockedIn"></RadzenButton>
                            @if (!attendanceModel.IsClockedIn)
                            {
                                <div class="warning-message">Please turn on the switch before submitting.</div>
                            }
                        </div>
                    </RadzenForm>
                </form>
            </div>
        </div>
    </div>

    <div class="row attendance-table">
        <div class="col-md-12">
            <div class="card">
                <RadzenGrid Data="@attendanceRecords" TItem="TeacherAttendance" ColumnWidth="200px">
                    <Columns>
                        <RadzenGridColumn TItem="TeacherAttendance" Property="TeacherFirstName" Title="Teacher Name" HeaderCssClass="table-header"/>
                        <RadzenGridColumn TItem="TeacherAttendance" Property="EnableSwitch" Title="Enable Switch" HeaderCssClass="table-header"/>
                        <RadzenGridColumn TItem="TeacherAttendance" Property="ClockIN" Title="Clock In" HeaderCssClass="table-header" />
                    </Columns>
                </RadzenGrid>
            </div>
        </div>
    </div>
</div>


<RadzenFieldset Text="PRINT STUDENT REPORT" class="right-align">
<Teachers_Attendance_Component OnTeachersAttendanceReportDialog="TeachersAttendanceReport" />
</RadzenFieldset>

@code {
    List<TeachersRegistration> teachers;
    List<TeacherAttendance> attendanceRecords = new List<TeacherAttendance>();
    AttendanceModel attendanceModel = new AttendanceModel();
    int selectedTeacher;
    ElementReference attendanceForm;

    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
        var user = await AuthService.GetUserByUsernameAsync(username);
        if (user != null)
        {
            userId = user.UserID;
        }
        teachers = await AuthService.GetTeachersAsync();
    }

    void OnTeacherSelectionChange(int selectedValue)
    {
        if (selectedValue > 0)
        {
            var selectedTeacher = teachers.FirstOrDefault(t => t.TeacherID == selectedValue);
            if (selectedTeacher != null)
            {
                attendanceModel.SelectedTeacher = $"{selectedTeacher.TeacherFirstName} {selectedTeacher.TeacherLastName}";
            }
        }
    }

    async Task SubmitAttendance()
    {
        var newRecord = new TeacherAttendance
            {
                TeacherFirstName = attendanceModel.SelectedTeacher,
                TeacherLastName = "", // You can set this if you have last name available
                EnableSwitch = attendanceModel.IsClockedIn,
                ClockIN = attendanceModel.SelectedDate,
                UserID = userId  // Set the UserID here
            };

        bool saved = await AuthService.SaveTeachersAttendanceAsync(newRecord);

        if (saved)
        {
            attendanceRecords.Add(newRecord);
            attendanceModel = new AttendanceModel();
            StateHasChanged();
            Notify.ShowNotification($"Teacher", $"{newRecord.TeacherFirstName}, Date: {newRecord.ClockIN}, Clocked In: {newRecord.EnableSwitch}", NotificationSeverity.Success);
        }
        else
        {
            Notify.ShowNotification("ALERT", "Failed to save attendance.", NotificationSeverity.Error);
        }
    }

    async void TeachersAttendanceReport() => await OpenTeachersAttendanceReportDialog();

    public class AttendanceModel
    {
        public string SelectedTeacher { get; set; }
        public DateTime SelectedDate { get; set; } = DateTime.Now;
        public bool IsClockedIn { get; set; }
        public int UserID { get; set; }
    }
}
