@page "/hr-salary-management"
@inject AuthService HrService
@inject DialogService DialogService
@using CORE.MODEL
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject NotificationMessageService Notify
<RadzenNotification/>

<RadzenRow>
    <!-- Staff List Panel -->
    <RadzenColumn Size="5">
        <RadzenCard Class="shadow-2xl p-4 bg-white rounded-2xl">
            <h4 class="text-2xl font-extrabold text-indigo-600">Staff List</h4>
            <RadzenTextBox Value="@searchQuery" @onchange="FilterStaff" Placeholder="Search staff..." Class="w-full border border-gray-300 rounded-lg p-2" />
            <RadzenListBox TItem="Staff" Data="filteredStaffList" @bind-Value="selectedStaff" TextProperty="StaffFullName" Class="w-full rounded-lg border-gray-200" />
        </RadzenCard>
    </RadzenColumn>

    <!-- Staff Details and Payment Panel -->
    <RadzenColumn Size="8">
        <RadzenCard Class="shadow-2xl p-6 bg-white rounded-2xl">
            <RadzenDropDown @bind-Value="selectedCategoryId" Data="@paymentCategories"
            TextProperty="CategoryName" ValueProperty="CategoryID"
            Class="w-full border-gray-300 rounded-lg p-2" Placeholder="Select Payment Category" />

            <RadzenFlexRow Class="mt-4 space-x-4">
                <RadzenButton Text="Automatic Payment" Click="ProcessAutomaticPayment" Icon="credit_card"
                Class="bg-gradient-to-r from-blue-500 to-indigo-600 text-white font-bold py-2 px-4 rounded-lg w-1/2" />
                <RadzenButton Text="Manual Payment" Icon="money"
                Click="HandleManualPayment"
                Class="bg-gradient-to-r from-green-500 to-teal-600 text-white font-bold py-2 px-4 rounded-lg w-1/2" />
                <RadzenDropDown @bind-Value="selectedPaymentMethod" Data="@paymentMethods"
                                Placeholder="Select Payment Method"
                                Class="w-1/3 border-gray-300 rounded-lg p-2" />
            </RadzenFlexRow>

            @if (selectedStaff != null)
            {
                <!-- Staff Detail's -->
                <RadzenRow Class="mt-6">
                    <RadzenColumn Size="3">
                        <RadzenImage Path="@GetStaffImage()" Width="100px" Height="100px" Class="rounded-full border-4 border-gray-300 shadow-md" />
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <h3 class="text-2xl font-bold text-gray-700">@selectedStaff.StaffFirstName @selectedStaff.StaffLastName</h3>
                        <p class="text-gray-600"><strong>Department:</strong> @selectedStaff.Department</p>
                        <p class="text-gray-600"><strong>Position:</strong> @selectedStaff.Position</p>
                        <p><strong>Status:</strong> 
                            <span class="@(selectedStaff.EmploymentStatus == "Active" ? "text-green-600" : "text-red-600") font-semibold">
                                @selectedStaff.EmploymentStatus
                            </span>
                        </p>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenDivider Class="my-6" />

                <!-- Salary Payment Section -->
           <h4 class="text-2xl font-bold text-indigo-600 mb-4">Process Salary Payment</h4>

<RadzenCard Class="p-6 shadow-lg rounded-lg border border-gray-200">
    <RadzenRow>
        <!-- Left Column: Bank Details -->
        <RadzenColumn Size="6">
            <RadzenFieldset Text="Bank Details" Class="border-gray-300 rounded-lg p-4">
                <RadzenLabel Text="Bank Name" Class="font-semibold text-gray-700 mb-1" />
                <RadzenTextBox @bind-Value="selectedStaff.BankName" Class="w-full mb-3 border-gray-300 rounded-lg p-2" />

                <RadzenLabel Text="Account Name" Class="font-semibold text-gray-700 mb-1" />
                <RadzenTextBox @bind-Value="selectedStaff.AccountName" Class="w-full mb-3 border-gray-300 rounded-lg p-2" />

                <RadzenLabel Text="Account Number" Class="font-semibold text-gray-700 mb-1" />
                <RadzenTextBox @bind-Value="selectedStaff.AccountNumber" Class="w-full border-gray-300 rounded-lg p-2" />
            </RadzenFieldset>
        </RadzenColumn>

        <!-- Right Column: Salary Details -->
        <RadzenColumn Size="6">
            <RadzenFieldset Text="Salary Details" Class="border-gray-300 rounded-lg p-4">
                <RadzenLabel Text="Salary ($)" Class="font-semibold text-gray-700 mb-1" />
                <RadzenNumeric @bind-Value="selectedStaff.Salary" Class="w-full mb-3 border-gray-300 rounded-lg p-2" />

                <RadzenLabel Text="Overtime ($)" Class="font-semibold text-gray-700 mb-1" />
                <RadzenNumeric @bind-Value="selectedStaff.OverTime" Class="w-full mb-3 border-gray-300 rounded-lg p-2" />

                <RadzenLabel Text="Tax Deduction ($)" Class="font-semibold text-gray-700 mb-1" />
                <RadzenNumeric @bind-Value="selectedStaff.TaxMoney" Class="w-full border-gray-300 rounded-lg p-2" />
            </RadzenFieldset>
        </RadzenColumn>
    </RadzenRow>

    <RadzenDivider Class="my-6" />

    <!-- Month & Year Selection -->
    <RadzenFieldset Text="Payment Period" Class="border-gray-300 rounded-lg p-4">
        <RadzenFlexRow Class="space-x-4">
            <RadzenDropDown @bind-Value="selectedMonth" Data="@months" Placeholder="Select Month" Class="w-1/2 border-gray-300 rounded-lg p-2" />
            <RadzenDropDown @bind-Value="selectedYear" Data="@years" Placeholder="Select Year" Class="w-1/2 border-gray-300 rounded-lg p-2" />
        </RadzenFlexRow>
    </RadzenFieldset>

    <RadzenFlexRow Class="justify-end mt-6 space-x-4">
        <RadzenButton Text="Cancel" Click="ResetFields" Class="bg-gray-400 text-white px-4 py-2 rounded-lg" ButtonStyle="ButtonStyle.Danger"/>
                        <RadzenButton Text="@buttonText" Icon="credit_card" Click="HandleButtonClick" ButtonStyle="ButtonStyle.Light"
                                      Class="mt-4 bg-gradient-to-r from-red-500 to-pink-600 text-white font-bold py-2 px-4 rounded-lg w-full" />
    </RadzenFlexRow>
</RadzenCard>             

                <RadzenDivider Class="my-6" />

                <!-- Payment History -->
                <h4 class="text-2xl font-bold text-indigo-600">Payment History</h4>
                <RadzenGrid Data="paymentHistory" TItem="PaymentRecord" Class="rounded-lg shadow-lg border border-gray-200">
                    <Columns>
                        <RadzenGridColumn TItem="PaymentRecord" Property="PayedOn" Title="Date" />
                        <RadzenGridColumn TItem="PaymentRecord" Property="SalaryFor" Title="Month" />
                        <RadzenGridColumn TItem="PaymentRecord" Property="PaymentYear" Title="Year" />
                        <RadzenGridColumn TItem="PaymentRecord" Property="Salary" Title="Amount ($)" />
                    </Columns>
                </RadzenGrid>
            }
            else
            {
                <p class="text-center text-gray-500 font-medium">Select a staff member to view details.</p>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>



@code {

    private List<Staff> staffList = new();
    private List<Staff> filteredStaffList = new();
    private Staff selectedStaff;
    private List<PaymentRecord> paymentHistory = new();
    private string searchQuery = "";
    private int selectedMonth = DateTime.Now.Month;
    private int selectedYear = DateTime.Now.Year;
    private List<int> months = Enumerable.Range(1, 12).ToList();
    private List<int> years = Enumerable.Range(2000, 25).ToList();
    private bool isSaved = false;
    private string buttonText = "Save";
    private string buttonStyle = "background-color: red; color: white; width: 100%;";
    private List<PaymentCategory> paymentCategories = new();    
    private int selectedCategoryId;
    private Dictionary<int, decimal> manualPaymentAmounts = new();
    private List<string> paymentMethods = new();
    private string selectedPaymentMethod;

    private async Task HandleManualPayment()
    {
        if (selectedStaff == null)
        {
            await DialogService.Alert("Please select a staff member.", "Warning");
            return;
        }

        var paymentData = new
        {
            StaffID = selectedStaff.StaffID,
            CategoryID = selectedCategoryId, // Ensure this is not null or missing
            SalaryFor = selectedMonth,
            PaymentYear = selectedYear,
            Amount = selectedStaff.Salary,
            OverTime = selectedStaff.OverTime,
            TaxDeduction = selectedStaff.TaxMoney,
            BankName = selectedStaff.BankName,
            AccountName = selectedStaff.AccountName,
            AccountNumber = selectedStaff.AccountNumber
        };


        bool success = await HrService.InsertSalaryPaymentAsync(paymentData);

        if (success)
        {
             Notify.ShowNotification("Manual Payment Successful!","",NotificationSeverity.Success);
            paymentHistory = await HrService.GetPaymentHistoryAsync(selectedStaff.StaffID);
        }
        else
        {
            await DialogService.Alert("Payment failed. Please try again.", "Error");
        }
    }

    private void ResetFields()
    {
        selectedStaff = null;
        selectedCategoryId = 0;
        selectedMonth = DateTime.Now.Month;
        selectedYear = DateTime.Now.Year;
    }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            paymentCategories = await HrService.GetPaymentCategoriesAsync();
            staffList = (await HrService.GetAllStaffAsync()).ToList();
            paymentMethods = await HrService.GetPaymentMethodsAsync();
            filteredStaffList = staffList;
        }
        catch (Exception ex)
        {
            await DialogService.Alert($"Error loading staff list: {ex.Message}", "Error");
        }
    }

    private async Task LoadStaffByCategory(ChangeEventArgs e)
    {
        selectedCategoryId = Convert.ToInt32(e.Value);
        filteredStaffList = await HrService.GetStaffByCategoryAsync(selectedCategoryId);
    }

    private string GetStaffImage()
    {
        try
        {
            if (selectedStaff?.ImageData != null && selectedStaff.ImageData.Length > 0)
            {
                return $"data:image/png;base64,{Convert.ToBase64String(selectedStaff.ImageData)}";
            }
            else
            {
                return "default-profile.png"; // Replace with a valid placeholder image path
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading staff image: {ex.Message}");
            return "default-profile.png";
        }
    }

    private void FilterStaff(ChangeEventArgs e)
    {
        try
        {
            searchQuery = e.Value.ToString();
            filteredStaffList = staffList.Where(s => s.StaffFullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering staff: {ex.Message}");
        }
    }

    private async Task OnStaffSelect(ChangeEventArgs e)
    {
        try
        {
            selectedStaff = e.Value as Staff;
            if (selectedStaff != null)
            {
                paymentHistory = await HrService.GetPaymentHistoryAsync(selectedStaff.StaffID);
            }
        }
        catch (Exception ex)
        {
            await DialogService.Alert($"Error retrieving payment history: {ex.Message}", "Error");
        }
    }

    private async Task HandleButtonClick()
    {
        try
        {
            if (!isSaved)
            {
                await SaveSalaryDetails();
                isSaved = true;
                buttonText = "Pay Salary";
                buttonStyle = "background-color: green; color: white; width: 100%;";
            }
            else
            {
                await ProcessPayment();
            }
        }
        catch (Exception ex)
        {
            //await DialogService.Alert($"Error processing action: {ex.Message}", "Error");
            Notify.ShowNotification("Error", $"Error processing action: {ex.Message}", NotificationSeverity.Error);
        }
    }

    private async Task SaveSalaryDetails()
    {
        try
        {
            // Logic to save salary details before payment
           // await DialogService.Alert("Salary details saved!", "Success");

            Notify.ShowNotification("Success", "Salary details saved!", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {

            // await DialogService.Alert($"Error saving salary details: {ex.Message}", "Error");

            Notify.ShowNotification("Error", $"Error saving salary details: {ex.Message}", NotificationSeverity.Error);
        }
    }

    private async Task ProcessPayment()
    {
        try
        {
            bool success = await HrService.PaySalaryAsync(selectedStaff.StaffID, selectedStaff.Salary, DateTime.Now, selectedMonth, selectedYear);
            if (success)
            {

                //await DialogService.Alert($"Salary paid successfully to {selectedStaff.StaffFirstName}!", "Success");

                Notify.ShowNotification("Success", $"Salary paid successfully to {selectedStaff.StaffFirstName}!", NotificationSeverity.Success);
                paymentHistory = await HrService.GetPaymentHistoryAsync(selectedStaff.StaffID);
            }
            else
            {

                //await DialogService.Alert("Salary payment failed!", "Error");

                Notify.ShowNotification("Error", "Salary payment failed!", NotificationSeverity.Warning);
            }
        }
        catch (Exception ex)
        {
            //await DialogService.Alert($"Error processing salary payment: {ex.Message}", "Error");
            Notify.ShowNotification("Error", $" Error processing salary payment: {ex.Message}", NotificationSeverity.Error);
        }
    }

    private async Task ProcessAutomaticPayment()
    {
        bool success = await HrService.ProcessAutomaticPaymentAsync(selectedCategoryId, "Bank Name", "Account Name", "12345678", selectedPaymentMethod);
        if (success)
        {
            Notify.ShowNotification("Success", "Automatic payment completed successfully!", NotificationSeverity.Success);
        }
        else
        {
            Notify.ShowNotification("Error", "Automatic payment failed!", NotificationSeverity.Warning);
        }
    }

    private async Task ProcessManualPayment(int staffId)
    {
        if (!manualPaymentAmounts.ContainsKey(staffId)) return;

        decimal amount = manualPaymentAmounts[staffId];
        bool success = await HrService.ProcessManualPaymentAsync(staffId, amount, DateTime.Now, DateTime.Now.Month, DateTime.Now.Year, selectedPaymentMethod);

        if (success)
        {
            Notify.ShowNotification("Success", "Manual payment completed!", NotificationSeverity.Success);
        }
        else
        {
            Notify.ShowNotification("Error", "Manual payment failed!", NotificationSeverity.Warning);
        }
    }
}
