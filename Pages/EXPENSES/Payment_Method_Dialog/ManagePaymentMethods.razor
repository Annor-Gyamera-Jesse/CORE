@page "/manage-payment-methods"
@using CORE.MODEL
@using CORE.MODEL.Expenses
@using CORE.SERVICE
@inject AuthService PaymentMethodService
@inject IJSRuntime JSRuntime
@inject NotificationMessageService Notify
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using Radzen.Blazor

<RadzenNotification />

<style>
    .page-title {
        text-align: center;
        font-size: 32px;
        font-weight: bold;
        color: #fff;
        background: linear-gradient(90deg, #4A90E2, #007ACC);
        padding: 20px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .card-wrapper {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .form-spacing {
        margin-bottom: 15px;
    }

    .grid-header {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
    }

    .responsive-grid {
        overflow-x: auto;
    }

    .save-button {
        margin-top: 15px;
        width: 100%;
    }

    .fieldset {
        border-left: 5px solid #4A90E2;
        padding-left: 15px;
    }
</style>

<div class="container">
    <div class="page-title">Manage Payment Methods</div>

    <div class="row">
        <div class="col-md-5">
            <div class="card-wrapper">
                <RadzenFieldset Text="Add / Edit Payment Method" Style="margin-bottom: 0;" class="fieldset">
                    <div class="form-spacing">
                        <RadzenTextBox @bind-Value="currentPaymentMethod.MethodName" Placeholder="Enter Method Name" Style="width: 100%;" />
                        <RadzenRequiredValidator Component="currentPaymentMethod.MethodName" Text="Method name is required." />
                    </div>

                    <div class="form-spacing">
                        <RadzenTextBox @bind-Value="currentPaymentMethod.Description" Placeholder="Enter Description" Style="width: 100%;" />
                    </div>

                    <div class="form-spacing">
                        <RadzenTextBox @bind-Value="currentPaymentMethod.BankNumber" Placeholder="Enter Bank Number" Style="width: 100%;" />
                    </div>

                    <RadzenButton Text="Save Payment Method"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Style="width: 100%; margin-top: 10px;"
                                  Click="@OnSavePaymentMethod" />
                </RadzenFieldset>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card-wrapper">
                <div class="grid-header">Your Payment Methods</div>
                <div class="responsive-grid">
                    <RadzenGrid Data="@paymentMethods" TItem="PaymentMethods" AllowPaging="true" PageSize="3" Responsive="true" Style="min-width: 100%;">
                        <Columns>
                            <RadzenGridColumn TItem="PaymentMethods" Property="MethodName" Title="Method Name" />
                            <RadzenGridColumn TItem="PaymentMethods" Property="Description" Title="Description" />
                            <RadzenGridColumn TItem="PaymentMethods" Property="BankNumber" Title="Bank Number" />
                            <RadzenGridColumn TItem="PaymentMethods" Title="Actions" Width="150px">
                                <Template Context="method">
                                    <div class="action-buttons">
                                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                                      Click="@(args => OnEditPaymentMethod(method))" />
                                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                      Click="@(args => OnDeletePaymentMethod(method))" />
                                    </div>
                                </Template>
                            </RadzenGridColumn>
                        </Columns>
                    </RadzenGrid>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<PaymentMethods> paymentMethods = new();
    private PaymentMethods currentPaymentMethod = new();
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
        var user = await PaymentMethodService.GetUserByUsernameAsync(username);
        if (user != null)
        {
            userId = user.UserID;
        }

        await LoadPaymentMethods();
    }

    private async Task LoadPaymentMethods()
    {
        paymentMethods = await PaymentMethodService.GetPaymentMethodsAsync(userId);
        StateHasChanged();
    }

    private async Task OnSavePaymentMethod()
    {
        if (string.IsNullOrWhiteSpace(currentPaymentMethod.MethodName))
        {
            Notify.ShowNotification("Error", "Method Name is required.", NotificationSeverity.Error);
            return;
        }

        var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
        var user = await PaymentMethodService.GetUserByUsernameAsync(username);
        if (user != null)
        {
            currentPaymentMethod.UserID = user.UserID;
        }
        else
        {
            Notify.ShowNotification("Error", "User not found.", NotificationSeverity.Error);
            return;
        }

        if (currentPaymentMethod.PaymentMethodID == 0)
        {
            await PaymentMethodService.AddsPaymentMethodAsync(currentPaymentMethod);
            Notify.ShowNotification("Success", "Payment Method added successfully.", NotificationSeverity.Success);
        }
        else
        {
            await PaymentMethodService.UpdatePaymentMethodAsync(currentPaymentMethod);
            Notify.ShowNotification("Success", "Payment Method updated successfully.", NotificationSeverity.Success);
        }

        await LoadPaymentMethods();
        currentPaymentMethod = new PaymentMethods();
    }

    private void OnEditPaymentMethod(PaymentMethods method)
    {
        currentPaymentMethod = new PaymentMethods
            {
                PaymentMethodID = method.PaymentMethodID,
                MethodName = method.MethodName,
                Description = method.Description,
                BankNumber = method.BankNumber,
                UserID = method.UserID
            };
        StateHasChanged();
    }

    private async Task OnDeletePaymentMethod(PaymentMethods method)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this payment method?");
        if (confirmed)
        {
            await PaymentMethodService.DeletePaymentMethodAsync(method.PaymentMethodID);
            Notify.ShowNotification("Success", "Payment Method deleted successfully.", NotificationSeverity.Success);
            await LoadPaymentMethods();
        }
    }
}
