@page "/manage-categories"
@using CORE.MODEL
@using CORE.MODEL.Expenses
@using CORE.SERVICE
@inject AuthService AuthService
@inject AuthService ExpenseService
@inject IJSRuntime JSRuntime
@inject NotificationMessageService Notify
@using CORE.SERVICE.NOTIFICATION
@using Radzen
@using Radzen.Blazor

<RadzenNotification />

<style>
    .page-title {
        text-align: center;
        font-size: 32px;
        font-weight: bold;
        color: #fff;
        background: linear-gradient(90deg, #4A90E2, #007ACC);
        padding: 20px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .card-wrapper {
        background-color: #ffffff;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .form-spacing {
        margin-bottom: 15px;
    }

    .grid-header {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
    }

    .responsive-grid {
        overflow-x: auto;
    }

    .save-button {
        margin-top: 15px;
        width: 100%;
    }

    .fieldset {
        border-left: 5px solid #4A90E2;
        padding-left: 15px;
    }
</style>

<div class="container">
    <div class="page-title">Manage Expense Categories</div>

    <div class="row">
        <div class="col-md-5">
            <div class="card-wrapper">
                <RadzenFieldset Text="Add / Edit Category" Style="margin-bottom: 0;" class="fieldset">
                    <div class="form-spacing">
                        <RadzenTextBox @bind-Value="currentCategory.CategoryName" Placeholder="Enter Category Name" Style="width: 100%;" />
                        <RadzenRequiredValidator Component="currentCategory.CategoryName" Text="Category name is required." />
                    </div>

                    <div class="form-spacing">
                        <RadzenTextBox @bind-Value="currentCategory.Description" Placeholder="Enter Description" Style="width: 100%;" />
                    </div>

                    <RadzenButton Text="Save Category"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Style="width: 100%; margin-top: 10px;"
                                  Click="@OnSaveCategory" />
                </RadzenFieldset>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card-wrapper">
                <div class="grid-header">Your Categories</div>
                <div class="responsive-grid">
                  <RadzenGrid Data="@categories"
            TItem="ExpenseCategory"
            AllowPaging="true"
            PageSize="3"
            AllowSorting="true"                        
            Responsive="true"
            Style="min-width: 100%;">
    <Columns>
        <RadzenGridColumn TItem="ExpenseCategory" Property="CategoryName" Title="Category" />
        <RadzenGridColumn TItem="ExpenseCategory" Property="Description" Title="Description" />
        <RadzenGridColumn TItem="ExpenseCategory" Title="Actions" Width="150px">
            <Template Context="category">
                <div class="action-buttons">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Info" Size="ButtonSize.Small"
                                  Click="@(args => OnEditCategory(category))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Click="@(args => OnDeleteCategory(category))" />
                </div>
            </Template>
        </RadzenGridColumn>
    </Columns>
</RadzenGrid>

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ExpenseCategory> categories = new();
    private ExpenseCategory currentCategory = new();
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
        var user = await ExpenseService.GetUserByUsernameAsync(username);

        if (user != null)
        {
            userId = user.UserID;
            Console.WriteLine($"User ID: {userId}");
        }
        else
        {
            Console.WriteLine("User not found.");
        }

        await LoadCategories();
    }

    private async Task LoadCategories()
    {
        categories = await ExpenseService.GetExpensesCategoriesAsync(userId);
        Console.WriteLine($"Loaded {categories.Count} categories.");
        StateHasChanged();
    }

    private async Task OnSaveCategory()
    {
        Console.WriteLine("OnSaveCategory clicked.");
        Console.WriteLine($"Category Name: {currentCategory.CategoryName}, Description: {currentCategory.Description}");

        if (string.IsNullOrWhiteSpace(currentCategory.CategoryName))
        {
            Notify.ShowNotification("Error", "Category Name is required.", NotificationSeverity.Error);
            return;
        }

        currentCategory.UserID = userId;

        if (currentCategory.CategoryID == 0)
        {
            await ExpenseService.AddExpensesCategoryAsync(currentCategory);
            Notify.ShowNotification("Success", "Category added successfully.", NotificationSeverity.Success);
        }
        else
        {
            await ExpenseService.UpdateExpenseCategoryAsync(currentCategory);
            Notify.ShowNotification("Success", "Category updated successfully.", NotificationSeverity.Success);
        }

        await LoadCategories();
        currentCategory = new ExpenseCategory();
        StateHasChanged();
    }

    private void OnEditCategory(ExpenseCategory category)
    {
        currentCategory = new ExpenseCategory
            {
                CategoryID = category.CategoryID,
                CategoryName = category.CategoryName,
                Description = category.Description,
                UserID = category.UserID
            };
    }

    private async Task OnDeleteCategory(ExpenseCategory category)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this category?");
        if (confirmed)
        {
            await ExpenseService.DeleteExpenseCategoryAsync(category.CategoryID);
            Notify.ShowNotification("Success", "Category deleted successfully.", NotificationSeverity.Success);
            await LoadCategories();
        }
    }
}
