@page "/pages/expenses/process-expenses"
@using CORE.MODEL
@using CORE.MODEL.Expenses
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@inject AuthService ExpenseService
@inject IJSRuntime JSRuntime
@inject NotificationMessageService Notify
@using CORE.SERVICE.NOTIFICATION
@using CORE.Tool_Components
@using Radzen
@using Radzen.Blazor
@inherits ProcessExpensesCodeBehind

<RadzenNotification />


<style>
    /* PRINT STUDENT REPOR */
    .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .right-align {
    margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
    height: 60px; /* Adjust the height to your preference */
    padding: 5px 15px; /* Reduce padding */
    }

    /* Additional styling if needed */
    .compact-header .rz-header-title {
    font-size: 18px; /* Make the title smaller */
    }
</style>

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <RadzenHeader title="School Fees Payment" class="header-container compact-header">
        <RadzenFieldset Text="Manage Category" class="right-align">
            <Expenses_Tool_Componet OnEditCategoriesDialog="OnEditCategoriesDialogClick" OnManagePaymentMethodsDialog="OnManagePaymentMethodsDialogCLick" />
        </RadzenFieldset>
    </RadzenHeader>

    <h3 class="text-center text-xl font-bold mb-4">Expenses Management</h3>

    <div class="row">
        <div class="col-md-6">
            <RadzenFieldset Text="Expense Categories">
                <RadzenListBox @bind-Value="selectedCategoryId"
                Data="@categories"
                TextProperty="CategoryName"
                ValueProperty="CategoryID"
                Style="height: 300px; width:100%" />
            </RadzenFieldset>
        </div>

        <div class="col-md-6">
            <RadzenFieldset Text="Make Payment">
                <RadzenDropDown Data="@paymentMethods"
                @bind-Value="selectedPaymentMethodId"
                TextProperty="MethodName"
                ValueProperty="PaymentMethodID"
                Placeholder="Select Payment Method"
                Style="width:100%;" />


                <RadzenNumeric TValue="decimal" @bind-Value="amount" Placeholder="Amount" Style="width:100%; margin-top: 10px;" />

                <RadzenTextBox @bind-Value="description" Placeholder="Description" Style="width:100%; margin-top: 10px;" />

                <RadzenButton Text="Save" Click="@SaveExpense" Style="margin-top: 15px;" Icon="save" ButtonStyle="ButtonStyle.Primary" />
            </RadzenFieldset>
        </div>
    </div>
}

@code {
    List<ExpenseCategory> categories = new();
    List<PaymentMethods> paymentMethods = new();
    int? selectedCategoryId;
    int? selectedPaymentMethodId;
    decimal amount;
    string description;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            categories = await ExpenseService.GetExpenseCategoriesAsync();
            paymentMethods = await ExpenseService.GetPaymentMethodsExpenesAsync();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveExpense()
    {
        try
        {
            isLoading = true;
            var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            var user = await ExpenseService.GetUserByUsernameAsync(username);
            var userId = user?.UserID ?? 0;

            var paymentMethod = paymentMethods.FirstOrDefault(p => p.PaymentMethodID == selectedPaymentMethodId);
            var category = categories.FirstOrDefault(c => c.CategoryID == selectedCategoryId);

            if (category == null || paymentMethod == null || amount <= 0)
            {
                Notify.ShowNotification("", "Please fill all the fields correctly.", NotificationSeverity.Info);
                return;
            }

            var expense = new Expense
                {
                    UserID = userId,
                    CategoryID = category.CategoryID,
                    Amount = amount,
                    Description = description,
                    ExpenseDate = DateTime.Now
                };

            var success = await ExpenseService.ProcessExpensePaymentAsync(expense, paymentMethod.PaymentMethodID);

            if (success)
            {
                Notify.ShowNotification("", "Payment and expense logged successfully.", NotificationSeverity.Success);
                amount = 0;
                description = "";
                selectedPaymentMethodId = null;
                selectedCategoryId = null;
            }
            else
            {
                Notify.ShowNotification("", "Something went wrong while processing payment, Ether Account You Selected Is 0", NotificationSeverity.Warning);
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }



    async void OnEditCategoriesDialogClick() => await OnEditCategories();
    async void OnManagePaymentMethodsDialogCLick() => await OnManagePaymentMethods();
}