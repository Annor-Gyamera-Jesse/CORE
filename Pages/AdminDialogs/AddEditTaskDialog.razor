@page "/add-edit-task"
@inject AuthService TeachersTaskService
@inject NotificationMessageService Notify
@using CORE.MODEL
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION

<Dialog>
    <RadzenCard>
        <RadzenCardContent>
            <h3 class="mb-4">@((task.TeacherTaskID == 0) ? "Add Task" : "Edit Task")</h3>

            <div class="form-group">
                <label for="teachersName">Teacher's Name:</label>
                <RadzenTextBox @bind-Value="task.TeachersName" class="form-control" />
            </div>

            <div class="form-group">
                <label for="teacherTask">Task:</label>
                <RadzenTextBox @bind-Value="task.TeacherTask" class="form-control" />
            </div>

            <div class="form-group">
                <label for="switchBar">Switch Bar:</label>
                <RadzenCheckBox @bind-Value="task.SwitchBar" />
            </div>

            <div class="form-group">
                <label for="startDate">Start Date:</label>
                <RadzenDatePicker @bind-Value="task.StartDate" class="form-control" />
            </div>

            <div class="form-group">
                <label for="endDate">End Date:</label>
                <RadzenDatePicker @bind-Value="task.EndDate" class="form-control" />
            </div>

            <div class="form-group">
                <label for="status">Status:</label>
                <RadzenDropDown @bind-Value="task.Status" Data="@(Enum.GetValues(typeof(CORE.TaskStatus)))" class="form-control" />
            </div>

            <div class="d-flex justify-content-end">
                <RadzenButton Text="Save" Click="SaveTask" ButtonStyle="ButtonStyle.Primary" Style="margin-right: 10px;" />
                <RadzenButton Text="Cancel" Click="Cancel" ButtonStyle="ButtonStyle.Danger" />
            </div>
        </RadzenCardContent>
    </RadzenCard>
</Dialog>

@code {
    [Parameter]
    public int? TaskId { get; set; }

    private TeachersTask task = new TeachersTask();

    protected override async Task OnInitializedAsync()
    {
        if (TaskId.HasValue)
        {
            task = await TeachersTaskService.GetTaskByIdAsync(TaskId.Value);
        }
    }

    private async Task SaveTask()
    {
        if (task.TeacherTaskID == 0)
        {
            await TeachersTaskService.AddTaskAsync(task);
            Notify.ShowNotification("Success", "Task added successfully!", NotificationSeverity.Success);
        }
        else
        {
            await TeachersTaskService.UpdateTaskAsync(task);
            Notify.ShowNotification("Success", "Task updated successfully!", NotificationSeverity.Success);
        }
        Close();
    }

    private void Cancel()
    {
        Close();
    }

    private void Close()
    {
        DialogService.Close();
    }
}
