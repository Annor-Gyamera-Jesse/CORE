@using CORE.Pages.ADMIN
@using Radzen
@inject DialogService DialogService
<RadzenNotification />

<style>
    .toolset-container {
        display: flex;
        gap: 10px; /* Adjust the spacing between buttons */
    }

    .toolset-btn {
        font-size: 14px;
        flex: 1; /* Makes both buttons take equal space */
    }
</style>

<div class="toolset-container mt-2">
    <RadzenButton Text="Show User Logs" Icon="assignment" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Secondary" Click=@OpenUserLogsDialog />
</div>

@code {
    [Parameter] public Action OpenUserLogsDialog { get; set; }
   
}