@using CORE.Pages.ADMIN
@using CORE.Pages.LESSONS_NOTES
@using Radzen
@inject DialogService DialogService

<style>
    .toolset-btn {
        margin-bottom: 5px;
        width: 100%;
        font-size: 14px
    }
</style>

<RadzenButton Text="Submitted Lesson Notes" Icon="assignment" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Secondary" Click=@OpenSubmittedLessonNotesDialog />


@code {
    public async Task OpenSubmittedLessonNotesDialog()
    {
        var dialogOptions = new DialogOptions() { Draggable = true, ShowClose = false, Width = "1000px", Resizable = false, Height = "512px"/*, Left = "calc(30% - 350px)", Top = "calc(30% - 265px)"*/ };
        var dialogtitle = $"Submitted Lesson Notes";
        //register dialog closed event with RadzenDialogService
        await DialogService.OpenAsync<View_Submitted_Lesson_Note_Page>(dialogtitle, null, dialogOptions);
    }
}