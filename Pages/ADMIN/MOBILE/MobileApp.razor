@page "/mobile/role/control"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService AuthService
@using CORE.SERVICE.MainLayout.Module
@using Radzen


<RadzenFieldset Text="Manage Phone Roles" Icon="phone">
    <div class="p-3">
    <RadzenLabel Text="Select User:" Component="h4" />
    <RadzenDropDown Data="@users" TextProperty="UserName" ValueProperty="UserID" Placeholder="--Select User--" @bind-Value="selectedUserId" Change="@(async args => await LoadUserRoles())" Style="width: 100%;" />

    @if (userRoles != null && userRoles.Any())
    {
        <div class="mt-4">
            <RadzenListBox TItem="MobileAppRole" TValue="int" Data="@userRoles" TextProperty="RoleName" ValueProperty="UserRoleID" Style="width: 100%;">
                <Template Context="role">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>@role.RoleName - @role.MenuItem - @role.CategoryName</span>
                        <RadzenCheckBox TValue="bool" Value="@role.Enable" Change="@(args => OnEnableChange(role.UserRoleID, args))" />
                    </div>
                </Template>
            </RadzenListBox>
        </div>

    }

    <div class="mt-4">
        <RadzenLabel Text="Assign New Role" Component="h4" />
        <RadzenFieldset Legend="New Role Details" Style="width: 100%;">
            <div class="row">
                <div class="col-md-4">
                    <RadzenLabel Text="Role:" />
                    <RadzenDropDown Data="@roles" TextProperty="RoleName" ValueProperty="RoleName" Placeholder="--Select Role--" @bind-Value="selectedRoleName" Style="width: 100%;" />
                </div>

                    <div class="col-md-4">
                        <RadzenLabel Text="Main Menu" />
                        <RadzenDropDown Data="@categoryNames" Placeholder="--Select Category--" @bind-Value="selectedCategoryName" Style="width: 100%;" />
                    </div>

                <div class="col-md-4">
                    <RadzenLabel Text="Sub Menu" />
                    <RadzenDropDown Data="@menuItems" TextProperty="ItemName" ValueProperty="ItemName" Placeholder="--Select Menu Item--" @bind-Value="selectedMenuItem" Style="width: 100%;" />
                </div>
              
            </div>
            <div class="mt-3">
                <RadzenCheckBox @bind-Value="isRoleEnabled" />
                <RadzenLabel Text="Enable" Style="margin-left: 5px;" />
            </div>
            <RadzenButton Text="Assign Role" Icon="add_circle_outline" Click="@(async () => await AssignRole())" Style="margin-top: 10px;" />
        </RadzenFieldset>
    </div>
</div>
</RadzenFieldset>


@code {
    private IEnumerable<User> users;
    private IEnumerable<Role> roles;
    private IEnumerable<MobileMenuItem> menuItems;
    private IEnumerable<MobileAppRole> userRoles;
    private IEnumerable<string> categoryNames;
    private string selectedCategoryName;
    private int selectedUserId;
    private string selectedRoleName;
    private bool isRoleEnabled;
    private string selectedMenuItem;

    protected override async Task OnInitializedAsync()
    {
        users = await AuthService.GetMUsersAsync();
        roles = await AuthService.GetRolesAsync();
        menuItems = await AuthService.GetMenuItemsAsync();
        categoryNames = await AuthService.GetCategoryNamesAsync() ?? new List<string>();
    }

    private async Task LoadUserRoles()
    {
        if (selectedUserId > 0)
        {
            userRoles = await AuthService.GetUserRolesAsync(selectedUserId);
        }
    }

    private async Task AssignRole()
    {
        if (selectedUserId > 0 && !string.IsNullOrEmpty(selectedRoleName))
        {
            await AuthService.AssignRoleAsync(selectedUserId, selectedRoleName, isRoleEnabled, selectedMenuItem, selectedCategoryName);
            await LoadUserRoles();
        }
    }



    private async Task OnEnableChange(int userRoleId, object value)

    {

        if (value is bool enable)

        {

            await UpdateRoleEnableStatus(userRoleId, enable);

        }

    }



    private async Task UpdateRoleEnableStatus(int userRoleId, bool enable)

    {

        await AuthService.UpdateRoleEnableStatusAsync(userRoleId, enable);

        await LoadUserRoles();

    }
}
