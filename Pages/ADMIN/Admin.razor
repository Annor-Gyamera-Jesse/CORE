@page "/admin"
@using CORE.SECURITY
@using CORE.SECURITY.LOADER
@inject ContentLoaderTemplate LoaderTemplate

<style>
    form .row {
        /*margin-bottom: 16px;*/
        /* margin-top: 10px;*/
    }

    .rz-fieldset-content {
        padding: 0;
        /*margin-left:2em;*/
    }
</style>


<div class="row">
    <div class="col-md-10">
        <RadzenTabs SelectedIndex="@SelectedTabPage" Change="@OnTabChange">
            <Tabs>
                <RadzenTabsItem Text="ADMIN">
                    <CORE.Pages.ADMIN.Administration_Security.Admin_Security/>
                </RadzenTabsItem>

                <RadzenTabsItem Text="ASSING ROLE">
                    <CORE.Pages.ADMIN.Administration_Security.AssignRole />
                </RadzenTabsItem>

               @*  <RadzenTabsItem Text="ASSIGN PERMISSIONS">
                    <CORE.Pages.ADMIN.Administration_Security.AssignPermissions />
                </RadzenTabsItem> *@

                <RadzenTabsItem Text="ASSIGN TEACHERS">
                    <CORE.Pages.ADMIN.Assign_Teachers/>
                </RadzenTabsItem>
                <RadzenTabsItem Text="VIEW LOGS">
                    <CORE.Pages.ADMIN.View_UserLogs />
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>

    </div>
</div>

@code {
    LoadTypeTrigger _loader;
    protected LoadTypeTrigger Loader
    {
        get => _loader;
        set
        {
            _loader = value;
            StateHasChanged();
        }
    }

    int SelectedTabPage = 0;

    void OnTabChange(int newIndex)
    {
        SelectedTabPage = newIndex;
    }
}



