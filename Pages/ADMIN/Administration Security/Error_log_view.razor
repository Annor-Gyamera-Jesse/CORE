@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService authservice


<RadzenGrid @ref="ViewGrid" Data="Grid" AllowPaging="true" AllowColumnResize="true" AllowSorting="true" AllowFiltering="true">
    <Columns>
        <RadzenGridColumn TItem="User_Log" Property="ErrorLogId" Title="ErrorLogId" Width="40px" />
        <RadzenGridColumn TItem="User_Log" Property="LogDate" Title="Log Date" Width="90px" />
        <RadzenGridColumn TItem="User_Log" Property="ErrorMessage" Title="Error Message" Width="100px" />
        <RadzenGridColumn TItem="User_Log" Property="StackTrace" Title="Stack Trace" Width="100px" />
        <RadzenGridColumn TItem="User_Log" Property="ControllerName" Title="ControllerName(PAGE)" Width="100px" />
        <RadzenGridColumn TItem="User_Log" Property="ActionName" Title="ActionName" Width="100px" />
        <RadzenGridColumn TItem="User_Log" Property="UserID" Title="UserID" Width="50px" />
    </Columns>
</RadzenGrid>



@code{
    RadzenGrid<User_Log> ViewGrid;
    public IEnumerable<User_Log> Grid;



    protected override async Task OnInitializedAsync()
    {
        Grid = await authservice.GetErrorsFromMobileAppAsync();
    }

}