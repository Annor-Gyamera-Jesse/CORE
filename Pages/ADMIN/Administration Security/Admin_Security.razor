@page "/manage-users"
@using CORE.MODEL
@using CORE.Pages.AdminDialogs
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SECURITY.FORGET_PASSWORD
@using CORE.SERVICE
@using CORE.SERVICE.MainLayout
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NotificationMessageService Notify
@inject DialogService DialogService
@inject UserService UserService
@inherits Admin_Security_CodeBehind
<RadzenNotification />

<style>
    .container-fluid {
        padding: 20px;
    }

    .custom-fieldset {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 12px;
        padding: 20px;
        background: #ffffff;
        margin-bottom: 20px;
    }

        .custom-fieldset h3 {
            color: #007bff;
            font-weight: 600;
        }

    .form-group label {
        font-weight: 500;
        color: #333;
    }

    .form-group input, .form-group select {
        border-radius: 8px;
        border: 1px solid #ced4da;
        padding: 10px;
        width: 100%;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .right-align {
        margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
        height: 60px; /* Adjust the height to your preference */
        padding: 5px 15px; /* Reduce padding */
    }

        /* Additional styling if needed */
        .compact-header .rz-header-title {
            font-size: 18px; /* Make the title smaller */
        }
    .grid-actions button {
        margin-right: 5px;
    }
</style>

<LoadingSpinner Visible="isLoading"/>
@if (!isLoading)
{
    <RadzenHeader title="TOOL COMPONENT" class="header-container compact-header">
    <RadzenFieldset Text="SECURITY TOOL COMPONENT" class="right-align">
        <UserLogsDialog OpenUserLogsDialog="OnOpenUserDialog" />
        </RadzenFieldset>
     </RadzenHeader>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-9">
                <div class="custom-fieldset">
                    <h3>Create User</h3>
                    <EditForm Model="@user" OnValidSubmit="@AddUser">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-group">
                            <label for="username">Username</label>
                            <RadzenTextBox id="username" @bind-Value="user.UserName" Style="width: 100%;" />
                            <ValidationMessage For="@(() => user.UserName)" />
                        </div>

                        <div class="form-group">
                            <label for="fullname">User Full Name</label>
                            <RadzenTextBox id="fullname" @bind-Value="user.FullName" Style="width: 100%;" />
                            <ValidationMessage For="@(() => user.FullName)" />
                        </div>

                        <div class="form-group">
                            <label for="password">Password</label>
                            <RadzenPassword id="password" @bind-Value="user.Password" Style="width: 100%;" />
                            <ValidationMessage For="@(() => user.Password)" />
                        </div>

                        <div class="form-group">
                            <label for="role">Role</label>
                            <RadzenDropDown id="role"
                                            Data="@roles"
                                            TextProperty="RoleName"
                                            ValueProperty="RoleID"
                                            @bind-Value="user.RoleID"
                                            Placeholder="Select a Role"
                                            Style="width: 100%;" />
                            <ValidationMessage For="@(() => user.RoleID)" />
                        </div>

                        <div class="form-group">
                            <RadzenButton Text="Create User" type="submit" ButtonStyle="ButtonStyle.Primary" Style="width: 100%;" />
                        </div>
                    </EditForm>
                </div>

                <RadzenFieldset AllowCollapse="true" Text="ALL USERS" Icon="profile">
                <div class="custom-fieldset">
                    <h3>View Users</h3>
                    <RadzenGrid Data="@users" TItem="User" AllowPaging="true" PageSize="5" ShowPagingSummary="true" Style="margin-top: 20px;">
                        <Columns>
                            <RadzenGridColumn TItem="User" Property="UserName" Title="Username" />
                            <RadzenGridColumn TItem="User" Property="FullName" Title="Full Name" />
                            <RadzenGridColumn TItem="User" Title="Actions" Width="150px">
                                <Template Context="user">
                                    <div class="grid-actions">
                                        <RadzenButton Text="Reset Password" Icon="key" ButtonStyle="ButtonStyle.Info"
                                                      Click="() => OpenResetPasswordDialog(user.UserID)" />
                                        <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="() => DeleteUser(user.UserID)" />
                                    </div>
                                </Template>
                            </RadzenGridColumn>
                        </Columns>
                    </RadzenGrid>
                </div>
                </RadzenFieldset>
            </div>
        </div>
    </div>
}

@code {
    private User user = new User();
    private List<User> users = new List<User>();
    private List<Role> roles = new List<Role>();
    public bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
            isLoading = true;
            await LoadDataAsync();

            isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            users = (await UserService.GetUsersAsync()).ToList();
            roles = (await UserService.GetRolesAsync()).ToList();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"Failed to load data: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private void AddUser()
    {
        try
        {
            isLoading = true;
            authService.AddUser(user);
            LoadDataAsync();
            Notify.ShowNotification("Success", "User added successfully.", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"Failed to add user. {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void DeleteUser(int userId)
    {
        try
        {
            authService.DeleteUser(userId);
            LoadDataAsync();
            Notify.ShowNotification("Success", "User deleted successfully.", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"Failed to delete user. {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenResetPasswordDialog(int userId)
    {
        var result = await DialogService.OpenAsync<ResetPasswordDialog>(
            "Reset User Password",
            new Dictionary<string, object>() { { "UserId", userId } },
            new DialogOptions() { Width = "500px", CloseDialogOnOverlayClick = true }
        );
    }

    async void OnOpenUserDialog() => await OpenUserLogsDialog();

}
