@page "/user-role-management"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE.MainLayout
@using CORE.SERVICE.MainLayout.Module
@using CORE.SERVICE.NOTIFICATION
@inject UserService UserService
@inject NotificationMessageService Notify

<style>
    .user-role-management {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .user-selection-panel, .role-management-panel {
        flex: 1;
        min-width: 300px;
    }

    .user-fieldset, .role-fieldset {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
    }

    .section-title {
        margin-top: 20px;
        font-size: 18px;
        color: #666;
    }

    .menu-grid {
        margin-top: 10px;
    }

        .menu-grid .rz-cell {
            padding: 10px;
        }

        .menu-grid .rz-header-cell {
            background-color: #f9f9f9;
            font-weight: bold;
            padding: 12px 10px;
        }

        .menu-grid .rz-row {
            border-bottom: 1px solid #e0e0e0;
        }
</style>

<RadzenNotification />
<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <RadzenFieldset Text="User Role Management" Icon="role">
        <div class="user-role-management">

            <div class="user-selection-panel">
                <RadzenFieldset Legend="Users" class="user-fieldset">
                   <RadzenDropDown TValue="int?"
                @bind-Value="@selectedUser"
                Data="@users"
                TextProperty="UserName"
                ValueProperty="UserID"
                Change="@(async (object args) => await OnUserSelected(args))"
                Placeholder="Select a user"
                Style="width: 100%;" />
                </RadzenFieldset>
            </div>

            <div class="role-management-panel">
                <RadzenFieldset Legend="Role Management" Disabled="@(!selectedUser.HasValue)" class="role-fieldset">
                    @if (selectedUser.HasValue)
                    {
                        <RadzenDropDown TValue="int?"
                @bind-Value="@selectedRole"
                Data="@roles"
                TextProperty="RoleName"
                ValueProperty="RoleID"
                Change="@(async (object args) => await OnRoleSelected(args))"
                Placeholder="Select a role"
                Style="margin-bottom: 20px; width: 100%;" />

                        @if (selectedRole.HasValue)
                        {
                            <h4 class="section-title">Menu Access</h4>
                            <RadzenDataGrid TItem="MenuItem" Data="@allMenus" class="menu-grid">
                                <Columns>
                                    <RadzenDataGridColumn TItem="MenuItem" Property="Text" Title="Menu" />
                                    <RadzenDataGridColumn TItem="MenuItem" Title="Can Access">
                                        <Template Context="menu">
                                            <RadzenSwitch TValue="bool"
                                                          Value="@(menuAccessDict.ContainsKey(menu.MenuID) && menuAccessDict[menu.MenuID])"
                                                          Change="@(async (bool val) => await UpdateAccess(menu.MenuID, val))" />
                                        </Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        }
                    }
                </RadzenFieldset>
            </div>

        </div>
    </RadzenFieldset>
}

@code {
    private IEnumerable<User> users = Enumerable.Empty<User>();
    private IEnumerable<Role> roles = Enumerable.Empty<Role>();
    private IEnumerable<MenuItem> allMenus = Enumerable.Empty<MenuItem>();
    private Dictionary<int, bool> menuAccessDict = new();
    private int? selectedUser;
    private int? selectedRole;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            users = await UserService.GetUsersAsync();
            roles = await UserService.GetRolesAsync();
            allMenus = await UserService.GetMenusAsync();
            menuAccessDict = allMenus.ToDictionary(menu => menu.MenuID, menu => false);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error loading data: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

   private Task OnUserSelected(object args)
{
    selectedRole = null;
    menuAccessDict = allMenus.ToDictionary(m => m.MenuID, m => false);

    if (args is int id)
        selectedUser = id;
    else if (args != null && int.TryParse(args.ToString(), out var parsed))
        selectedUser = parsed;
    else
        selectedUser = null;

    StateHasChanged();
    return Task.CompletedTask;
}

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; }

    private int loggedInUserId;

    private async Task OnRoleSelected(object args)
    {
        if (args == null || !selectedUser.HasValue) return;

        if (!int.TryParse(args.ToString(), out int roleId) || roleId <= 0)
        {
            Notify.ShowNotification("Invalid role selected.");
            return;
        }

        selectedRole = roleId;

        try
        {
            await UserService.UpdateUserRoleAsync(
                selectedUser.Value,
                selectedRole.Value,
                loggedInUserId);

            var menuAccess = await UserService.GetMenuAccessAsync(selectedRole.Value);

            foreach (var menu in allMenus)
                menuAccessDict[menu.MenuID] = menuAccess
                    .Any(ma => ma.MenuID == menu.MenuID && ma.CanAccess);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error updating role: " + ex.Message);
        }
    }

    private async Task UpdateAccess(int menuId, bool canAccess)
    {
        try
        {
            isLoading = true;
            var access = new MenuAccess
            {
                RoleID = selectedRole!.Value,
                MenuID = menuId,
                CanAccess = canAccess
            };

            await UserService.UpdateMenuAccessAsync(access);
            menuAccessDict[menuId] = canAccess;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error updating access: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}