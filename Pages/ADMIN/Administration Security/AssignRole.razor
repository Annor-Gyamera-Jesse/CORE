@page "/user-role-management"
@using CORE.MODEL
@using CORE.SERVICE.MainLayout
@using CORE.SERVICE.MainLayout.Module
@inject UserService UserService

<h3>User Role Management</h3>

<div class="row">
    <div class="col-md-4">
        <RadzenFieldset Legend="Users">
            <RadzenDropDown @bind-Value="@selectedUser" Data="@users" TextProperty="UserName" ValueProperty="UserID"
                            Change="@(args => OnUserSelected(args))" Placeholder="Select a user" Style="width: 100%;" />
        </RadzenFieldset>
    </div>

    <div class="col-md-8">
        <RadzenFieldset Legend="Management" Disabled="@(!selectedUser.HasValue)">
            @if (selectedUser.HasValue)
            {
                <RadzenDropDown @bind-Value="@selectedRole" Data="@roles" TextProperty="RoleName" ValueProperty="RoleID"
                                Change="@(args => OnRoleSelected(args))" Placeholder="Select a role" Style="margin-bottom: 20px; width: 100%;" />

                @if (selectedRole.HasValue)
                {
                    <h4>Menu Access</h4>
                    <RadzenGrid TItem="MenuItem" Data="@allMenus">
                        <Columns>
                            <RadzenGridColumn TItem="MenuItem" Property="Text" Title="Menu" />
                            <RadzenGridColumn TItem="MenuItem" Title="Can Access">
                                <Template Context="menu">
                                    <RadzenSwitch TValue="bool" Value="@(menuAccessDict[menu.MenuID])"
                                                  Change="@(args => UpdateAccess(menu.MenuID, args))" />

                                </Template>
                            </RadzenGridColumn>
                        </Columns>
                    </RadzenGrid>
                }
            }
        </RadzenFieldset>
    </div>
</div>

@code {
    private IEnumerable<User> users;
    private IEnumerable<Role> roles;
    private IEnumerable<MenuItem> allMenus;
    private Dictionary<int, bool> menuAccessDict; // To track access for each menu
    private int? selectedUser;
    private int? selectedRole;

    protected override async Task OnInitializedAsync()
    {
        users = await UserService.GetUsersAsync();
        roles = await UserService.GetRolesAsync();
        allMenus = await UserService.GetMenusAsync(); // Get all menus for display
        menuAccessDict = allMenus.ToDictionary(menu => menu.MenuID, menu => false); // Initialize access to false
    }

    private async Task OnUserSelected(object args)
    {
        selectedUser = Convert.ToInt32(args);
        selectedRole = null; // Reset the selected role when a new user is selected

        // Reset menu access tracking to false
        menuAccessDict = allMenus.ToDictionary(menu => menu.MenuID, menu => false);

        StateHasChanged(); // Update the UI
    }

    private async Task OnRoleSelected(object args)
    {
        selectedRole = Convert.ToInt32(args);
        if (selectedRole.HasValue)
        {
            var menuAccess = await UserService.GetMenuAccessAsync(selectedRole.Value);

            // Initialize menu access dictionary based on selected role
            foreach (var menu in allMenus)
            {
                menuAccessDict[menu.MenuID] = menuAccess.Any(ma => ma.MenuID == menu.MenuID && ma.CanAccess);
            }

            StateHasChanged(); // Update the UI
        }
    }

    private async Task UpdateAccess(int menuId, bool canAccess)
    {
        var access = new MenuAccess
            {
                RoleID = selectedRole.Value,
                MenuID = menuId,
                CanAccess = canAccess
            };

        await UserService.UpdateMenuAccessAsync(access);
        menuAccessDict[menuId] = canAccess; // Update the dictionary
        StateHasChanged(); // Update the UI
    }
}
