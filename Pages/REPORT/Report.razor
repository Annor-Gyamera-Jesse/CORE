@page "/report"
@inject AuthService authService
@inject NavigationManager NavigationManager
@inject Microsoft.JSInterop.IJSRuntime JS
@using CORE.MODEL
@using CORE.SERVICE

<RadzenGrid TItem="ReportViewPage" Data="@reportPages">
    <Columns>
        <RadzenGridColumn TItem="ReportViewPage" Property="Title" Title="Title" />
        <RadzenGridColumn TItem="ReportViewPage" Property="Description" Title="Description" />
        <RadzenGridColumn TItem="ReportViewPage">
            <Template Context="page">
                <RadzenLink @onclick="() => NavigateToExamsPage()">Print Exams Reports</RadzenLink>
            </Template>
        </RadzenGridColumn>
    </Columns>
</RadzenGrid>


@code {
    List<ReportViewPage> reportPages;

    protected override async Task OnInitializedAsync()
    {
        // Fetch data from the database using the service
        reportPages = await authService.GetAllReportViewPagesAsync();
    }

    protected async Task NavigateToExamsPage()
    {
        Console.WriteLine("Navigating to exams page..."); 
        await JS.InvokeVoidAsync("open", "/reportexams", "_blank");
        // NavigationManager.NavigateTo("/reportexams");
    }
}
