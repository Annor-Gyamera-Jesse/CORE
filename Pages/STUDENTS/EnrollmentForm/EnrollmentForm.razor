@page "/enrollment-form"
@inject AuthService authService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
@using CORE.MODEL
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using Radzen

<RadzenNotification />

<div class="card" style="padding: 20px; max-width: 600px; margin: auto;">
    <h3 style="text-align:center; margin-bottom:20px;">Enrollment Form PDF</h3>

    <RadzenButton Text="Download Enrollment Form PDF" Icon="save_alt"
                  Click="@DownloadEnrollmentForm"
                  Style="width: 100%; margin-bottom: 10px;" />
</div>

@code {
    private async Task DownloadEnrollmentForm()
    {
        try
        {
            var (companyName, schoolName, logoBase64) = await authService.GetPdfLoginScreenDetailsAsync();

            await JSRuntime.InvokeVoidAsync("downloadEnrollmentFormPdf",
                                           companyName,
                                           schoolName,
                                           logoBase64,
                                           DateTime.Now.ToString("dd MMM yyyy"));

            Notify.ShowNotification("Enrollment Form PDF generated successfully.", "", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error generating PDF: {ex.Message}", "", NotificationSeverity.Error);
        }
    }
}
