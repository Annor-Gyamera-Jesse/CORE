@page "/core/pages/students/view-students"
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@inject AuthService authService
@inject NotificationService NotificationService
@using CORE.SERVICE.NOTIFICATION
@inject IJSRuntime jsRuntime
<style>
    .text-blue {
    color: blue;
    }

    .text-red {
    color: red;
    }

    .student-list-container {
    max-width: 300px;
    float: left;
    margin-right: 20px;
    }

    .form-container {
    margin-left: 320px;
    }

    .input-group {
    margin-bottom: 15px;
    }

    /* PRINT STUDENT REPOR */
    .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    }

    .right-align {
    margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
    height: 60px; /* Adjust the height to your preference */
    padding: 5px 15px; /* Reduce padding */
    }

    /* Additional styling if needed */
    .compact-header .rz-header-title {
    font-size: 18px; /* Make the title smaller */
    }

    .custom-background {
    background-color: green !important;
    }
</style>

<LoadingSpinner Visible="isLoading" />
<h3 class="text-xl font-bold mb-4">Students and Their Classes</h3>
@if (!isLoading)
{
   
    <RadzenHeader title="Set School Fees Payment" class="header-container compact-header">
        <RadzenFieldset Text="TOOL COMPONENT" class="right-align">
                <RadzenDropDown @bind-Value="selectedClass"
                                Data="@classIds"
                                Placeholder="Filter by Class"
                                Style="width: 200px"
                                Change="@(args => ApplyFilters())"
                                AllowClear="true" />

                <RadzenTextBox @bind-Value="searchTerm"
                               Placeholder="Search by name..."
                               Style="width:200px; margin-left:10px"
                               Change="@(args => ApplyFilters())" />

            <RadzenButton @onclick="@AutoGraduate"
                          Text="Click To Auto Graduate"
                          Style="margin-bottom: 10px;"
                          ButtonStyle="ButtonStyle.Danger"
                          Icon="school"
                          Disabled="@(!_hasPendingGraduates)" />
        </RadzenFieldset>
      </RadzenHeader>

    <RadzenDataGrid Data="@filteredStudents" AllowPaging="true" PageSize="20" TItem="Student" Class="w-full">
        <Columns>
            <RadzenDataGridColumn TItem="Student" Property="StudentID" Title="ID" />
            <RadzenDataGridColumn TItem="Student" Property="StudentFirstName" Title="First Name" />
            <RadzenDataGridColumn TItem="Student" Property="StudentLastName" Title="Last Name" />
            <RadzenDataGridColumn TItem="Student" Property="ClassID" Title="Class ID" />

            <RadzenDataGridColumn TItem="Student" Title="Actions">
                <Template Context="student">
                    <RadzenButton Text="Delete"
                                  Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="@(async () => await DeleteStudent(student.StudentID))" />
                </Template>
            </RadzenDataGridColumn>

        </Columns>
    </RadzenDataGrid>
}

@code {
    private List<Student> students = new();
    private List<Student> filteredStudents = new();
    private string selectedClass;
    private List<string> classIds = new();
    public bool isLoading = false;
    private string searchTerm = string.Empty;
    private bool _hasPendingGraduates = false;
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            var username = await jsRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");

            if (string.IsNullOrWhiteSpace(username))
            {
                NotificationService.Notify(NotificationSeverity.Error,
                "User Error", "User not logged in or session expired.");
                return;
            }

            var user = await authService.GetUserByUsernameAsync(username);
            if (user == null)
            {
                NotificationService.Notify(NotificationSeverity.Warning,
                   "User Error", "User not found.");
                return;
            }

            userId = user.UserID;
            // Check on page load whether button should be enabled
            _hasPendingGraduates = await authService.HasPendingJHS3GraduatesAsync();
            students = await authService.GetAllStudentsAsync();
            classIds = students.Select(s => s.ClassID).Distinct().OrderBy(x => x).ToList();

            // Initial sort applied here
            filteredStudents = students
             .OrderBy(s => s.ClassID)
             .ThenBy(s => s.StudentFirstName)
             .ThenBy(s => s.StudentLastName)
             .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching students: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteStudent(int studentId)
    {
        try
        {
            isLoading = true;
            await authService.DeleteStudentAsync(studentId);

            // Remove from local list so UI refreshes
            students.RemoveAll(s => s.StudentID == studentId);
            filteredStudents.RemoveAll(s => s.StudentID == studentId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting student: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        if (isLoading) return;

        IEnumerable<Student> query = students;

        // Filter by class
        if (!string.IsNullOrEmpty(selectedClass))
        {
            query = query.Where(s => s.ClassID == selectedClass);
        }

        // Filter by name
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var lowerSearch = searchTerm.ToLower();
            query = query.Where(s =>
                (!string.IsNullOrEmpty(s.StudentFirstName) && s.StudentFirstName.ToLower().Contains(lowerSearch)) ||
                (!string.IsNullOrEmpty(s.StudentLastName) && s.StudentLastName.ToLower().Contains(lowerSearch)));
        }

        // Final sorted list
        filteredStudents = query
            .OrderBy(s => s.ClassID)
            .ThenBy(s => s.StudentFirstName)
            .ThenBy(s => s.StudentLastName)
            .ToList();
    }


    private void FilterByClass()
    {
        if (isLoading) return; // Prevent filtering while loading
        if (string.IsNullOrEmpty(selectedClass) && filteredStudents.Count == students.Count)
        {
            return; // No filtering needed
        }
        try
        {
            isLoading = true;
            if (!string.IsNullOrEmpty(selectedClass))
            {
                filteredStudents = students.Where(s => s.ClassID == selectedClass).ToList();
            }
            else
            {
                filteredStudents = new List<Student>(students);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error filtering students: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AutoGraduate()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var count = await authService.AutoGraduateAsync(userId);

            if (count > 0)
            {
                NotificationService.Notify(NotificationSeverity.Success,
                    "Graduation Complete", $"{count} student(s) graduated successfully.");

                students = await authService.GetAllStudentsAsync();
                _hasPendingGraduates = await authService.HasPendingJHS3GraduatesAsync();
                ApplyFilters();
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Warning,
                    "Nothing to Graduate", "No JHS3 students found pending graduation.");
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Graduation Failed", ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
