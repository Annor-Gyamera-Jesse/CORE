    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            // Fetch the logged-in user's ID
            var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", new object[] { "userName" });
            var user = await authService.GetUserByUsernameAsync(username);
            if (user != null)
            {
                userId = user.UserID;
            }

            courseList = await authService.GetLessonNotSchoolCoursesAsync();
            // Fetch list of classes
            var classes = await authService.GetClassesAsync();
            classList = classes.Select(c => new Class { ClassID = c }).ToList();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"OnInitializedAsync. {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
    // Resets the form
    void ResetFields()
