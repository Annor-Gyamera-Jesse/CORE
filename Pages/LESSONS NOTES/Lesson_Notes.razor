    List<Class> classList = new List<Class>();
    string classId = "";
    List<string> lessonNoteFields = new List<string>
    {
        "Strand", "SubStrand", "ContentStandard", "Indicator",
        "TeachingLearningResources", "TeachingLearningResourcePreparationNotes",
        "SourcesLearningResources", "LearningGroup", "LearnerExpectation",
        "ImportantGradeExpectation", "LearningOutcomes", "FormofAssessment",
        "LearnerEntryBehavior", "SequenceofLesson"
    };

    List<DynamicField> selectedFields = new List<DynamicField>();
    string selectedField;
    private bool isLoading = false;
    int userId;
    List<SchoolCourse> courseList = new List<SchoolCourse>();

    public class DynamicField
    {
        public string Name { get; set; }
        public string Value { get; set; }
    }

    async void SubmittedLessonNotesDialog()
    {
        await OpenSubmittedLessonNotesDialog();
    }

    async void AssesmentDialog()
    {
        await OpenAssesmentsDialog();
    }

    // Handles the selection of fields from the left
    void OnFieldSelect(object value)
    {
        if (!string.IsNullOrEmpty(selectedField))
        {
            // Check if the field is already in the list before adding
            if (!selectedFields.Any(f => f.Name == selectedField))
            {
                selectedFields.Add(new DynamicField { Name = selectedField, Value = "" });
            }
        }
    }

    // Adds a new text field for the selected item
    void AddNewTextField(string fieldName)
    {
        // Find existing field and add new entry if not already present
        var existingField = selectedFields.FirstOrDefault(f => f.Name == fieldName);
        if (existingField != null)
        {
            selectedFields.Add(new DynamicField { Name = fieldName, Value = "" });
        }
    }

    // Removes a text field based on the field name
    void RemoveTextField(string fieldName)
    {
        var fieldToRemove = selectedFields.FirstOrDefault(f => f.Name == fieldName);
        if (fieldToRemove != null)
        {
            selectedFields.Remove(fieldToRemove);
        }
    }

    // Submit logic
    async Task SubmitLessonNote()
    {
        try
        {
            isLoading = true;

            // Map selectedFields back to lessonNote
            lessonNote.Strand = selectedFields.FirstOrDefault(f => f.Name == "Strand")?.Value;
            lessonNote.SubStrand = selectedFields.FirstOrDefault(f => f.Name == "SubStrand")?.Value;
            lessonNote.ContentStandard = selectedFields.FirstOrDefault(f => f.Name == "ContentStandard")?.Value;
            lessonNote.Indicator = selectedFields.FirstOrDefault(f => f.Name == "Indicator")?.Value;
            lessonNote.TeachingLearningResources = selectedFields.FirstOrDefault(f => f.Name == "TeachingLearningResources")?.Value;
            lessonNote.TeachingLearningResourcePreparationNotes = selectedFields.FirstOrDefault(f => f.Name == "TeachingLearningResourcePreparationNotes")?.Value;
            lessonNote.SourcesLearningResources = selectedFields.FirstOrDefault(f => f.Name == "SourcesLearningResources")?.Value;
            lessonNote.LearningGroup = selectedFields.FirstOrDefault(f => f.Name == "LearningGroup")?.Value;
            lessonNote.LearnerExpectation = selectedFields.FirstOrDefault(f => f.Name == "LearnerExpectation")?.Value;
            lessonNote.ImportantGradeExpectation = selectedFields.FirstOrDefault(f => f.Name == "ImportantGradeExpectation")?.Value;
            lessonNote.LearningOutcomes = selectedFields.FirstOrDefault(f => f.Name == "LearningOutcomes")?.Value;
            lessonNote.FormofAssessment = selectedFields.FirstOrDefault(f => f.Name == "FormofAssessment")?.Value;
            lessonNote.LearnerEntryBehavior = selectedFields.FirstOrDefault(f => f.Name == "LearnerEntryBehavior")?.Value;
            lessonNote.SequenceofLesson = selectedFields.FirstOrDefault(f => f.Name == "SequenceofLesson")?.Value;

            // Assign UserId and ClassID to lessonNote object
            lessonNote.UserId = userId;
            lessonNote.ClassID = classId;

            // Perform the database operation
            var result = await authService.AddLessonNoteAsync(lessonNote);

            if (result > 0)
            {
                Notify.ShowNotification("Success", "Lesson note submitted successfully", NotificationSeverity.Success);

                // Reset the form fields
                lessonNote = new LessonNote();  // Clear the lessonNote object
                selectedFields.Clear();
            }
            else
            {
                Notify.ShowNotification("Error", "Failed to submit lesson note", NotificationSeverity.Error);
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"An error occurred while submitting the lesson note: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

