@page "/lessonnote"
@using CORE.Pages.LESSON_NOTE
@using CORE.MODEL
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@using CORE.Tool_Components
@inject AuthService authService
@inject IJSRuntime JSRuntime
@inherits Lesson_Notes_Codebehind
@inject NotificationMessageService Notify

<style>
    .rz-fieldset-content {
        padding: 0;
    }
    .right-panel {
        position: absolute;
        top: 40px;
        right: 20px;
        width: 200px;
        height: 400px;
        border-radius: 8px;
    }
    .container {
        max-width: 800px;
        margin: auto;
        background: #f9f9f9;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

    .row {
        margin-bottom: 15px;
    }

    .form-control {
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
    }
</style>

<LoadingSpinner Visible="isLoading"/>
@if (!isLoading)
{
    <RadzenFieldset Text="SUBMIT LESSON NOTE" Style="background: #fff; border: none;">
        <div class="container">
            <div class="row mb-3">
                <div class="col-md-4">
                    <RadzenLabel Text="Course Name:" Associated="lessonNote.SchoolCourse" />
                    <RadzenDropDown @bind-Value="lessonNote.SchoolCourse" Data="@courseList" TextProperty="SchoolCourseName" ValueProperty="SchoolCourseName" Style="width: 100%;" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <RadzenLabel Text="Topic:" Associated="lessonNote.Topic" />
                    <RadzenTextBox @bind-Value="lessonNote.Topic" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <RadzenLabel Text="Objectives:" Associated="lessonNote.OBJECTIVES" />
                    <RadzenTextArea @bind-Value="lessonNote.OBJECTIVES" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <RadzenLabel Text="TLMTLA:" Associated="lessonNote.TLMTLA" />
                    <RadzenTextArea @bind-Value="lessonNote.TLMTLA" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <RadzenLabel Text="Introduction:" Associated="lessonNote.INTRODUCTION" />
                    <RadzenTextArea @bind-Value="lessonNote.INTRODUCTION" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <RadzenLabel Text="Core Points:" Associated="lessonNote.COREPOINTS" />
                    <RadzenTextArea @bind-Value="lessonNote.COREPOINTS" class="form-control" />
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-12">
                    <RadzenLabel Text="Evaluation Remarks:" Associated="lessonNote.EVALUATIONREMARKS" />
                    <RadzenTextArea @bind-Value="lessonNote.EVALUATIONREMARKS" class="form-control" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <RadzenButton Text="Submit" Icon="check" ButtonStyle="ButtonStyle.Primary" Click="@SubmitLessonNote" Style="width: 100%;" />
                </div>
                <div class="col-md-6">
                    <RadzenButton Text="Reset" Icon="refresh" ButtonStyle="ButtonStyle.Secondary" Click="@ResetFields" Style="width: 100%;" />
                </div>
            </div>
        </div>
    </RadzenFieldset>

    <div class="right-panel">
        <div class="row mt-2">
            <div class="col-md">
                <ToolPanelComponent OnOpenSubmittedLessonNotesDialog="SubmittedLessonNotesDialog" OnOpenAssesmentDialog="AssesmentDialog" />
            </div>
        </div>
    </div>
}

@code {
    LessonNote lessonNote = new LessonNote();
    List<SchoolCourse> courseList = new List<SchoolCourse>();
    int userId;
    private bool isLoading = false;

    async void SubmittedLessonNotesDialog()
    {
        await OpenSubmittedLessonNotesDialog();
    }

    async void AssesmentDialog()
    {
        await OpenAssesmentsDialog();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;

            // Fetch the logged-in user's ID
            var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", new object[] { "userName" });
            var user = await authService.GetUserByUsernameAsync(username);
            if (user != null)
            {
                userId = user.UserID;
            }

            courseList = await authService.GetLessonNotSchoolCoursesAsync();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"OnInitializedAsync. {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task SubmitLessonNote()
    {
        try
        {
            isLoading = true;

            // Assign UserId to lessonNote object
            lessonNote.UserId = userId;

            var result = await authService.AddLessonNoteAsync(lessonNote);

            if (result > 0)
            {
                lessonNote = new LessonNote();
                Notify.ShowNotification("", "Lesson note submitted successfully!", NotificationSeverity.Success);
            }
            else
            {
                Notify.ShowNotification("Error", "Failed to submit lesson note", NotificationSeverity.Info);
            }
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"An error occurred while submitting the lesson note: {ex.Message}", NotificationSeverity.Info);
        }
        finally
        {
            isLoading = false;
        }
    }

    void ResetFields()
    {
        lessonNote = new LessonNote();
        Notify.ShowNotification("", "Page reset successfully.", NotificationSeverity.Success);
    }
}