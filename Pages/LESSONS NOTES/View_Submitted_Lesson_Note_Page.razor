@page "/viewsubmittedlessonnote"
@using CORE.Pages.LESSON_NOTE
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@inject AuthService lessonNoteService
@using CORE.MODEL
@using CORE.SERVICE.NOTIFICATION
@inject DialogService DialogService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime
<RadzenNotification />

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="container my-5">
        <div class="mb-4 d-flex align-items-center">
            <RadzenDatePicker @bind-Value="fromDate" Placeholder="From Date" Style="width: 200px;" />
            <RadzenDatePicker @bind-Value="toDate" Placeholder="To Date" Style="width: 200px; margin-left: 10px;" />
            <RadzenButton Text="Filter" Click="@FilterLessonNotes" ButtonStyle="ButtonStyle.Primary" Style="margin-left: 10px;" />
        </div>

        @if (lessonNotes != null && lessonNotes.Any())
        {
            <div class="row">
                @foreach (var note in lessonNotes)
                {
                    <div class="col-md-4 mb-4">
                        <div class="shadow-sm rounded-3 p-3 bg-white border h-100 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="mb-2 text-primary">@note.UserName</h5>
                                <p class="text-muted mb-2"><strong>Course:</strong> @note.SchoolCourse</p>

                                <RadzenDropDown @bind-Value="note.Status"
                                                Data="Enum.GetValues(typeof(Lesson_Note_Dialog_Status)).Cast<Lesson_Note_Dialog_Status>()"
                                                Style="width: 100%; border-radius: 6px;"
                                                Change="@(args => ValidateStatusSelection(note))" />

                                <RadzenButton Text="View" Icon="visibility" Click="@(args => ViewLessonNote(note))" ButtonStyle="ButtonStyle.Info" Style="margin-top: 10px; width: 100%;" />
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end mt-4">
                <RadzenButton Click="CloseForm" ButtonStyle="ButtonStyle.Danger" Text="Close" Icon="close" Style="margin-right: 10px; width: 120px;" />
                <RadzenButton Click="OnDone" ButtonStyle="ButtonStyle.Info" Text="Done" Icon="check" Style="width: 120px;" />
            </div>
        }
        else
        {
            <div class="alert alert-info mt-5" role="alert" style="border-radius: 8px;">
                No lesson notes have been submitted yet.
            </div>
        }
    </div>

    @if (selectedLessonNote != null)
    {
        <RadzenFieldset Text="Lesson Note Details" Icon="book" Style="margin-top: 20px; border-radius: 8px; background: #f8f9fa;">
            <dl class="row">
                <dt class="col-sm-4">User:</dt>
                <dd class="col-sm-8">@selectedLessonNote.UserName</dd>
                <dt class="col-sm-4">School Course:</dt>
                <dd class="col-sm-8">@selectedLessonNote.SchoolCourse</dd>
                <dt class="col-sm-4">Strand:</dt>
                <dd class="col-sm-8">@selectedLessonNote.Strand</dd>
                <dt class="col-sm-4">SubStrand:</dt>
                <dd class="col-sm-8">@selectedLessonNote.SubStrand</dd>
                <dt class="col-sm-4">Sequence of Lesson:</dt>
                <dd class="col-sm-8">@selectedLessonNote.SequenceofLesson</dd>
                <dt class="col-sm-4">Content Standard:</dt>
                <dd class="col-sm-8">@selectedLessonNote.ContentStandard</dd>
                <dt class="col-sm-4">Indicator:</dt>
                <dd class="col-sm-8">@selectedLessonNote.Indicator</dd>
                <dt class="col-sm-4">Teaching Learning Resources:</dt>
                <dd class="col-sm-8">@selectedLessonNote.TeachingLearningResources</dd>
                <dt class="col-sm-4">Preparation Notes:</dt>
                <dd class="col-sm-8">@selectedLessonNote.TeachingLearningResourcePreparationNotes</dd>
                <dt class="col-sm-4">Sources:</dt>
                <dd class="col-sm-8">@selectedLessonNote.SourcesLearningResources</dd>
                <dt class="col-sm-4">Learning Group:</dt>
                <dd class="col-sm-8">@selectedLessonNote.LearningGroup</dd>
                <dt class="col-sm-4">Learner Expectation:</dt>
                <dd class="col-sm-8">@selectedLessonNote.LearnerExpectation</dd>
                <dt class="col-sm-4">Grade Expectation:</dt>
                <dd class="col-sm-8">@selectedLessonNote.ImportantGradeExpectation</dd>
                <dt class="col-sm-4">Learning Outcomes:</dt>
                <dd class="col-sm-8">@selectedLessonNote.LearningOutcomes</dd>
                <dt class="col-sm-4">Form of Assessment:</dt>
                <dd class="col-sm-8">@selectedLessonNote.FormofAssessment</dd>
                <dt class="col-sm-4">Entry Behavior:</dt>
                <dd class="col-sm-8">@selectedLessonNote.LearnerEntryBehavior</dd>
            </dl>
            <RadzenButton Click="ClearSelectedLessonNote" ButtonStyle="ButtonStyle.Secondary" Text="Close" Style="margin-top: 10px;" />
        </RadzenFieldset>
    }
}


@code {
    private IEnumerable<TEACHERSLESSONNOTES> lessonNotes;
    private bool isLoading = false;
    private TEACHERSLESSONNOTES selectedLessonNote; // Holds the currently selected lesson note for viewing
    private DateTime? fromDate;
    private DateTime? toDate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            lessonNotes = await lessonNoteService.GetSubmittedLessonNotesAsync();
        }
        catch (Exception mistake)
        {
            Notify.ShowNotification("Error", $"OnInitializedAsync. {mistake.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
    private async Task ValidateStatusSelection(TEACHERSLESSONNOTES note)
    {
        if (!Enum.IsDefined(typeof(Lesson_Note_Dialog_Status), note.Status) || note.Status == 0)
        {
            note.Status = Lesson_Note_Dialog_Status.New;
        }
        else if (note.Status != Lesson_Note_Dialog_Status.New)
        {
            string userIdStr = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userID");
            var userId = Convert.ToInt32(userIdStr);

            note.UpdatedBy = userId;
            note.UpdatedOn = DateTime.Now;

            await lessonNoteService.UpdateLessonNoteStatusAsync(note, userId);

            // Reload lesson notes (only New ones will remain)
            lessonNotes = await lessonNoteService.GetSubmittedLessonNotesAsync();

            StateHasChanged();
        }
    }



    async Task OnDone()
    {
        try
        {
            isLoading = true;

            string userIdStr = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", new object[] { "userID" });

            if (string.IsNullOrWhiteSpace(userIdStr))
            {
                Notify.ShowNotification("Error", "User ID is missing.", NotificationSeverity.Error);
                return;
            }

            var userId = Convert.ToInt32(userIdStr);

            foreach (var note in lessonNotes)
            {
                if (Enum.IsDefined(typeof(Lesson_Note_Dialog_Status), note.Status) && note.Status != Lesson_Note_Dialog_Status.New)
                {
                    note.UpdatedBy = userId;
                    note.UpdatedOn = DateTime.Now;

                    await lessonNoteService.UpdateLessonNoteStatusAsync(note, userId);
                }
            }

            Notify.ShowNotification("Success", "Lesson notes updated successfully!", NotificationSeverity.Success);

            // 🔄 Refresh notes list so updated ones disappear
            lessonNotes = await lessonNoteService.GetSubmittedLessonNotesAsync();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"Error updating lesson notes: {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    // Selects a lesson note to view its details
    void ViewLessonNote(TEACHERSLESSONNOTES note)
    {
        selectedLessonNote = note;
    }

    // Clears the selected lesson note
    void ClearSelectedLessonNote()
    {
        selectedLessonNote = null;
    }

    private async Task FilterLessonNotes()
    {
        if (fromDate.HasValue && toDate.HasValue)
        {
            isLoading = true;
            try
            {
                lessonNotes = await lessonNoteService.GetLessonNotesByDateRangeAsync(fromDate.Value, toDate.Value);
            }
            finally
            {
                isLoading = false;
            }
        }
        else
        {            
            Notify.ShowNotification("", "Please select both 'from' and 'to' dates.", NotificationSeverity.Info);
        }
    }

    void CloseForm()
    {
        DialogService.Close();
    }
}
