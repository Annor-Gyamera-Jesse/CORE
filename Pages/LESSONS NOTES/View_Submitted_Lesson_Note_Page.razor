@using CORE.Pages.LESSON_NOTE
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@inject AuthService lessonNoteService
@using CORE.MODEL
@using CORE.SERVICE.NOTIFICATION
@inject DialogService DialogService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime

<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
    <div class="container">
        @if (lessonNotes != null && lessonNotes.Any())
        {
            <RadzenGrid Data="@lessonNotes" TItem="LessonNote" AllowPaging="true" PageSize="10" AllowSorting="true" AllowColumnResize="true" EditMode="DataGridEditMode.Single" Style="height: 400px; width: 100%; border-radius: 8px; overflow: hidden;">
                <Columns>
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="UserName" Title="User" />
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="SchoolCourse" Title="School Course" />
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="Topic" Title="Topic" />
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="OBJECTIVES" Title="Objectives" />
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="TLMTLA" Title="TLMTLA" />
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="INTRODUCTION" Title="Introduction" />
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="COREPOINTS" Title="Core Points" />
                    <RadzenGridColumn TItem="LessonNote" Filterable="true" Sortable="true" Property="EVALUATIONREMARKS" Title="Evaluation Remarks" />
                    <RadzenGridColumn TItem="LessonNote" Title="Status">
                        <Template Context="note">
                            <RadzenDropDown @bind-Value="note.Status"
                                            Data="Enum.GetValues(typeof(Lesson_Note_Dialog_Status)).Cast<Lesson_Note_Dialog_Status>()"
                                            Style="width: 100%; border-radius: 4px;" />
                        </Template>
                    </RadzenGridColumn>
                </Columns>
            </RadzenGrid>

            <div class="d-flex justify-content-end mt-3">
                <RadzenButton Click="CloseForm" ButtonStyle="ButtonStyle.Danger" Text="Close" Icon="close" Style="margin-left: 10px; width: 120px;" />
                <RadzenButton Click="OnDone" ButtonStyle="ButtonStyle.Info" Text="Done" Icon="check" Style="margin-left: 10px; width: 120px;" />
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                No lesson notes have been submitted yet.
            </div>
        }
    </div>
}

@code {
    private IEnumerable<LessonNote> lessonNotes;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            lessonNotes = await lessonNoteService.GetSubmittedLessonNotesAsync();
        }
        catch (Exception mistake)
        {
            Notify.ShowNotification("Error", $"OnInitializedAsync. {mistake.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task OnDone()
    {
        try
        {
            isLoading = true;

            string userIdStr = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", new object[] { "userID" });

            if (string.IsNullOrWhiteSpace(userIdStr))
            {
                Notify.ShowNotification("Error", "User ID not found in session storage.", NotificationSeverity.Error);
                return;
            }

            if (!int.TryParse(userIdStr, out int userId))
            {
                Notify.ShowNotification("Error", "Invalid User ID format.", NotificationSeverity.Error);
                return;
            }

            if (lessonNotes == null || !lessonNotes.Any())
            {
                Notify.ShowNotification("Info", "No lesson notes to update.", NotificationSeverity.Info);
                return;
            }

            foreach (var note in lessonNotes)
            {
                await lessonNoteService.UpdateLessonNoteStatusAsync(note, userId);
            }

            Notify.ShowNotification("Info", "Statuses updated successfully!", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification("Error", $"Failed to update statuses. {ex.Message}", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    void CloseForm()
    {
        DialogService.Close();
    }
}
