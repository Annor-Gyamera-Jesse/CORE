@page "/lessonnote/viewsubmittedlessonnote/tab"
@using CORE.SECURITY
@using CORE.SECURITY.LOADER
@inject ContentLoaderTemplate LoaderTemplate

<style>
    form .row {
        /*margin-bottom: 16px;*/
        /* margin-top: 10px;*/
    }

    .rz-fieldset-content {
        padding: 0;
        /*margin-left:2em;*/
    }
</style>


<div class="row">
    <div class="col-md-10">
        <RadzenTabs SelectedIndex="@SelectedTabPage" Change="@OnTabChange">
            <Tabs>
                <RadzenTabsItem Text="LESSON NOTE">
                    <View_Submitted_Lesson_Note_Page />
                </RadzenTabsItem>

                <RadzenTabsItem Text="MARKED BY">
                    <View_Status />
                </RadzenTabsItem>
              
            </Tabs>
        </RadzenTabs>

    </div>
</div>

@code {
    LoadTypeTrigger _loader;
    protected LoadTypeTrigger Loader
    {
        get => _loader;
        set
        {
            _loader = value;
            StateHasChanged();
        }
    }

    int SelectedTabPage = 0;

    void OnTabChange(int newIndex)
    {
        SelectedTabPage = newIndex;
    }
}



