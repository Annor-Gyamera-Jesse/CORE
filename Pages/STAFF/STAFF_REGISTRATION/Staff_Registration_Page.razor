@page "/core/pages/staff/staffregistration/register-staff"
@using CORE.MODEL
@using CORE.MODEL.Department
@using CORE.SERVICE
@inject AuthService authService
@inject Radzen.NotificationService Notify
<RadzenNotification />

<style>
    form .row {
        margin-bottom: 16px;
        margin-top: 10px;
    }

    .rz-fieldset-content {
        padding: 0;
    }

    .form-label {
        padding-top: 8px;
    }

    .form-control {
        margin-bottom: 8px;
    }
</style>

<RadzenFieldset Text="Staff Registration">
    <div class="row">
        <!-- Left Column -->
        <div class="col-md-6">
            <RadzenFieldset Text="Personal Details">
                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="First Name" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.StaffFirstName" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Last Name" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.StaffLastName" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Date of Birth" />
                    </div>
                    <div class="col-md-9">
                        <RadzenDatePicker @bind-Value="newStaff.StaffDateOfBirth" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Gender" />
                    </div>
                    <div class="col-md-9">
                        <RadzenDropDown @bind-Value="newStaff.StaffGender" Data="@(new List<string> { "M", "F", "O" })"
                                        Placeholder="Select Gender" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Address" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.StaffAddress" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Phone Number" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.StaffPhoneNumber" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Email" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.StaffEmail" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Date Hired" />
                    </div>
                    <div class="col-md-9">
                        <RadzenDatePicker @bind-Value="newStaff.DateHired" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Voters ID" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.VotersID" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Health Insurance" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.HealthInsurance" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Ghana Card" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.GhanaCard" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Remarks" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.Remarks" Required="true" class="form-control" />
                    </div>
                </div>
            </RadzenFieldset>
        </div>

        <!-- Right Column -->
        <div class="col-md-6">
            <RadzenFieldset Text="Job Details">
                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Position" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.Position" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Department" />
                    </div>
                    <div class="col-md-9">
                        <RadzenDropDown @bind-Value="newStaff.Department" Data="@departments"
                                        TextProperty="DepartmentName" ValueProperty="DepartmentName"
                                        Placeholder="Select Department" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Employment Status" />
                    </div>
                    <div class="col-md-9">
                        <RadzenDropDown @bind-Value="newStaff.EmploymentStatus" Data="@(new List<string> { "Active", "Suspended", "Terminated" })"
                                        Placeholder="Select Status" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Basic Salary" />
                    </div>
                    <div class="col-md-9">
                        <RadzenNumeric @bind-Value="newStaff.BasicSalary" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Bank Name" />
                    </div>
                    <div class="col-md-9">
                        <RadzenDropDown @bind-Value="newStaff.BankName" Data="@paymentMethods"
                                        Placeholder="Select Bank" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Account Number" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.AccountNumber" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Account Name" />
                    </div>
                    <div class="col-md-9">
                        <RadzenTextBox @bind-Value="newStaff.AccountName" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="Upload Image" />
                    </div>
                    <div class="col-md-9">
                        <InputFile id="staffImage" OnChange="HandleFileChange" key="@inputFileKey" />
                    </div>
                </div>
            </RadzenFieldset>

            <RadzenFieldset Text="SSNIT Details" class="mt-4">
                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="SSNIT" />
                    </div>
                    <div class="col-md-9">
                        <RadzenDropDown @bind-Value="newStaff.SSNIT" Data="@(new List<string> { "Y", "N" })"
                                        Placeholder="Select SSNIT Option" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="PAYE" />
                    </div>
                    <div class="col-md-9">
                        <RadzenNumeric @bind-Value="newStaff.PAYE" Required="true" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3 text-md-end form-label">
                        <RadzenLabel Text="SSNIT Tier 2" />
                    </div>
                    <div class="col-md-9">
                        <RadzenNumeric @bind-Value="newStaff.SSNITTIER2" Required="true" class="form-control" />
                    </div>
                </div>
            </RadzenFieldset>
        </div>
    </div>

    <!-- Emergency Contact Section -->
    <RadzenFieldset Text="Emergency Contact" class="mt-4">
        <div class="row">
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Name" />
            </div>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="newStaff.EmergencyContactName" Required="true" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Relationship" />
            </div>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="newStaff.EmergencyContactRelationship" Required="true" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 text-md-end form-label">
                <RadzenLabel Text="Phone" />
            </div>
            <div class="col-md-9">
                <RadzenTextBox @bind-Value="newStaff.EmergencyContactPhone" Required="true" class="form-control" />
            </div>
        </div>
    </RadzenFieldset>

    <!-- Buttons -->
    <div class="row mt-4">
        <div class="col-md-12 text-end">
            <RadzenButton Text="Submit" Icon="check" ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Success" Click="@SubmitForm" Style="margin-right: 10px;" />
            <RadzenButton Text="Reset" Icon="replay" ButtonStyle="ButtonStyle.Info" Click="@ResetForm" />
        </div>
    </div>
</RadzenFieldset>

@code {
    private Staff newStaff = new Staff();
    private List<Department> departments = new();
    private List<string> paymentMethods = new();
    private List<PaymentCategory> paymentCategories = new();
    private IBrowserFile selectedFile;
    private int inputFileKey = 0;

    protected override async Task OnInitializedAsync()
    {
        departments = await authService.GetDepartmentsAsync();
        paymentMethods = await authService.GetPaymentMethodsAsync();
        paymentCategories = await authService.GetPaymentCategoriesAsync();
    }

    private async Task SubmitForm()
    {
        try
        {
            if (selectedFile != null)
            {
                using var stream = new MemoryStream();
                await selectedFile.OpenReadStream().CopyToAsync(stream);
                newStaff.ImageData = stream.ToArray();
            }

            bool success = await authService.RegisterStaff(newStaff);

            if (success)
            {
                Notify.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Success",
                        Detail = "Staff registered successfully!",
                        Duration = 4000
                    });

                ResetForm();
            }
            else
            {
                Notify.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Warning,
                        Summary = "Warning",
                        Detail = "Registration failed. Please try again.",
                        Duration = 4000
                    });
            }
        }
        catch (Exception ex)
        {
            Notify.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"An error occurred: {ex.Message}",
                    Duration = 6000
                });
        }
    }

    private void ResetForm()
    {
        newStaff = new Staff();
        selectedFile = null;
        inputFileKey++;
    }

    private void HandleFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }
}