@using CORE.Pages.LOADING_COMPONENT
@* ToolComponent Page *@

<style>

    .toolset-btn {
        margin-bottom: 5px;
        width: 100%;
        font-size: 14px
    }
</style>

<LoadingSpinner Visible="isLoading" />
@if (!isLoading)
{
    <div class="row mt-2">
        <RadzenButton Text="Edit Categories" Icon="edit" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Info" Click=@OnEditCategoriesDialog />        
    </div>
    <div class="row mt-2">        
        <RadzenButton Text="Edit PaymentMethod" Icon="money" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Info" Click=@OnManagePaymentMethodsDialog />
    </div>
}
@code {
    private bool isLoading = false;
    [Parameter] public Action OnEditCategoriesDialog { get; set; } 
    [Parameter] public Action OnManagePaymentMethodsDialog { get; set; }

}
