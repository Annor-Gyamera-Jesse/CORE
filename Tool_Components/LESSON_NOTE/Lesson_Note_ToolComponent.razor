
@* ToolComponent Page *@

<style>
    .toolset-container {
        display: flex;
        gap: 10px; /* Adjust the spacing between buttons */
    }

    .toolset-btn {
        font-size: 14px;
        flex: 1; /* Makes both buttons take equal space */
    }
</style>

<div class="toolset-container mt-2">
    <RadzenButton Text="PER TEACHER" Icon="print" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Danger" Click=@OnOpenLessonNoteExportDialog />    
</div>

@code {
    [Parameter] public Action OnOpenLessonNoteExportDialog { get; set; }
}