
<style>
    .toolset-container {
        display: flex;
        gap: 10px; /* Adjust the spacing between buttons */
    }

    .toolset-btn {
        font-size: 14px;
        flex: 1; /* Makes both buttons take equal space */
    }
</style>

<div class="toolset-container mt-2">
    <RadzenButton Text="Manage Teachers Time Table" Icon="assignment" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Secondary" Click=@OnManageTeachersTimeTable />
   @*  <RadzenButton Text="View Teachers Time Table" Icon="task" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Info" Click=@OnTeacherTimeTable /> *@
    <RadzenButton Text="PRINT CLASS TIME TABLE" Icon="print" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Light" Click=@OnNoticeBoard />
</div>



@code {
    [Parameter] public Action OnManageTeachersTimeTable {
        get; set;
    }

    // [Parameter] public Action OnTeacherTimeTable{ get; set; }
    [Parameter]
    public Action OnNoticeBoard { get; set; }
}
