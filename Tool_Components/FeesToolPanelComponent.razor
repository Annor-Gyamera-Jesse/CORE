<style>
    .toolset-container {
        display: flex;
        gap: 10px; /* Adjust the spacing between buttons */
    }

    .toolset-btn {
        font-size: 14px;
        flex: 1; /* Makes both buttons take equal space */
    }
</style>

  <div class="toolset-container mt-2">
        <RadzenButton Text="Export Fees" Icon="money" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Danger" Click=@OnFeesDialog />
        <RadzenButton Text="Export Fees Per Date" Icon="list" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Warning" Click=@OnFeesPerDateDialog />
    <RadzenButton Text="TRANFERS OF FUNDS" Icon="cached" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Info" Click=@OnTransferOfFundsDialog />
    <RadzenButton Text="CASH IN HANDS" Icon="credit_card" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Dark" Click=@OnCashInHandsDialog />
</div>

@code {
    
    [Parameter] public Action OnFeesDialog { get; set; }
    [Parameter] public Action OnTransferOfFundsDialog { get; set; }
    [Parameter] public Action OnCashInHandsDialog { get; set; }
    [Parameter] public Action OnFeesPerDateDialog { get; set; }
   
}
