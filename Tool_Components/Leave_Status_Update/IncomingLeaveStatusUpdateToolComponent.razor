@using CORE.Pages.LOADING_COMPONENT
@* ToolComponent Page *@

<style>

    .toolset-btn {
        margin-bottom: 5px;
        width: 100%;
        font-size: 14px
    }
</style>

<LoadingSpinner Visible="isLoading" />
@if (!isLoading)
{
    <div class="row mt-2">
        <RadzenButton Text="Incoming" Icon="landing" class="toolbar-button-color-default toolset-btn" ButtonStyle="ButtonStyle.Info" Click=@OnIncomingDialog />
    </div>
}
@code {
    private bool isLoading = false;
    [Parameter] public Action OnIncomingDialog { get; set; }

}
