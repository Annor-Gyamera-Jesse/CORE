@using System.Text
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.SERVICE.NOTIFICATION
@inject AuthService authService
@inject NotificationMessageService Notify
@inject IJSRuntime JSRuntime

<RadzenNotification />

<LoadingSpinner Visible="isLoading" />

<div class="card p-4 mx-auto" style="max-width:600px;" hidden="@isLoading">

    <RadzenTextBox Placeholder="Type name to search..."
                   Style="width:100%; margin-bottom:1rem;"
                   Change="OnSearchChanged" />

    <RadzenDropDown Data="@searchResults"
                    TextProperty="DisplayText"
                    ValueProperty="StudentID"
                    @bind-Value="selectedStudentId"
                    Placeholder="Select a Student"
                    Style="width:100%; margin-bottom:1rem;" />

    <RadzenDropDown Data="@terms"
                    TextProperty="Term"
                    ValueProperty="TermID"
                    @bind-Value="selectedTermId"
                    Placeholder="Select a Term"
                    Style="width:100%; margin-bottom:1rem;" />

    <RadzenButton Text="Generate Student Report"
                  Icon="print"
                  Disabled="@IsActionDisabled"
                  Click="GenerateStudentReport"
                  Style="width:100%;" />
</div>

@code {
    private IEnumerable<StudentLookupDto> searchResults = Enumerable.Empty<StudentLookupDto>();
    private IEnumerable<SchoolTerm> terms = Enumerable.Empty<SchoolTerm>();
    private int? selectedStudentId;
    private int? selectedTermId;
    private bool isLoading = true;
    private bool IsActionDisabled => selectedStudentId == null || selectedTermId == null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            terms = await authService.GetAllTermsAsync();
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error fetching terms: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnSearchChanged(object value)
    {
        isLoading = true;
        try
        {
            var term = (value as string)?.Trim();
            searchResults = string.IsNullOrEmpty(term)
                ? Enumerable.Empty<StudentLookupDto>()
                : await authService.SearchAllStudentsAsync(term);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error searching students: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task GenerateStudentReport()
    {
        isLoading = true;
        try
        {
            if (selectedStudentId == null || selectedTermId == null)
            {
                Notify.ShowNotification("Select both a student and a term.", "", NotificationSeverity.Warning);
                return;
            }

            var student = searchResults.FirstOrDefault(s => s.StudentID == selectedStudentId.Value);
            if (student == null)
            {
                Notify.ShowNotification("Student not found.", "", NotificationSeverity.Error);
                return;
            }

            var attendance = (await authService.GetAttendanceByStudentAsync(
                student.StudentFirstName,
                student.StudentLastName,
                student.ClassID
            ))
            .Where(a => a.TermID == selectedTermId.Value) // Filter by selected term
            .ToList();

            if (!attendance.Any())
            {
                Notify.ShowNotification("No attendance records for the selected term.", "", NotificationSeverity.Warning);
                return;
            }

            var sb = new StringBuilder();
            sb.AppendLine("Date,Term,Present");
            foreach (var a in attendance)
            {
                var status = a.EnableSwitch ? "Present" : "Absent";
                sb.AppendLine($"{a.AttendanceDate:yyyy-MM-dd},{a.Term},{status}");
            }

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(bytes);
            var nameOnly = $"{student.StudentFirstName}_{student.StudentLastName}";
            var fileName = $"{nameOnly}_Attendance_Term{selectedTermId}.pdf";

            await JSRuntime.InvokeVoidAsync(
                "downloadExcel_Export_Per_Student_Attendance_Pdf",
                fileName,
                base64,
                student.StudentFirstName,
                student.StudentLastName
            );

            Notify.ShowNotification("Report generated.", "", NotificationSeverity.Success);
        }
        catch (Exception ex)
        {
            Notify.ShowNotification($"Error: {ex.Message}", "", NotificationSeverity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}
