@page "/schoolattendance"
@using CORE.MODEL
@using CORE.SERVICE
@inject AuthService authService
@inject IJSRuntime JSRuntime

<RadzenFieldset>
    <ChildContent>
        <RadzenLabel Text="Select Class" />
        <RadzenDropDown Data="@classData" TextProperty="ClassID" ValueProperty="ClassID" @bind-Value="selectedClass" />
        <RadzenButton Text="Take Attendance" Click="@TakeAttendance" />
    </ChildContent>
</RadzenFieldset>

@if (students != null && students.Any())
{
    <RadzenCard>
        <h3>Students Attendance</h3>
        <RadzenGrid Data="@students" TItem="Student">
            <Columns>
                <RadzenGridColumn TItem="Student" Property="StudentFirstName" Title="First Name" />
                <RadzenGridColumn TItem="Student" Property="StudentLastName" Title="Last Name" />
                <RadzenGridColumn TItem="Student" Property="ClassID" Title="Class ID" />
                <RadzenGridColumn TItem="Student" Property="EnableSwitch" Title="Attendance" Width="150px">
                    <Template Context="student">
                        <RadzenSwitch @bind-Value="student.EnableSwitch" />
                    </Template>
                </RadzenGridColumn>
            </Columns>
        </RadzenGrid>

        <RadzenButton Text="Confirm Attendance" Click="@ConfirmAttendance" />

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="@messageClass">
                @message
            </div>
        }
    </RadzenCard>
}

@code {
    List<Class> classData;
    string selectedClass;
    List<Student> students;
    string message = "";
    string messageClass = "";
    private int userId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            var user = await authService.GetUserByUsernameAsync(username);
            if (user != null)
            {
                userId = user.UserID;
            }

            classData = await authService.GetAllClassAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
    }

    private async Task TakeAttendance()
    {
        try
        {
            students = await authService.GetStudentsByClassAsync(selectedClass);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred while taking attendance: {ex.Message}");
        }
    }


    private async Task ConfirmAttendance()
    {
        try
        {
            await authService.SaveAttendanceAsync(students, selectedClass, userId);

            message = "Attendance successfully confirmed!";
            messageClass = "success-message";
        }
        catch (Exception ex)
        {
            message = $"An error occurred while confirming attendance: {ex.Message}";
            messageClass = "error-message";
        }
    }
}
