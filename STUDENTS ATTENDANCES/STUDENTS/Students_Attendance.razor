@page "/schoolattendance"
@using CORE.MODEL
@using CORE.MODEL.Term
@using CORE.Pages.LOADING_COMPONENT
@using CORE.SERVICE
@using CORE.Tool_Components.STUDENT_ATTENDANCE
@inject AuthService authService
@inject IJSRuntime JSRuntime
@inherits Students_AttendanceCodeBehind

<style>
    .right-align {
        margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
        height: 60px; /* Adjust the height to your preference */
        padding: 5px 15px; /* Reduce padding */
    }

        /* Additional styling if needed */
        .compact-header .rz-header-title {
            font-size: 18px; /* Make the title smaller */
        }
    /* PRINT STUDENT REPOR */
    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .right-align {
        margin-left: auto;
    }
    /* Adjust the header height */
    .compact-header {
        height: 60px; /* Adjust the height to your preference */
        padding: 5px 15px; /* Reduce padding */
    }

        /* Additional styling if needed */
        .compact-header .rz-header-title {
            font-size: 18px; /* Make the title smaller */
        }

    .custom-background {
        background-color: green !important;
    }
</style>
<LoadingSpinner Visible="isLoading" />

@if (!isLoading)
{
<RadzenFieldset>
    <ChildContent>
        <RadzenLabel Text="Select Class" />
        <RadzenDropDown Data="@classData" TextProperty="ClassID" ValueProperty="ClassID" @bind-Value="selectedClass" />
        <RadzenButton Text="Take Attendance" Click="@TakeAttendance" />
            <RadzenLabel Text="Select Term" Style="margin-left:20px" />
            <RadzenDropDown Data="@terms" TextProperty="Term" ValueProperty="TermID" @bind-Value="selectedTermId" Style="width:200px" />

            <RadzenLabel Text="Select Date" Style="margin-left:20px" />
            <RadzenDatePicker @bind-Value="selectedDate" Name="dates" Style="width:200px" />

            <RadzenHeader title="EXPORT ATTENDANCE" class="header-container compact-header">
        <RadzenFieldset Text="EXPORT ATTENDANCE" class="right-align" Icon="print">
                    <StudentsAttendanceToolComponent OnOpenClassAttendanceExportDialog="OpenClassAttendanceExportDialog" OnOpenPerStudentExportDialog="OpenPerStudentExportDialog" />
        </RadzenFieldset>
        </RadzenHeader>
    </ChildContent>
</RadzenFieldset>

@if (students != null && students.Any())
{
    <RadzenCard>
        <h3>Students Attendance</h3>
        <RadzenGrid Data="@students" TItem="Student">
            <Columns>
                <RadzenGridColumn TItem="Student" Property="StudentFirstName" Title="First Name" />
                <RadzenGridColumn TItem="Student" Property="StudentLastName" Title="Last Name" />
                <RadzenGridColumn TItem="Student" Property="ClassID" Title="Class ID" />
                <RadzenGridColumn TItem="Student" Property="EnableSwitch" Title="Attendance" Width="150px">
                    <Template Context="student">
                        <RadzenSwitch @bind-Value="student.EnableSwitch" />
                    </Template>
                </RadzenGridColumn>
            </Columns>
        </RadzenGrid>

        <RadzenButton Text="Confirm Attendance" Click="@ConfirmAttendance" />

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="@messageClass">
                @message
            </div>
        }
    </RadzenCard>
}
}

@code {
    List<Class> classData;
    string selectedClass;
    List<Student> students;
    string message = "";
    string messageClass = "";
    private int userId;
    private bool isLoading = false;
    List<SchoolTerm> terms;
    int selectedTermId;

    DateTime selectedDate = DateTime.Today;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var username = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "userName");
            var user = await authService.GetUserByUsernameAsync(username);
            if (user != null)
            {
                userId = user.UserID;
            }

            classData = await authService.GetAllClassAsync();
            terms = (await authService.GetAllTermsAsync()).ToList();
            if (terms.Any()) selectedTermId = terms.First().TermID;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task TakeAttendance()
    {
        try
        {
            isLoading = true;
            students = await authService.GetStudentsByClassAsync(selectedClass);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"An error occurred while taking attendance: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task ConfirmAttendance()
    {
        try
        {
            isLoading = true;
            await authService.SaveAttendanceAsync(students, selectedClass, userId, selectedTermId,selectedDate);

            message = "Attendance successfully confirmed!";
            messageClass = "success-message";
        }
        catch (Exception ex)
        {
            message = $"An error occurred while confirming attendance: {ex.Message}";
            messageClass = "error-message";
        }
        finally
        {
            isLoading = false;
        }
    }

    async void OpenPerStudentExportDialog() => await OpenAttendancePerStudentDialog();
    async void OpenClassAttendanceExportDialog() => await OpenAttendanceByClassDialog();    
}
